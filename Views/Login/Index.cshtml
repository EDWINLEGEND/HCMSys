@model HCMSys.Models.User

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>HCMSys | Log in</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    <!-- SB Admin 2 Fonts & Icons -->
    <link href="~/dist/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- SB Admin 2 Core CSS -->
    <link href="~/dist/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        /* =============================================
           SB ADMIN 2 — MATCHING LOGIN PAGE STYLES
           ============================================= */

/*         html, body {
            height: 100%;
            font-family: 'Nunito', sans-serif;
        } */
        :root {
            --blue-light:  #dce8fb;
            --blue-mid:    #a8c8f8;
            --blue-accent: #4e73df;
            --white:       #ffffff;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Nunito', sans-serif;
        }

  /* ── Light Blue + White diagonal gradient background ── */
        body {
            background: linear-gradient(
                135deg,
                var(--white)       0%,
                var(--blue-light) 35%,
                var(--blue-mid)   70%,
                #b8d4fa           100%
            );
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* Subtle floating circle decorations */
        body::before,
        body::after {
            content: "";
            position: fixed;
            border-radius: 50%;
            z-index: 0;
            opacity: 0.18;
        }
        body::before {
            width: 480px;
            height: 480px;
            background: var(--blue-accent);
            top: -120px;
            left: -120px;
        }
        body::after {
            width: 360px;
            height: 360px;
            background: var(--blue-accent);
            bottom: -80px;
            right: -80px;
        }

        /* ── Card ── */
        .login-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 8px 40px rgba(78, 115, 223, 0.18),
                        0 2px 10px rgba(0,0,0,0.06);
            background: var(--white);
            position: relative;
            z-index: 1;
        }

        /* ── Card header stripe ── */
        .login-card-header {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border-radius: 1rem 1rem 0 0;
            padding: 1.6rem 2rem 1.4rem;
            text-align: center;
        }
        .login-card-header h4 {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.35rem;
            margin: 0;
            letter-spacing: 0.04em;
        }
        .login-card-header p {
            color: rgba(255,255,255,0.80);
            font-size: 0.82rem;
            margin: 0.3rem 0 0;
        }

        /* ── Form body ── */
        .login-card-body {
            padding: 2rem 2.2rem 1.8rem;
        }



/*         /* Card */
        .login-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.35) !important;
            overflow: hidden;
            position: relative;
            z-index: 1;
        }
 */
        /* Logo / Brand area at top of card */
        .login-brand {
            background: linear-gradient(135deg, #4e73df, #224abe);
            padding: 2rem 2rem 1.5rem;
            text-align: center;
        }
        .login-brand img {
            max-height: 70px;
            object-fit: contain;
        }
        .login-brand h4 {
            color: #fff;
            font-weight: 800;
            font-size: 1rem;
            margin: .75rem 0 0;
            letter-spacing: .05em;
            text-transform: uppercase;
            opacity: .9;
        }

        /* Card body */
        .login-card .card-body {
            padding: 2rem 2.5rem 2rem;
            background: #fff;
        }

        /* Section heading */
        .login-heading {
            font-size: .8rem;
            font-weight: 800;
            color: #4e73df;
            text-transform: uppercase;
            letter-spacing: .1em;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        /* Form controls — SB Admin 2 rounded style */
        .form-control-user {
            font-size: .85rem;
            border-radius: 10rem;
            padding: .75rem 1.25rem;
            border: 1px solid #d1d3e2;
            color: #6e707e;
        }
        .form-control-user:focus {
            border-color: #bac8ff;
            box-shadow: 0 0 0 .2rem rgba(78, 115, 223, .25);
            outline: none;
        }

        /* Input icons wrapper */
        .input-icon-group {
            position: relative;
        }
        .input-icon-group .input-icon {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            color: #b7b9cc;
            font-size: .8rem;
            pointer-events: none;
        }
        .input-icon-group .form-control-user {
            padding-left: 2.5rem;
        }

        /* Login button */
        .btn-login {
            background: linear-gradient(135deg, #4e73df, #224abe);
            border: none;
            border-radius: 10rem;
            color: #fff;
            font-size: .85rem;
            font-weight: 700;
            padding: .75rem 1rem;
            width: 100%;
            letter-spacing: .05em;
            text-transform: uppercase;
            transition: all .2s ease;
            box-shadow: 0 4px 15px rgba(78, 115, 223, .4);
        }
        .btn-login:hover {
            background: linear-gradient(135deg, #2e59d9, #1a3a8a);
            box-shadow: 0 6px 20px rgba(78, 115, 223, .55);
            transform: translateY(-1px);
        }
        .btn-login:active {
            transform: translateY(0);
        }

        /* Divider */
        .login-divider {
            display: flex;
            align-items: center;
            margin: 1.25rem 0;
            color: #b7b9cc;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .login-divider::before,
        .login-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e3e6f0;
        }
        .login-divider::before { margin-right: .75rem; }
        .login-divider::after  { margin-left:  .75rem; }

        /* Forgot password link */
        .forgot-link {
            color: #4e73df;
            font-size: .8rem;
            font-weight: 600;
            text-decoration: none;
            display: block;
            text-align: center;
        }
        .forgot-link:hover {
            color: #224abe;
            text-decoration: underline;
        }

        /* Footer text */
        .login-footer {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
            font-size: .72rem;
            margin-top: 1.5rem;
        }
        .login-footer a {
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
        }
        .login-footer a:hover {
            color: #fff;
            text-decoration: underline;
        }

        /* Error message box */
        .alert-login {
            border-radius: .5rem;
            font-size: .78rem;
            font-weight: 600;
            padding: .6rem 1rem;
            margin-bottom: 1rem;
        }

        /* Responsive */
        media (max-width: 576px) {
            .login-card .card-body {
                padding: 1.5rem 1.25rem;
            }
        },
       .login-card-header {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border-radius: 1rem 1rem 0 0;
            padding: 1.6rem 2rem 1.4rem;
            text-align: center;
        }
        .login-card-header h4 {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.35rem;
            margin: 0;
            letter-spacing: 0.04em;
        }
        .login-card-header p {
            color: rgba(255,255,255,0.80);
            font-size: 0.82rem;
            margin: 0.3rem 0 0;
        }

    </style>
</head>

<body>
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-xl-4 col-lg-5 col-md-6 col-sm-8 col-11">

                @using (Html.BeginForm("Login", "Login", FormMethod.Post))
                {
                    <!-- Login Card -->
                    <div class="card login-card">

                        <!-- Brand Header -->
                       <div class="login-card-header">
                            <h4>HCMSys</h4>
                            <p>Human Capital Management System</p>
                        </div>


                        <!-- Card Body -->
                        <div class="card-body">

                            <p class="login-heading">Welcome Back</p>

                            <!-- Validation Summary (SB Admin 2 style) -->
                            @if (ViewBag.ErrorMessage != null)
                            {
                                <div class="alert alert-danger alert-login" role="alert">
                                    <i class="fas fa-exclamation-circle mr-1"></i>
                                    @ViewBag.ErrorMessage
                                </div>
                            }

                            <!-- Username -->
                            <div class="form-group">
                                <div class="input-icon-group">
                                    <span class="input-icon">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-user"
                                           name="sUsername"
                                           value="@Model?.sUsername"
                                           required
                                           autocomplete="username"
                                           placeholder="Enter Username..." />
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="form-group">
                                <div class="input-icon-group">
                                    <span class="input-icon">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    <input type="password"
                                           class="form-control form-control-user"
                                           name="sPassword"
                                           placeholder="Password"
                                           autocomplete="current-password"
                                           required />
                                </div>
                            </div>

                            <!-- Remember Me -->
                            <div class="form-group mb-3">
                                <div class="custom-control custom-checkbox small">
                                    <input type="checkbox"
                                           class="custom-control-input"
                                           id="customCheck"
                                           name="rememberMe" />
                                    <label class="custom-control-label" for="customCheck"
                                           style="font-size:.78rem; color:#858796; cursor:pointer;">
                                        Remember Me
                                    </label>
                                </div>
                            </div>

                            <!-- Login Button -->
                            <button type="submit" class="btn-login" id="btnSignIn">
                                <i class="fas fa-sign-in-alt mr-2"></i> Sign In
                            </button>

                            <!-- Divider -->
                            <div class="login-divider">or</div>

                            <!-- Forgot Password -->
                            <a class="forgot-link" href="forgot-password.html">
                                <i class="fas fa-key mr-1" style="font-size:.7rem;"></i>
                                Forgot your password?
                            </a>

                        </div>
                        <!-- /Card Body -->

                    </div>
                    <!-- /Login Card -->
                }

                <!-- Footer -->
                <div class="login-footer">
                    &copy; @DateTime.Now.Year HCMSys &mdash;
                    <a href="#">Privacy Policy</a>
                </div>

            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/dist/jquery/jquery.min.js"></script>
    <script src="~/dist/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/dist/js/sb-admin-2.min.js"></script>
</body>
</html>