<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .number-align {
        text-align: right;
    }
    input[type="text"], textarea, select { text-align: left; }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text" id="page-header-title">
                    <i class="fas fa-boxes fa-sm text-primary mr-2"></i> Asset Allocation
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("AssetAllocationIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm mr-2">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btn-save-allocation" onclick="saveAllocation()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="allocationForm" autocomplete="off">
        <input type="hidden" id="hdr-header-id" value="0" />

        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">General Information</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter comments or allocation remarks..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted" id="attachment-note">Upload handover sheet, photo, or invoice.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ASSET DETAILS CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom bg-info">Asset Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Asset Category <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-assetcategory" required>
                            <option value="">Select Category...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Asset Code <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-assetcode" required disabled>
                            <option value="">Select Asset Code...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Asset Name</label>
                        <input type="text" class="form-control" id="dtl-assetname" readonly placeholder="Auto-populated" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Tag Number</label>
                        <input type="text" class="form-control" id="dtl-assettag" readonly placeholder="Auto-populated" />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="dtl-remarks" placeholder="Optional item remarks (e.g. Serial, Condition)" />
                    </div>
                    
                    <input type="hidden" id="dtl-qty" value="1" />
                    
                    <div class="col-md-12 text-right mt-2">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add Asset to List
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- DETAILED ASSETS GRID -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary">Assets Detailed</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Asset Category</th>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Tag Number</th>
                            <th class="num-col" style="width:70px;">Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="7" class="text-center text-muted py-3">No assets added yet. Select Category & Code above and click "Add Asset to List".</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    var employeesData = [];
    var assetCategoryData = [];
    var assetCodeData = [];
    var stagedAssets = [];
    var allocatedAssetsMap = {}; // Maps assetCode or assetId -> { empName, docNo, headerId }
    var editHeaderId = 0;
    var isEditMode = false;

    $(document).ready(function() {
        var urlParams = new URLSearchParams(window.location.search);
        var paramId = urlParams.get('id') || '@ViewBag.EditId';
        editHeaderId = parseInt(paramId) || 0;
        isEditMode = editHeaderId > 0;

        if (isEditMode) {
            $('#page-header-title').html('<i class="fas fa-edit fa-sm text-primary mr-2"></i> Edit Asset Allocation <span class="badge badge-primary font-weight-bold ml-2">Edit Mode</span>');
            $('#btn-save-allocation').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Allocation');
            $('#hdr-header-id').val(editHeaderId);
        }

        initHeader();

        // Load Masters and existing allocations in parallel
        $.when(
            $.getJSON('/Master/GetApiEmployees'),
            $.getJSON('/Master/GetApiAssetCategories'),
            $.getJSON('/Master/GetApiAssets'),
            $.getJSON('/Master/GetApiAssetAllocations')
        ).done(function(empRes, catRes, codeRes, allocsRes) {
            var empArr = empRes[0] || empRes;
            employeesData = Array.isArray(empArr) ? (Array.isArray(empArr[0]) ? empArr[0] : empArr) : [];
            var catArr = catRes[0] || catRes;
            assetCategoryData = Array.isArray(catArr) ? (Array.isArray(catArr[0]) ? catArr[0] : catArr) : [];
            var codeArr = codeRes[0] || codeRes;
            assetCodeData = Array.isArray(codeArr) ? (Array.isArray(codeArr[0]) ? codeArr[0] : codeArr) : [];
            
            var allAllocs = allocsRes[0] || allocsRes;
            var allocsList = Array.isArray(allAllocs) ? allAllocs : (allAllocs && allAllocs.data ? allAllocs.data : []);
            
            buildAllocatedAssetsMap(allocsList);
            populateDropdowns();
            $('select.form-control').select2({ width: '100%' });

            if (isEditMode) {
                loadAllocationForEdit(editHeaderId, allocsList);
            }
        }).fail(function() {
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load asset allocation masters', 'error', 5000);
            }
        });

        $('#hdr-employee').change(onEmployeeChange);
        $('#dtl-assetcategory').change(onCategoryChange);
        $('#dtl-assetcode').change(onAssetCodeChange);

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });
    });

    // Rule: 1 Asset can only be allocated to one person at a time
    function buildAllocatedAssetsMap(allocations) {
        allocatedAssetsMap = {};
        if (!Array.isArray(allocations)) return;

        allocations.forEach(function(alloc) {
            var aHeaderId = alloc.iHeaderId || alloc.id || 0;
            // Exclude the current document being edited so its assets are allowed
            if (isEditMode && aHeaderId === editHeaderId) return;

            var empName = alloc.sEmployeeName || alloc.employeeName || 'Unknown Employee';
            var docNo = alloc.sDocNo || alloc.docNo || ('AST' + String(aHeaderId).padStart(6, '0'));
            var status = alloc.iStatus !== undefined ? alloc.iStatus : 1;

            if (status === 1 || alloc.status === 'Allocated') {
                var assetList = alloc.assets || alloc.Assets || [];
                assetList.forEach(function(ast) {
                    var astCode = ast.sAssetCode || ast.assetCode;
                    var astId = ast.iAssetId || ast.assetId;
                    var info = { empName: empName, docNo: docNo, headerId: aHeaderId };
                    if (astCode) allocatedAssetsMap[astCode.toUpperCase()] = info;
                    if (astId) allocatedAssetsMap[astId] = info;
                });
            }
        });
    }

    function initHeader() {
        if (isEditMode) return;

        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var dd = String(d.getDate()).padStart(2, '0');
        var yyyy = d.getFullYear();
        
        $('#hdr-date').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-postdate').val(dd + '-' + mmm + '-' + yyyy);

        $.getJSON('/Master/GetApiAssetAllocations').done(function(allocs) {
            var rawList = Array.isArray(allocs) ? allocs : (allocs && allocs.data ? allocs.data : []);
            var maxNum = 0;
            rawList.forEach(function(item) {
                var dNo = item.sDocNo || item.docNo || '';
                var match = dNo.match(/\d+/);
                if (match) {
                    var n = parseInt(match[0], 10);
                    if (!isNaN(n) && n > maxNum) maxNum = n;
                }
            });
            var nextNum = Math.max(maxNum, rawList.length) + 1;
            $('#hdr-docno').val('AST' + String(nextNum).padStart(6, '0'));
        }).fail(function() {
            $('#hdr-docno').val('AST000001');
        });
    }

    function loadAllocationForEdit(headerId, cachedList) {
        function applyAllocationData(alloc) {
            if (!alloc) return;

            $('#hdr-docno').val(alloc.sDocNo || alloc.docNo || '');
            if (alloc.dDocDate) $('#hdr-date').val(window.formatDateDisplay(alloc.dDocDate));
            if (alloc.dPostDate) $('#hdr-postdate').val(window.formatDateDisplay(alloc.dPostDate));
            if (alloc.sComments) $('#hdr-comments').val(alloc.sComments);

            var empId = alloc.iEmpId || alloc.empId || '';
            if (empId) {
                $('#hdr-employee').val(empId).trigger('change');
            } else if (alloc.sEmployeeName) {
                var matched = employeesData.find(e => (e.sName || e.name) === alloc.sEmployeeName);
                if (matched) $('#hdr-employee').val(matched.iMasterId || matched.id).trigger('change');
            }

            var fileObj = alloc.assetFile || alloc.Attachment || alloc.attachment;
            if (fileObj && fileObj.sAttachmentFilePath) {
                $('#attachment-note').html(`Current Attachment: <a href="javascript:void(0)" class="text-primary font-weight-bold" onclick="window.openDocPreview('${fileObj.sAttachmentFileName || 'Attachment'}', '${fileObj.sAttachmentFilePath}')"><i class="fas fa-paperclip mr-1"></i>${fileObj.sAttachmentFileName || 'View Attached File'}</a> (Upload new file to replace)`);
            }

            var assetList = alloc.assets || alloc.Assets || [];
            stagedAssets = [];

            assetList.forEach(function(ast) {
                var masterAst = assetCodeData.find(a => (a.sCode || a.code) === (ast.sAssetCode || ast.assetCode) || (a.iMasterId || a.id) === (ast.iAssetId || ast.assetId)) || {};
                var astCode = ast.sAssetCode || ast.assetCode || masterAst.sCode || masterAst.code || '';
                var astName = ast.sAssetName || ast.assetName || masterAst.sName || masterAst.name || '';
                var catCode = ast.sCategoryCode || ast.categoryCode || masterAst.sCategoryCode || masterAst.categoryCode || '';
                var catName = ast.sCategoryName || ast.categoryName || masterAst.sCategoryName || masterAst.categoryName || '';
                var tagNum = ast.sTagNumber || ast.tagNumber || masterAst.sTagNumber || masterAst.tagNumber || 'N/A';
                var qty = ast.fQuantity || ast.qty || 1;
                var remarks = ast.sRemarks || ast.remarks || '';
                var assetId = ast.iAssetId || ast.assetId || masterAst.iMasterId || masterAst.id || 1;

                stagedAssets.push({
                    stagedId: 'id_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1000),
                    assetId: assetId,
                    categoryCode: catCode,
                    categoryName: catName,
                    assetCode: astCode,
                    assetName: astName,
                    tagNumber: tagNum,
                    qty: qty,
                    remarks: remarks
                });
            });

            renderGrid();
        }

        $.getJSON('/Master/GetApiAssetAllocationById?id=' + headerId).done(function(res) {
            var alloc = (res && res.data) ? res.data : res;
            applyAllocationData(alloc);
        }).fail(function() {
            var match = cachedList.find(a => (a.iHeaderId || a.id) == headerId || (a.sDocNo || a.docNo) == headerId);
            if (match) applyAllocationData(match);
        });
    }

    function populateDropdowns() {
        var empSelect = $('#hdr-employee');
        empSelect.empty().append('<option value="">Select Employee...</option>');
        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.iMasterId || emp.id || '';
                var empCode = emp.sCode || emp.code || '';
                var empName = emp.sName || emp.name || '';
                empSelect.append(`<option value="${empId}" data-code="${empCode}" data-name="${empName}">${empCode} - ${empName}</option>`);
            });
        }

        var catSelect = $('#dtl-assetcategory');
        catSelect.empty().append('<option value="">Select Category...</option>');
        if (Array.isArray(assetCategoryData)) {
            assetCategoryData.forEach(function(cat) {
                var catId = cat.iMasterId || cat.id || '';
                var catCode = cat.sCode || cat.code || '';
                var catName = cat.sName || cat.name || '';
                catSelect.append(`<option value="${catCode}" data-cat-id="${catId}" data-cat-name="${catName}">${catCode} - ${catName}</option>`);
            });
        }
    }

    function onEmployeeChange() {
        var empVal = $(this).val();
        if (!empVal) {
            $('#hdr-designation, #hdr-department, #hdr-manager').val('');
            return;
        }

        var emp = employeesData.find(e => e.id == empVal || e.iMasterId == empVal || e.code == empVal || e.sCode == empVal);
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '');
            var mgrName = emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || emp.reportingManagerName || emp.sReportingManager || '';
            $('#hdr-manager').val(mgrName);
        }
    }
    
    function onCategoryChange() {
        var catCode = $(this).val();
        var catOption = $(this).find('option:selected');
        var catId = catOption.data('cat-id');
        var catName = catOption.data('cat-name');
        
        var codeSelect = $('#dtl-assetcode');
        codeSelect.empty().append('<option value="">Select Asset Code...</option>');
        
        $('#dtl-assetname').val('');
        $('#dtl-assettag').val('');
        
        if (!catCode) {
            codeSelect.prop('disabled', true).trigger('change');
            return;
        }

        var filteredCodes = assetCodeData.filter(function(c) {
            var cCatCode = c.sCategoryCode || c.categoryCode;
            var cCatId = c.iCategoryId || c.categoryId;
            var cCatName = c.sCategoryName || c.categoryName;
            
            return (cCatCode && cCatCode.toLowerCase() === catCode.toLowerCase()) ||
                   (catId && cCatId && String(cCatId) === String(catId)) ||
                   (catName && cCatName && cCatName.toLowerCase() === catName.toLowerCase());
        });

        if (!filteredCodes || filteredCodes.length === 0) {
            filteredCodes = assetCodeData;
        }

        filteredCodes.forEach(function(codeItem) {
            var cId = codeItem.iMasterId || codeItem.id || 1;
            var cCode = codeItem.sCode || codeItem.code || '';
            var cName = codeItem.sName || codeItem.name || '';
            var cTag = codeItem.sTagNumber || codeItem.tagNumber || '';

            // Rule check: 1 asset can only be allocated to one person
            var allocatedInfo = allocatedAssetsMap[cCode.toUpperCase()] || allocatedAssetsMap[cId];
            if (allocatedInfo) {
                codeSelect.append(`<option value="${cCode}" disabled style="color:#aaa;">${cCode} - ${cName} (Already Allocated to ${allocatedInfo.empName})</option>`);
            } else {
                codeSelect.append(`<option value="${cCode}" data-asset-id="${cId}" data-asset-name="${cName}" data-asset-tag="${cTag}">${cCode} - ${cName}</option>`);
            }
        });
        
        codeSelect.prop('disabled', false).trigger('change');
    }
    
    function onAssetCodeChange() {
        var aCode = $(this).val();
        if (!aCode) {
            $('#dtl-assetname').val('');
            $('#dtl-assettag').val('');
            return;
        }
        var selectedOpt = $(this).find('option:selected');
        var assetName = selectedOpt.data('asset-name');
        var assetTag = selectedOpt.data('asset-tag');

        if (!assetName) {
            var asset = assetCodeData.find(c => (c.sCode || c.code) == aCode);
            if (asset) {
                assetName = asset.sName || asset.name || '';
                assetTag = asset.sTagNumber || asset.tagNumber || 'N/A';
            }
        }
        $('#dtl-assetname').val(assetName || '');
        $('#dtl-assettag').val(assetTag || 'N/A');
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            if (file.size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();
        
        if (stagedAssets.length === 0) {
            uTbody.append('<tr id="empty-row"><td colspan="7" class="text-center text-muted py-3">No assets added yet. Select Category & Code above and click "Add Asset to List".</td></tr>');
            return;
        }

        stagedAssets.forEach(function(item) {
            var tr = `<tr>
                <td class="action-btns" style="text-align:center;">
                    <a href="#" class="remove-item-btn" title="Delete" onclick="deleteStagedAsset('${item.stagedId}'); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </td>
                <td>${item.categoryName || '-'}</td>
                <td><strong>${item.assetCode || '-'}</strong></td>
                <td>${item.assetName || '-'}</td>
                <td><span class="badge badge-light border">${item.tagNumber || '-'}</span></td>
                <td class="num-col">${item.qty}</td>
                <td>${item.remarks || '-'}</td>
            </tr>`;
            uTbody.append(tr);
        });
    }

    function deleteStagedAsset(stagedId) {
        stagedAssets = stagedAssets.filter(function(item) { return item.stagedId !== stagedId; });
        renderGrid();
    }

    function addToGrid() {
        var categoryCode = $('#dtl-assetcategory').val();
        var assetCode = $('#dtl-assetcode').val();
        
        if(!categoryCode || !assetCode) {
            alertify.log('Please select Asset Category and Asset Code.', 'error', 5000);
            return;
        }

        // Rule Check 1: Already added to this allocation list
        var isAlreadyInGrid = stagedAssets.some(sa => (sa.assetCode || '').toUpperCase() === assetCode.toUpperCase());
        if (isAlreadyInGrid) {
            alertify.log('Asset ' + assetCode + ' is already added to this allocation list.', 'error', 5000);
            return;
        }

        var catOpt = $('#dtl-assetcategory option:selected');
        var categoryName = catOpt.data('cat-name') || catOpt.text().split(' - ')[1] || catOpt.text();
        
        var astOpt = $('#dtl-assetcode option:selected');
        var assetId = parseInt(astOpt.data('asset-id')) || 1;
        var assetName = $('#dtl-assetname').val() || astOpt.data('asset-name') || '';
        var tagNumber = $('#dtl-assettag').val() || astOpt.data('asset-tag') || 'N/A';
        var remarks = $('#dtl-remarks').val() || '';
        var qty = $('#dtl-qty').val() || 1;

        if (!assetId || assetId <= 0) {
            var match = assetCodeData.find(a => (a.sCode || a.code) == assetCode);
            if (match) assetId = match.iMasterId || match.id || 1;
        }

        // Rule Check 2: 1 asset can only be allocated to one person
        var allocatedInfo = allocatedAssetsMap[assetCode.toUpperCase()] || allocatedAssetsMap[assetId];
        if (allocatedInfo) {
            alertify.log('Asset ' + assetCode + ' is already allocated to ' + allocatedInfo.empName + ' (' + allocatedInfo.docNo + '). An asset can only be allocated to one person.', 'error', 6000);
            return;
        }

        var uniqueStagedId = 'id_' + new Date().getTime();

        var newItem = {
            stagedId: uniqueStagedId,
            assetId: assetId,
            categoryCode: categoryCode,
            categoryName: categoryName,
            assetCode: assetCode,
            assetName: assetName,
            tagNumber: tagNumber,
            qty: qty,
            remarks: remarks
        };

        stagedAssets.push(newItem);
        renderGrid();
        
        // Reset inputs
        $('#dtl-assetcategory').val('').trigger('change');
        $('#dtl-remarks').val('');
    }

    function saveAllocation() {
        if (stagedAssets.length === 0) {
            alertify.log('Please add at least one asset to the list.', 'error', 5000);
            return;
        }

        var empVal = $('#hdr-employee').val();
        if(!empVal) {
            alertify.log('Please select an Employee.', 'error', 5000);
            return;
        }

        var emp = employeesData.find(e => e.id == empVal || e.iMasterId == empVal || e.code == empVal || e.sCode == empVal);
        var empCode = emp ? (emp.sCode || emp.code || '') : '';
        var empName = emp ? (emp.sName || emp.name || '') : '';
        var empDeptName = emp ? (emp.sDepartmentName || emp.departmentName || $('#hdr-department').val() || '') : '';
        var empDesigName = emp ? (emp.sDesignationName || emp.designationName || $('#hdr-designation').val() || '') : '';
        var managerName = $('#hdr-manager').val();

        var docNo = $('#hdr-docno').val();
        var dateStr = $('#hdr-date').val();
        var postDateStr = $('#hdr-postdate').val() || dateStr;

        function parseToYMD(dStr) {
            if(!dStr) return new Date().toISOString().split('T')[0];
            var parts = dStr.split('-');
            if(parts.length === 3) {
                var months = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'};
                var m = months[parts[1]] || '01';
                var d = String(parts[0]).padStart(2, '0');
                var y = parts[2];
                return y + '-' + m + '-' + d;
            }
            return new Date().toISOString().split('T')[0];
        }

        var ymdDate = parseToYMD(dateStr);
        var ymdPostDate = parseToYMD(postDateStr);

        var assetsPayload = stagedAssets.map(function(sa) {
            return {
                iAssetId: sa.assetId,
                fQuantity: parseFloat(sa.qty) || 1,
                sRemarks: sa.remarks || "N/A"
            };
        });

        var formData = new FormData();
        formData.append('iHeaderId', isEditMode ? editHeaderId.toString() : '0');
        formData.append('sDocNo', docNo);
        formData.append('dDocDate', ymdDate);
        formData.append('dPostDate', ymdPostDate);
        formData.append('iEmpId', parseInt(empVal) || (emp ? (emp.iMasterId || emp.id) : 36));
        formData.append('iCompanyId', '1');
        formData.append('iPayYearId', '1');
        formData.append('sComments', $('#hdr-comments').val() || 'Asset allocation');
        formData.append('sEmployeeCode', empCode);
        formData.append('sEmployeeName', empName);
        formData.append('sDepartmentName', empDeptName);
        formData.append('sDesignationName', empDesigName);
        formData.append('sReportingToName', managerName);
        formData.append('Assets', JSON.stringify(assetsPayload));

        var fileInput = document.getElementById('hdr-attachment');
        if (fileInput && fileInput.files && fileInput.files[0]) {
            formData.append('Attachment', fileInput.files[0]);
        }

        $.ajax({
            url: '/Master/SaveApiAssetAllocation',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                var isSuccess = res && (res.success === true || res.statusCode === 200);
                if (isSuccess) {
                    var savedDoc = (res.data && typeof res.data === 'string') ? res.data : docNo;
                    var successMsg = isEditMode ? 'Asset Allocation (' + savedDoc + ') updated successfully!' : 'Asset Allocation saved successfully! (' + savedDoc + ')';
                    sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: successMsg, type: 'success' }));
                    var targetUrl = '@Url.Action("AssetAllocationIndex", "Master")';
                    if (typeof loadPageContent === 'function') {
                        loadPageContent(targetUrl, true);
                    } else {
                        window.location.href = targetUrl;
                    }
                } else {
                    var errMsg = (res && res.message) ? res.message : 'Error saving Asset Allocation';
                    alertify.log(errMsg, 'error', 6000);
                }
            },
            error: function(xhr, status, err) {
                alertify.log('Failed to save Asset Allocation: ' + (xhr.responseText || err || 'Server error'), 'error', 5000);
            }
        });
    }
</script>
