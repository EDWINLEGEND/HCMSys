@{
    ViewData["Title"] = "Asset Allocation List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .action-btns .fa-paperclip { color: #1cc88a; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }

    .asset-badge {
        display: inline-block;
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.76rem;
        font-weight: 600;
        margin: 2px 3px 2px 0;
        white-space: nowrap;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-boxes fa-sm"></i>
                    Asset Allocation List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("AssetAllocation", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Allocations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-allocs">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-invoice fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Assets Allocated</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-assets">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Allocations
            </h6>
            <button class="btn btn-sm btn-outline-primary shadow-sm" onclick="loadGridData()">
                <i class="fas fa-sync-alt mr-1"></i> Refresh
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:85px; text-align:center;">Action</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Employee Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Allocated Assets</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Edit Asset Allocation</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-header-id" />
                <div class="row">
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Doc No</label>
                        <input type="text" class="form-control" id="edit-docno" readonly />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Date</label>
                        <input type="text" class="form-control" id="edit-date" placeholder="e.g. 18-Jul-2026" />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Employee Name</label>
                        <input type="text" class="form-control" id="edit-employee" />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Department</label>
                        <input type="text" class="form-control" id="edit-department" />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Designation</label>
                        <input type="text" class="form-control" id="edit-designation" />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label class="form-label font-weight-bold text-gray-700">Status</label>
                        <select class="form-control" id="edit-status">
                            <option value="Allocated">Allocated</option>
                            <option value="Active">Active</option>
                            <option value="De-Allocated">De-Allocated</option>
                        </select>
                    </div>
                    <div class="col-12 form-group mb-3">
                        <label class="form-label font-weight-bold text-gray-700">Remarks / Comments</label>
                        <input type="text" class="form-control" id="edit-remarks" />
                    </div>
                </div>

                <h6 class="font-weight-bold text-gray-800 mb-2 border-bottom pb-1"><i class="fas fa-boxes mr-1"></i> Allocated Asset Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0" id="edit-assets-table">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Asset Code</th>
                                <th>Asset Name</th>
                                <th>Tag Number</th>
                                <th class="text-right">Qty</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="save-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var table = null;
    var currentParentAllocations = [];
    var masterAssetsMap = {};

    $(document).ready(function () {
        table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search allocations...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No allocations found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        loadGridData();

        // Edit Button Click Handler
        $('#data-grid tbody').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var docNo = String($(this).data('docno'));
            var headerId = $(this).data('headerid');
            
            var item = currentParentAllocations.find(i => (i.sDocNo || i.docNo) === docNo || (headerId && (i.iHeaderId || i.id) == headerId));

            if (item) {
                $('#edit-header-id').val(item.iHeaderId || item.id || 0);
                $('#edit-docno').val(item.sDocNo || item.docNo || docNo);
                $('#edit-date').val(item.displayDate || window.formatDateDisplay(item.dDocDate || item.date));
                $('#edit-employee').val(item.sEmployeeName || item.employeeName || '');
                $('#edit-department').val(item.sDepartmentName || item.departmentName || '');
                $('#edit-designation').val(item.sDesignationName || item.designationName || '');
                $('#edit-remarks').val(item.sComments || item.comments || item.remarks || '');
                $('#edit-status').val(item.iStatus === 1 ? 'Allocated' : (item.status || 'Active'));

                var assetList = item.assets || item.Assets || [];
                var tbody = $('#edit-assets-table tbody');
                tbody.empty();

                if (assetList.length === 0) {
                    tbody.append('<tr><td colspan="7" class="text-center text-muted py-2">No asset items</td></tr>');
                } else {
                    assetList.forEach(function(ast, idx) {
                        var masterAst = masterAssetsMap[ast.sAssetCode] || masterAssetsMap[ast.assetCode] || masterAssetsMap[ast.iAssetId] || {};
                        var catName = ast.sCategoryName || ast.categoryName || masterAst.sCategoryName || masterAst.categoryName || '-';
                        var aCode = ast.sAssetCode || ast.assetCode || masterAst.sCode || masterAst.code || '-';
                        var aName = ast.sAssetName || ast.assetName || masterAst.sName || masterAst.name || '-';
                        var aTag = ast.sTagNumber || ast.tagNumber || masterAst.sTagNumber || masterAst.tagNumber || '-';
                        var aQty = ast.fQuantity || ast.qty || 1;
                        var aRem = ast.sRemarks || ast.remarks || '-';

                        tbody.append(`
                            <tr>
                                <td>${idx + 1}</td>
                                <td>${catName}</td>
                                <td><strong>${aCode}</strong></td>
                                <td>${aName}</td>
                                <td><span class="badge badge-light border">${aTag}</span></td>
                                <td class="text-right font-weight-bold">${aQty}</td>
                                <td>${aRem}</td>
                            </tr>
                        `);
                    });
                }

                $('#edit-modal').modal('show');
            }
        });

        // Save Edit Changes Handler
        $('#save-edit-btn').click(function() {
            var docNo = $('#edit-docno').val();
            var headerId = $('#edit-header-id').val();
            var match = currentParentAllocations.find(i => (i.sDocNo || i.docNo) === docNo || (headerId && (i.iHeaderId || i.id) == headerId));
            
            if (match) {
                match.displayDate = $('#edit-date').val();
                match.dDocDate = $('#edit-date').val();
                match.sEmployeeName = $('#edit-employee').val();
                match.sDepartmentName = $('#edit-department').val();
                match.sDesignationName = $('#edit-designation').val();
                match.sComments = $('#edit-remarks').val();
                match.status = $('#edit-status').val();

                renderParentRows(currentParentAllocations);
            }
            $('#edit-modal').modal('hide');
            alertify.log('Asset Allocation updated successfully.', 'success', 5000);
        });

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = String($(this).data('docno'));
            var headerId = $(this).data('headerid');
            
            alertify.confirm('Are you sure you want to delete allocation ' + docNo + '?', function (confirmed) {
                if (confirmed) {
                    currentParentAllocations = currentParentAllocations.filter(function(i) {
                        var iDoc = i.sDocNo || i.docNo;
                        var iId = i.iHeaderId || i.id;
                        return !(iDoc === docNo || (headerId && iId == headerId));
                    });

                    var deletedList = JSON.parse(sessionStorage.getItem('deletedAssetAllocations') || '[]');
                    if (!deletedList.includes(docNo)) {
                        deletedList.push(docNo);
                        sessionStorage.setItem('deletedAssetAllocations', JSON.stringify(deletedList));
                    }

                    renderParentRows(currentParentAllocations);
                    alertify.log('Record deleted successfully.', 'success', 2500);
                }
            });
        });
    });

    function renderParentRows(allocations) {
        table.clear();
        $('#stat-total-allocs').text(allocations.length);

        var totalAssetsCount = 0;

        allocations.forEach(function(item) {
            var docNo = item.sDocNo || item.docNo || ('AST' + String(item.iHeaderId || item.id || 1).padStart(6, '0'));
            var formattedDate = item.displayDate || (item.dDocDate ? window.formatDateDisplay(item.dDocDate) : (item.date ? window.formatDateDisplay(item.date) : '-'));
            var empName = item.sEmployeeName || item.employeeName || '-';
            var empCode = item.sEmployeeCode || item.employeeCode || '';
            var empDisplay = empCode ? `<strong>${empName}</strong> <br><small class="text-muted">${empCode}</small>` : `<strong>${empName}</strong>`;
            var deptName = item.sDepartmentName || item.departmentName || '-';
            var desigName = item.sDesignationName || item.designationName || '-';
            var comments = item.sComments || item.comments || item.remarks || '-';
            var status = item.status || (item.iStatus === 1 ? 'Allocated' : 'Active');

            var fileObj = item.assetFile || item.Attachment || item.attachment;
            var attachUrl = fileObj ? (fileObj.sAttachmentFilePath || fileObj.attachmentFilePath || '') : '';
            var attachName = fileObj ? (fileObj.sAttachmentFileName || fileObj.attachmentFileName || 'Attachment') : '';

            var assetList = (item.assets && item.assets.length > 0) ? item.assets :
                            ((item.Assets && item.Assets.length > 0) ? item.Assets : []);

            totalAssetsCount += assetList.length;

            var assetsBadgesHtml = '';
            if (assetList.length === 0) {
                assetsBadgesHtml = '<span class="text-muted">-</span>';
            } else {
                assetsBadgesHtml = assetList.map(function(ast) {
                    var masterAst = masterAssetsMap[ast.sAssetCode] || masterAssetsMap[ast.assetCode] || masterAssetsMap[ast.iAssetId] || {};
                    var aCode = ast.sAssetCode || ast.assetCode || masterAst.sCode || masterAst.code || '';
                    var aName = ast.sAssetName || ast.assetName || masterAst.sName || masterAst.name || '';
                    var label = aCode ? (aName ? `${aCode} - ${aName}` : aCode) : (aName || 'Asset');
                    return `<span class="asset-badge" title="${label}">${label}</span>`;
                }).join('');
            }

            var attachBtn = '';
            if (attachUrl) {
                attachBtn = `<a href="javascript:void(0)" onclick="window.openDocPreview('${attachName}', '${attachUrl}')" title="View Attachment (${attachName})"><i class="fas fa-paperclip fa-sm fa-fw"></i></a>`;
            }

            var actionHtml = `
                <div class="action-btns" style="text-align:center;">
                    ${attachBtn}
                    <a href="#" class="edit-item-btn" data-docno="${docNo}" data-headerid="${item.iHeaderId || item.id || 0}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                    <a href="#" class="remove-item-btn" data-docno="${docNo}" data-headerid="${item.iHeaderId || item.id || 0}" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </div>
            `;

            table.row.add([
                actionHtml,
                '<strong>' + docNo + '</strong>',
                formattedDate,
                empDisplay,
                deptName,
                desigName,
                assetsBadgesHtml,
                comments,
                '<span class="badge badge-success">' + status + '</span>'
            ]);
        });

        $('#stat-total-assets').text(totalAssetsCount);
        table.draw(false);
    }

    function loadGridData() {
        table.clear().draw();
        var deletedList = JSON.parse(sessionStorage.getItem('deletedAssetAllocations') || '[]');

        // Fetch Asset Masters and Asset Allocations in parallel
        $.when(
            $.getJSON('/Master/GetApiAssets'),
            $.getJSON('/Master/GetApiAssetAllocations')
        ).done(function(assetsRes, allocsRes) {
            var assetsArr = assetsRes[0] || assetsRes;
            if (Array.isArray(assetsArr)) {
                masterAssetsMap = {};
                assetsArr.forEach(function(a) {
                    if (a.sCode || a.code) masterAssetsMap[a.sCode || a.code] = a;
                    if (a.iMasterId || a.id) masterAssetsMap[a.iMasterId || a.id] = a;
                });
            }

            var apiData = allocsRes[0] || allocsRes;
            var rawList = [];

            if (Array.isArray(apiData)) {
                rawList = apiData;
            } else if (apiData && Array.isArray(apiData.data)) {
                rawList = apiData.data;
            } else if (apiData && apiData.data && Array.isArray(apiData.data.allocations)) {
                rawList = apiData.data.allocations;
            }

            currentParentAllocations = rawList.filter(function(item) {
                var dNo = item.sDocNo || item.docNo || '';
                return !deletedList.includes(dNo);
            });

            renderParentRows(currentParentAllocations);
        }).fail(function() {
            renderParentRows([]);
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load asset allocations from API.', 'error', 5000);
            }
        });
    }
</script>
