@{
    ViewData["Title"] = "Asset Allocation List";
}

<!-- DataTables & Alertify CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .action-btns .fa-paperclip { color: #1cc88a; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }

    .asset-badge {
        display: inline-block;
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.76rem;
        font-weight: 600;
        margin: 2px 3px 2px 0;
        white-space: nowrap;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-boxes fa-sm"></i>
                    Asset Allocation List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("AssetAllocation", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Allocations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-allocs">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-invoice fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Assets Allocated</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-assets">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Allocations
            </h6>
            <button class="btn btn-sm btn-outline-primary shadow-sm" onclick="loadGridData()">
                <i class="fas fa-sync-alt mr-1"></i> Refresh
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:85px; text-align:center;">Action</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Employee Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Allocated Assets</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- DataTables & Alertify Scripts -->
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var table = null;
    var currentParentAllocations = [];
    var masterAssetsMap = {};

    function formatListDate(dVal) {
        if (!dVal) return '-';
        if (typeof window.formatDateDisplay === 'function') {
            return window.formatDateDisplay(dVal);
        }
        var str = String(dVal);
        if (str.includes('T')) str = str.split('T')[0];
        var parts = str.split('-');
        if (parts.length === 3 && parts[0].length === 4) {
            var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            var mIdx = parseInt(parts[1], 10) - 1;
            return (parts[2].padStart(2, '0')) + '-' + (months[mIdx] || parts[1]) + '-' + parts[0];
        }
        return str;
    }

    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#data-grid')) {
            $('#data-grid').DataTable().destroy();
        }

        table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search allocations...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No allocations found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        loadGridData();

        // Edit Button Click Handler -> Navigates to full form page for editing
        $('#data-grid tbody').off('click', '.edit-item-btn').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var headerId = $(this).data('headerid');
            var docNo = $(this).data('docno');
            var editUrl = '@Url.Action("AssetAllocation", "Master")' + '?id=' + (headerId || 0);

            if (typeof loadPageContent === 'function') {
                loadPageContent(editUrl, true);
            } else {
                window.location.href = editUrl;
            }
        });

        // Delete Handler
        $('#data-grid tbody').off('click', '.remove-item-btn').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = String($(this).data('docno'));
            var headerId = $(this).data('headerid');
            
            alertify.confirm('Are you sure you want to delete allocation ' + docNo + '?', function (confirmed) {
                if (confirmed) {
                    currentParentAllocations = currentParentAllocations.filter(function(i) {
                        var iDoc = i.sDocNo || i.docNo;
                        var iId = i.iHeaderId || i.id;
                        return !(iDoc === docNo || (headerId && iId == headerId));
                    });

                    renderParentRows(currentParentAllocations);
                    alertify.log('Record removed from view successfully.', 'success', 2500);
                }
            });
        });
    });

    function renderParentRows(allocations) {
        table.clear();
        $('#stat-total-allocs').text(allocations.length);

        var totalAssetsCount = 0;

        allocations.forEach(function(item) {
            var docNo = item.sDocNo || item.docNo || ('AST' + String(item.iHeaderId || item.id || 1).padStart(6, '0'));
            var headerId = item.iHeaderId || item.id || 0;
            var formattedDate = item.displayDate || formatListDate(item.dDocDate || item.date);
            var empName = item.sEmployeeName || item.employeeName || '-';
            var empCode = item.sEmployeeCode || item.employeeCode || '';
            var empDisplay = empCode ? `<strong>${empName}</strong> <br><small class="text-muted">${empCode}</small>` : `<strong>${empName}</strong>`;
            var deptName = item.sDepartmentName || item.departmentName || '-';
            var desigName = item.sDesignationName || item.designationName || '-';
            var comments = item.sComments || item.comments || item.remarks || '-';
            var status = item.status || (item.iStatus === 1 ? 'Allocated' : 'Active');

            var fileObj = item.assetFile || item.Attachment || item.attachment;
            var attachUrl = fileObj ? (fileObj.sAttachmentFilePath || fileObj.attachmentFilePath || '') : '';
            var attachName = fileObj ? (fileObj.sAttachmentFileName || fileObj.attachmentFileName || 'Attachment') : '';

            var assetList = (item.assets && item.assets.length > 0) ? item.assets :
                            ((item.Assets && item.Assets.length > 0) ? item.Assets : []);

            totalAssetsCount += assetList.length;

            var assetsBadgesHtml = '';
            if (assetList.length === 0) {
                assetsBadgesHtml = '<span class="text-muted">-</span>';
            } else {
                assetsBadgesHtml = assetList.map(function(ast) {
                    var masterAst = masterAssetsMap[ast.sAssetCode] || masterAssetsMap[ast.assetCode] || masterAssetsMap[ast.iAssetId] || {};
                    var aCode = ast.sAssetCode || ast.assetCode || masterAst.sCode || masterAst.code || '';
                    var aName = ast.sAssetName || ast.assetName || masterAst.sName || masterAst.name || '';
                    var label = aCode ? (aName ? `${aCode} - ${aName}` : aCode) : (aName || 'Asset');
                    return `<span class="asset-badge" title="${label}">${label}</span>`;
                }).join('');
            }

            var attachBtn = '';
            if (attachUrl) {
                attachBtn = `<a href="javascript:void(0)" onclick="window.openDocPreview('${attachName}', '${attachUrl}')" title="View Attachment (${attachName})"><i class="fas fa-paperclip fa-sm fa-fw"></i></a>`;
            }

            var editUrl = '@Url.Action("AssetAllocation", "Master")' + '?id=' + headerId;
            var actionHtml = `
                <div class="action-btns" style="text-align:center;">
                    ${attachBtn}
                    <a href="${editUrl}" class="edit-item-btn" data-docno="${docNo}" data-headerid="${headerId}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                    <a href="#" class="remove-item-btn" data-docno="${docNo}" data-headerid="${headerId}" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </div>
            `;

            table.row.add([
                actionHtml,
                '<strong>' + docNo + '</strong>',
                formattedDate,
                empDisplay,
                deptName,
                desigName,
                assetsBadgesHtml,
                comments,
                '<span class="badge badge-success">' + status + '</span>'
            ]);
        });

        $('#stat-total-assets').text(totalAssetsCount);
        table.draw(false);
    }

    function loadGridData() {
        table.clear().draw();

        $.when(
            $.getJSON('/Master/GetApiAssets'),
            $.getJSON('/Master/GetApiAssetAllocations')
        ).done(function(assetsRes, allocsRes) {
            var assetsArr = assetsRes[0] || assetsRes;
            if (Array.isArray(assetsArr)) {
                masterAssetsMap = {};
                assetsArr.forEach(function(a) {
                    if (a.sCode || a.code) masterAssetsMap[a.sCode || a.code] = a;
                    if (a.iMasterId || a.id) masterAssetsMap[a.iMasterId || a.id] = a;
                });
            }

            var apiData = allocsRes[0] || allocsRes;
            var rawList = [];

            if (Array.isArray(apiData)) {
                rawList = apiData;
            } else if (apiData && Array.isArray(apiData.data)) {
                rawList = apiData.data;
            } else if (apiData && apiData.data && Array.isArray(apiData.data.allocations)) {
                rawList = apiData.data.allocations;
            }

            currentParentAllocations = rawList;
            renderParentRows(currentParentAllocations);
        }).fail(function() {
            renderParentRows([]);
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load asset allocations from API.', 'error', 5000);
            }
        });
    }
</script>
