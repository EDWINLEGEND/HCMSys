@{
    ViewData["Title"] = "Asset Allocation List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-boxes fa-sm"></i>
                    Asset Allocation List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("AssetAllocation", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Allocations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Allocations
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:70px; text-align:center;">Action</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Employee Name</th>
                            <th>Category</th>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Edit Asset Allocation</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-idx" />
                <div class="form-group mb-2">
                    <label class="form-label">Doc No</label>
                    <input type="text" class="form-control" id="edit-docno" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Date</label>
                    <input type="text" class="form-control" id="edit-date" placeholder="e.g. 18-Jul-2026" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Employee Name</label>
                    <input type="text" class="form-control" id="edit-employee" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Category</label>
                    <input type="text" class="form-control" id="edit-category" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Asset Code</label>
                    <input type="text" class="form-control" id="edit-assetcode" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Asset Name</label>
                    <input type="text" class="form-control" id="edit-assetname" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" class="form-control" id="edit-remarks" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="edit-status">
                        <option value="Active">Active</option>
                        <option value="Allocated">Allocated</option>
                        <option value="De-Allocated">De-Allocated</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="save-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No allocations found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });
        var currentGridData = [];

        function renderRows(items) {
            currentGridData = items;
            table.clear();
            $('#stat-total').text(items.length);

            items.forEach(function(item) {
                var dNo = item.docNo || item.sDocNo || item.allocationNo || '-';
                var aCode = item.assetCode || item.sAssetCode || '-';
                var actionHtml = `
                    <div class="action-btns" style="text-align:center;">
                        <a href="#" class="edit-item-btn" data-docno="${dNo}" data-assetcode="${aCode}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                        <a href="#" class="remove-item-btn" data-docno="${dNo}" data-assetcode="${aCode}" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                    </div>
                `;

                table.row.add([
                    actionHtml,
                    dNo,
                    window.formatDateDisplay(item.date || item.dDocDate || item.allocDate),
                    item.employeeName || item.sEmployeeName || '-',
                    item.categoryName || item.sCategoryName || '-',
                    aCode,
                    item.assetName || item.sAssetName || '-',
                    item.remarks || item.sComments || item.allocRemarks || '-',
                    '<span class="badge badge-success">' + (item.status || 'Allocated') + '</span>'
                ]);
            });
            table.draw(false);
        }

        function loadGridData() {
            table.clear();
            var localSaved = JSON.parse(localStorage.getItem('savedAssetAllocations') || '[]');
            var deletedList = JSON.parse(localStorage.getItem('deletedAssetAllocations') || '[]');

            $.ajax({
                url: '/Master/GetApiAssetAllocations',
                type: 'GET',
                success: function(apiData) {
                    var combined = [];
                    var allocationsArray = [];

                    if (Array.isArray(apiData)) {
                        allocationsArray = apiData;
                    } else if (apiData && Array.isArray(apiData.data)) {
                        allocationsArray = apiData.data;
                    } else if (apiData && apiData.data && Array.isArray(apiData.data.allocations)) {
                        allocationsArray = apiData.data.allocations;
                    }

                    if (allocationsArray.length > 0) {
                        allocationsArray.forEach(function(item) {
                            var formattedDate = item.dDocDate ? window.formatDateDisplay(item.dDocDate) : (item.date ? window.formatDateDisplay(item.date) : '-');
                            var assetList = (item.assets && item.assets.length > 0) ? item.assets :
                                            ((item.Assets && item.Assets.length > 0) ? item.Assets :
                                            ((item.sAssetCode || item.assetCode) ? [item] : [item]));
                            var itemDocNo = item.sDocNo || item.docNo || ('AST' + String(item.iHeaderId || item.id || 1).padStart(6, '0'));

                            assetList.forEach(function(ast) {
                                var astCode = ast.sAssetCode || ast.assetCode || item.sAssetCode || item.assetCode || '';
                                var key1 = itemDocNo + '|' + astCode;
                                var key2 = itemDocNo + '|';
                                if (!deletedList.includes(key1) && !deletedList.includes(key2)) {
                                    combined.push({
                                        docNo: itemDocNo,
                                        date: formattedDate,
                                        employeeName: item.sEmployeeName || item.employeeName || '-',
                                        categoryName: ast.sCategoryName || ast.categoryName || item.sCategoryName || item.categoryName || '-',
                                        assetCode: astCode || '-',
                                        assetName: ast.sAssetName || ast.assetName || item.sAssetName || item.assetName || '-',
                                        remarks: item.sComments || ast.sRemarks || ast.remarks || item.remarks || '-',
                                        status: item.iStatus === 1 ? 'Allocated' : (item.status || 'Active'),
                                        iHeaderId: item.iHeaderId
                                    });
                                }
                            });
                        });
                    }

                    localSaved.forEach(function(ls) {
                        var lsDoc = ls.docNo || ls.sDocNo || '';
                        var lsCode = ls.assetCode || ls.sAssetCode || '';
                        var key1 = lsDoc + '|' + lsCode;
                        var key2 = lsDoc + '|';
                        if (!deletedList.includes(key1) && !deletedList.includes(key2)) {
                            if (!combined.some(c => c.docNo === lsDoc && (c.assetCode === lsCode || !lsCode))) {
                                combined.push(ls);
                            }
                        }
                    });

                    renderRows(combined);
                },
                error: function() {
                    var filteredLocal = localSaved.filter(function(ls) {
                        var lsDoc = ls.docNo || ls.sDocNo || '';
                        var lsCode = ls.assetCode || ls.sAssetCode || '';
                        return !deletedList.includes(lsDoc + '|' + lsCode) && !deletedList.includes(lsDoc + '|');
                    });
                    renderRows(filteredLocal);
                }
            });
        }

        loadGridData();

        // Edit Handler
        $('#data-grid tbody').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');
            var assetCode = $(this).data('assetcode');
            
            var item = currentGridData.find(i => (i.docNo || i.sDocNo || i.allocationNo) === docNo && (!assetCode || (i.assetCode || i.sAssetCode) === assetCode));

            if (item) {
                $('#edit-idx').val(docNo);
                $('#edit-docno').val(item.docNo || item.sDocNo || item.allocationNo || '');
                $('#edit-date').val(item.date || item.dDocDate || item.allocDate || '');
                $('#edit-employee').val(item.employeeName || item.sEmployeeName || '');
                $('#edit-category').val(item.categoryName || item.sCategoryName || '');
                $('#edit-assetcode').val(item.assetCode || item.sAssetCode || '');
                $('#edit-assetname').val(item.assetName || item.sAssetName || '');
                $('#edit-remarks').val(item.remarks || item.sComments || item.allocRemarks || '');
                $('#edit-status').val(item.status || 'Allocated');

                $('#edit-modal').modal('show');
            }
        });

        $('#save-edit-btn').click(function() {
            var targetDocNo = $('#edit-idx').val();
            var savedData = JSON.parse(localStorage.getItem('savedAssetAllocations') || '[]');
            var match = savedData.find(i => (i.docNo || i.sDocNo || i.allocationNo) === targetDocNo);
            
            if (match) {
                match.date = $('#edit-date').val();
                match.employeeName = $('#edit-employee').val();
                match.categoryName = $('#edit-category').val();
                match.assetCode = $('#edit-assetcode').val();
                match.assetName = $('#edit-assetname').val();
                match.remarks = $('#edit-remarks').val();
                match.status = $('#edit-status').val();

                localStorage.setItem('savedAssetAllocations', JSON.stringify(savedData));
            }
            $('#edit-modal').modal('hide');
            loadGridData();
            alertify.log('Asset Allocation updated successfully.', 'success', 5000);
        });

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');
            var assetCode = $(this).data('assetcode');
            
            alertify.confirm('Are you sure you want to delete this allocation?', function (confirmed) {
                if (confirmed) {
                    var localData = JSON.parse(localStorage.getItem('savedAssetAllocations') || '[]');
                    localData = localData.filter(function(i) {
                        var iDoc = i.docNo || i.sDocNo || i.allocationNo;
                        var iCode = i.assetCode || i.sAssetCode;
                        if (assetCode && assetCode !== '-' && iCode) {
                            return !(iDoc === docNo && iCode === assetCode);
                        }
                        return iDoc !== docNo;
                    });
                    localStorage.setItem('savedAssetAllocations', JSON.stringify(localData));

                    var deletedList = JSON.parse(localStorage.getItem('deletedAssetAllocations') || '[]');
                    var delKey = docNo + '|' + (assetCode && assetCode !== '-' ? assetCode : '');
                    if (!deletedList.includes(delKey)) {
                        deletedList.push(delKey);
                        localStorage.setItem('deletedAssetAllocations', JSON.stringify(deletedList));
                    }

                    loadGridData();
                    $('.alertify-log, .alertify-logs > *').remove();
                    alertify.log('Record deleted successfully.', 'success', 2500);
                }
            });
        });
    });
</script>
