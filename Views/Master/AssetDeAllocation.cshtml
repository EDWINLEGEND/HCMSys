<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-undo fa-sm text-primary mr-2"></i> Asset De-Allocation
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("AssetDeAllocationIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-info btn-sm shadow-sm ml-2" onclick="openInHandAssetsModal()">
                        <i class="fas fa-search fa-sm text-white-50 mr-1"></i> Show In Hand Assets
                    </button>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" onclick="saveDeAllocation()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="deAllocationForm" autocomplete="off">
        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments / Reason</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter reason or comments..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted">Upload handover document if any.</small>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex justify-content-between align-items-center">
            <span><i class="fas fa-boxes mr-2"></i>Assets to De-Allocate</span>
            <small class="text-white-50">Click "Show In Hand Assets" to select assets</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Allocation No</th>
                            <th>Asset Category</th>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Tag Number</th>
                            <th class="num-col">Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="8" class="text-center text-muted py-3">No assets selected for de-allocation. Click "Show In Hand Assets" above.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- IN HAND ASSETS MODAL -->
<div class="modal fade" id="inHandAssetsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-boxes mr-2"></i>In Hand Assets (Select Assets to De-Allocate)</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body px-4 py-3">
                <div class="form-group mb-3">
                    <label class="form-label">Select Employee <span class="text-danger">*</span></label>
                    <select class="form-control" id="modal-employee-select">
                        <option value="">Select Employee...</option>
                    </select>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover mb-0" id="modal-assets-table">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 45px; text-align:center;">
                                    <input type="checkbox" id="modal-select-all" onclick="toggleSelectAllAssets(this)" />
                                </th>
                                <th>Allocation No</th>
                                <th>Asset Category</th>
                                <th>Asset Code</th>
                                <th>Asset Name</th>
                                <th>Tag Number</th>
                                <th class="num-col">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2 bg-light">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success btn-sm px-4" onclick="importSelectedAssets()">
                    <i class="fas fa-check mr-1"></i> Save / Import to Grid
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    var employeesData = [];
    var inHandAssets = [];
    var currentModalAllocations = [];

    $(document).ready(function() {
        initHeader();

        $.getJSON('/Master/GetApiEmployees').done(function(empRes) {
            employeesData = Array.isArray(empRes) ? (Array.isArray(empRes[0]) ? empRes[0] : empRes) : [];
            populateDropdowns();
            if (typeof $.fn.select2 !== 'undefined') {
                try {
                    $('#hdr-employee').select2({ width: '100%' });
                    $('#modal-employee-select').select2({ dropdownParent: $('#inHandAssetsModal'), width: '100%' });
                } catch(e) {}
            }
        }).fail(function() {
            alertify.log('Failed to load employee data.', 'error', 5000);
        });

        $('#hdr-employee').on('change', function() {
            var empVal = $(this).val();
            if (!empVal) {
                $('#hdr-designation, #hdr-department, #hdr-manager').val('');
                inHandAssets = [];
                renderGrid();
                return;
            }

            if (Array.isArray(employeesData)) {
                var emp = employeesData.find(e => e.id == empVal || e.iMasterId == empVal || e.code == empVal || e.sCode == empVal);
                if (emp) {
                    $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '');
                    $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '');
                    $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || emp.reportingManagerName || emp.sReportingManager || '');
                }
            }
        });

        $('#modal-employee-select').on('change', function() {
            renderModalAssetsTable();
        });

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });
    });

    function initHeader() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        
        var deallocs = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');
        var seqNum = String(deallocs.length + 1).padStart(5, '0');

        $('#hdr-date').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-postdate').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-docno').val('DEA-' + mm + '-' + yy + '-' + seqNum);
    }

    function populateDropdowns() {
        var empSelect = $('#hdr-employee');
        var modalEmpSelect = $('#modal-employee-select');
        
        var currHdrVal = empSelect.val();
        var currModalVal = modalEmpSelect.val();

        empSelect.empty().append('<option value="">Select Employee...</option>');
        modalEmpSelect.empty().append('<option value="">Select Employee...</option>');

        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.id || emp.iMasterId;
                var empCode = emp.code || emp.sCode || '';
                var empName = emp.name || emp.sName || '';
                empSelect.append(`<option value="${empId}">${empCode} - ${empName}</option>`);
                modalEmpSelect.append(`<option value="${empId}">${empCode} - ${empName}</option>`);
            });
        }

        if (currHdrVal) empSelect.val(currHdrVal);
        if (currModalVal) modalEmpSelect.val(currModalVal);
    }

    function openInHandAssetsModal() {
        try {
            var currentEmpId = $('#hdr-employee').val();

            populateDropdowns();

            if (currentEmpId) {
                $('#hdr-employee').val(currentEmpId);
                $('#modal-employee-select').val(currentEmpId);
            } else {
                $('#modal-employee-select').val('');
            }

            if (typeof $.fn.select2 !== 'undefined') {
                try { $('#hdr-employee').trigger('change.select2'); } catch(e) {}
                try { $('#modal-employee-select').trigger('change.select2'); } catch(e) {}
            }

            renderModalAssetsTable();
        } catch (err) {
            console.error("Error preparing modal data:", err);
        } finally {
            $('#inHandAssetsModal').modal('show');
        }
    }

    function checkEmployeeMatch(itemEmpId, itemEmpCode, itemEmpName, targetEmpId, targetEmpCode, targetEmpName) {
        if (!targetEmpId) return false;
        
        var tIdStr = String(targetEmpId).trim();
        var tCodeStr = targetEmpCode ? String(targetEmpCode).toLowerCase().trim() : '';
        var tNameStr = targetEmpName ? String(targetEmpName).toLowerCase().trim() : '';

        // 1. Direct ID match
        if (itemEmpId && String(itemEmpId).trim() === tIdStr) return true;
        
        // 2. Direct Code match
        if (itemEmpCode && tCodeStr && String(itemEmpCode).toLowerCase().trim() === tCodeStr) return true;
        
        // 3. Name or substring match
        if (itemEmpName) {
            var itemStr = String(itemEmpName).toLowerCase().trim();
            if (tNameStr && (itemStr === tNameStr || itemStr.indexOf(tNameStr) !== -1 || tNameStr.indexOf(itemStr) !== -1)) return true;
            if (tCodeStr && itemStr.indexOf(tCodeStr) !== -1) return true;
            if (tIdStr && itemStr.indexOf(tIdStr) !== -1) return true;
        }

        return false;
    }

    function renderModalAssetsTable() {
        var empId = $('#modal-employee-select').val();
        var tbody = $('#modal-assets-table tbody');
        tbody.empty();
        $('#modal-select-all').prop('checked', false);

        if (!empId) {
            tbody.append('<tr><td colspan="7" class="text-center text-muted py-3">Please select an employee above to view allocated in-hand assets.</td></tr>');
            currentModalAllocations = [];
            return;
        }

        var selectedEmp = employeesData.find(e => (e.id || e.iMasterId) == empId);
        var empCode = selectedEmp ? (selectedEmp.code || selectedEmp.sCode || '') : '';
        var empName = selectedEmp ? (selectedEmp.name || selectedEmp.sName || '') : '';

        var deallocatedKeys = JSON.parse(localStorage.getItem('deallocatedAssetKeys') || '[]');

        function processAllocations(apiData) {
            var allInHand = [];
            var allocationsArray = [];

            if (Array.isArray(apiData)) {
                allocationsArray = apiData;
            } else if (apiData && Array.isArray(apiData.data)) {
                allocationsArray = apiData.data;
            } else if (apiData && apiData.data && Array.isArray(apiData.data.allocations)) {
                allocationsArray = apiData.data.allocations;
            }

            allocationsArray.forEach(function(item) {
                var isEmpMatch = checkEmployeeMatch(item.iEmpId || item.empId || item.employeeId, item.sEmployeeCode || item.employeeCode, item.sEmployeeName || item.employeeName, empId, empCode, empName);

                if (isEmpMatch && (item.iStatus === 1 || !item.iStatus)) {
                    var itemDocNo = item.sDocNo || item.docNo || ('AST' + String(item.iHeaderId || item.id || 1).padStart(6, '0'));
                    var assetList = (item.assets && item.assets.length > 0) ? item.assets :
                                    ((item.Assets && item.Assets.length > 0) ? item.Assets :
                                    ((item.sAssetCode || item.assetCode) ? [item] : []));

                    assetList.forEach(function(ast) {
                        var astCode = ast.sAssetCode || ast.assetCode || item.sAssetCode || item.assetCode || '';
                        var key = itemDocNo + '|' + astCode;
                        if (!deallocatedKeys.includes(key)) {
                            allInHand.push({
                                allocationNo: itemDocNo,
                                categoryName: ast.sCategoryName || ast.categoryName || item.sCategoryName || item.categoryName || '-',
                                assetCode: astCode || '-',
                                assetName: ast.sAssetName || ast.assetName || item.sAssetName || item.assetName || '-',
                                tagNumber: ast.sTagNumber || ast.tagNumber || item.sTagNumber || item.tagNumber || '-',
                                qty: ast.fQuantity || ast.qty || item.fQuantity || item.qty || 1,
                                remarks: ast.sRemarks || ast.remarks || item.sRemarks || item.remarks || item.sComments || '',
                                employeeId: empId,
                                employeeName: item.sEmployeeName || empName
                            });
                        }
                    });
                }
            });

            currentModalAllocations = allInHand;
            displayModalRows();
        }

        $.ajax({
            url: '/Master/GetApiAssetAllocations',
            type: 'GET',
            success: function(apiData) {
                processAllocations(apiData);
            },
            error: function() {
                processAllocations([]);
            }
        });
    }

    function displayModalRows() {
        var tbody = $('#modal-assets-table tbody');
        tbody.empty();

        if (currentModalAllocations.length === 0) {
            tbody.append('<tr><td colspan="7" class="text-center text-muted py-3">No active in-hand assets found for this employee.</td></tr>');
            return;
        }

        currentModalAllocations.forEach(function(item, idx) {
            var tr = `<tr>
                <td style="text-align:center;">
                    <input type="checkbox" class="modal-asset-check" data-idx="${idx}" />
                </td>
                <td class="font-weight-bold text-primary">${item.allocationNo || '-'}</td>
                <td>${item.categoryName || '-'}</td>
                <td>${item.assetCode || '-'}</td>
                <td>${item.assetName || '-'}</td>
                <td>${item.tagNumber || '-'}</td>
                <td class="num-col">${item.qty || 1}</td>
            </tr>`;
            tbody.append(tr);
        });
    }

    function toggleSelectAllAssets(chk) {
        $('.modal-asset-check').prop('checked', chk.checked);
    }

    function importSelectedAssets() {
        var selectedIndices = [];
        $('.modal-asset-check:checked').each(function() {
            selectedIndices.push(parseInt($(this).data('idx')));
        });

        if (selectedIndices.length === 0) {
            alertify.log('Please check at least one asset to de-allocate.', 'error', 5000);
            return;
        }

        var empId = $('#modal-employee-select').val();
        if (empId) {
            $('#hdr-employee').val(empId).trigger('change.select2');
            $('#hdr-employee').trigger('change');
        }

        var selectedItems = selectedIndices.map(idx => currentModalAllocations[idx]);

        inHandAssets = selectedItems;
        renderGrid();

        $('#inHandAssetsModal').modal('hide');
        alertify.log(selectedItems.length + ' asset(s) imported to de-allocation grid.', 'success', 5000);
    }

    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();
        
        if(inHandAssets.length === 0) {
            uTbody.append('<tr><td colspan="8" class="text-center text-muted py-3">No assets selected for de-allocation</td></tr>');
            return;
        }

        inHandAssets.forEach(function(item, index) {
            item.gridIndex = index;
            var tr = `<tr>
                <td class="action-btns" style="text-align:center;">
                    <a href="#" class="remove-item-btn" title="Remove from De-Allocation" onclick="removeFromGrid(${index}); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </td>
                <td class="font-weight-bold text-primary">${item.allocationNo || '-'}</td>
                <td>${item.categoryName || '-'}</td>
                <td>${item.assetCode || '-'}</td>
                <td>${item.assetName || '-'}</td>
                <td>${item.tagNumber || '-'}</td>
                <td class="num-col">${item.qty || 1}</td>
                <td><input type="text" class="form-control form-control-sm dealloc-remarks" data-idx="${index}" value="De-Allocated" /></td>
            </tr>`;
            uTbody.append(tr);
        });
    }

    function removeFromGrid(index) {
        inHandAssets.splice(index, 1);
        renderGrid();
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function saveDeAllocation() {
        if (inHandAssets.length === 0) {
            alertify.log('No assets selected for de-allocation.', 'error', 5000);
            return;
        }

        if(!$('#hdr-employee').val()) {
            alertify.log('Please select an Employee.', 'error', 5000);
            return;
        }

        var docNo = $('#hdr-docno').val();
        var date = $('#hdr-date').val();
        var empId = $('#hdr-employee').val();
        var emp = employeesData.find(e => (e.id || e.iMasterId) == empId);
        var empName = emp ? (emp.name || emp.sName || '') : '';

        var deallocatedKeys = JSON.parse(localStorage.getItem('deallocatedAssetKeys') || '[]');
        var savedDeAllocations = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');

        inHandAssets.forEach(function(asset, idx) {
            var inputRemark = $('.dealloc-remarks[data-idx="'+idx+'"]').val() || 'De-Allocated';
            var key = asset.allocationNo + '|' + asset.assetCode;
            if (!deallocatedKeys.includes(key)) {
                deallocatedKeys.push(key);
            }

            savedDeAllocations.push({
                deAllocDocNo: docNo,
                deAllocDate: date,
                employeeId: empId,
                employeeName: empName || asset.employeeName || '-',
                allocationNo: asset.allocationNo,
                categoryName: asset.categoryName,
                assetCode: asset.assetCode,
                assetName: asset.assetName,
                tagNumber: asset.tagNumber,
                qty: asset.qty,
                deAllocRemarks: inputRemark,
                status: 'De-Allocated'
            });
        });

        localStorage.setItem('deallocatedAssetKeys', JSON.stringify(deallocatedKeys));
        localStorage.setItem('savedAssetDeAllocations', JSON.stringify(savedDeAllocations));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: 'Asset De-Allocation saved successfully!', type: 'success' }));
        var targetUrl = '@Url.Action("AssetDeAllocationIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }
</script>
