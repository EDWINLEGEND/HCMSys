@{
    ViewData["Title"] = "Asset De-Allocation List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
</style>

<div class="container-fluid py-3">

    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-box-open fa-sm"></i>
                    Asset De-Allocation List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("AssetDeAllocation", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total De-Allocations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-box-open fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>De-Allocated Assets
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:70px; text-align:center;">Action</th>
                            <th>Ret Doc No</th>
                            <th>Ret Date</th>
                            <th>Employee Name</th>
                            <th>Category</th>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Ret Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Edit Asset De-Allocation</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-allocno" />
                <div class="form-group mb-2">
                    <label class="form-label">Ret Doc No</label>
                    <input type="text" class="form-control" id="edit-docno" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Ret Date</label>
                    <input type="text" class="form-control" id="edit-date" placeholder="e.g. 18-Jul-2026" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Employee Name</label>
                    <input type="text" class="form-control" id="edit-employee" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Category</label>
                    <input type="text" class="form-control" id="edit-category" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Asset Code</label>
                    <input type="text" class="form-control" id="edit-assetcode" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Asset Name</label>
                    <input type="text" class="form-control" id="edit-assetname" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Ret Remarks</label>
                    <input type="text" class="form-control" id="edit-remarks" />
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="save-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No de-allocations found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        function loadGridData() {
            table.clear();
            var savedDeallocs = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');
            
            // Only include items that have a valid De-Allocation Document Number (e.g. DEA-...)
            var deallocList = [];
            savedDeallocs.forEach(function(item) {
                var dNo = item.deAllocDocNo || item.returnDocNo || '';
                var aCode = item.assetCode || '';
                
                // Ensure it is a DEA document number (or custom deallocation doc no), not an ALL allocation doc no
                if (dNo && (dNo.startsWith('DEA') || (!dNo.startsWith('ALL') && dNo.includes('-')))) {
                    if (!deallocList.some(c => c.deAllocDocNo === dNo && c.assetCode === aCode)) {
                        deallocList.push(item);
                    }
                }
            });

            $('#stat-total').text(deallocList.length);

            deallocList.reverse().forEach(function(item) {
                var dNo = item.deAllocDocNo || item.returnDocNo || '-';
                var aCode = item.assetCode || '-';
                var actionHtml = `
                    <div class="action-btns" style="text-align:center;">
                        <a href="#" class="edit-item-btn" data-docno="${dNo}" data-assetcode="${aCode}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                        <a href="#" class="remove-item-btn" data-docno="${dNo}" data-assetcode="${aCode}" title="Revert/Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                    </div>
                `;
                table.row.add([
                    actionHtml,
                    dNo,
                    window.formatDateDisplay(item.deAllocDate || item.returnDate),
                    item.employeeName || '-',
                    item.categoryName || '-',
                    aCode,
                    item.assetName || '-',
                    item.deAllocRemarks || item.returnRemarks || 'De-Allocated'
                ]);
            });
            table.draw(false);
        }

        loadGridData();

        // Edit Handler
        $('#data-grid tbody').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');
            var assetCode = $(this).data('assetcode');
            
            var deallocs = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');
            var item = deallocs.find(i => (i.deAllocDocNo || i.returnDocNo) === docNo && (!assetCode || i.assetCode === assetCode));

            if (item) {
                $('#edit-allocno').val(docNo);
                $('#edit-docno').val(item.deAllocDocNo || item.returnDocNo || '');
                $('#edit-date').val(item.deAllocDate || item.returnDate || '');
                $('#edit-employee').val(item.employeeName || '');
                $('#edit-category').val(item.categoryName || '');
                $('#edit-assetcode').val(item.assetCode || '');
                $('#edit-assetname').val(item.assetName || '');
                $('#edit-remarks').val(item.deAllocRemarks || item.returnRemarks || '');

                $('#edit-modal').modal('show');
            }
        });

        $('#save-edit-btn').click(function() {
            var targetDocNo = $('#edit-allocno').val();
            var deallocs = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');
            var match = deallocs.find(i => (i.deAllocDocNo || i.returnDocNo) === targetDocNo);
            
            if (match) {
                match.deAllocDate = $('#edit-date').val();
                match.employeeName = $('#edit-employee').val();
                match.categoryName = $('#edit-category').val();
                match.assetCode = $('#edit-assetcode').val();
                match.assetName = $('#edit-assetname').val();
                match.deAllocRemarks = $('#edit-remarks').val();

                localStorage.setItem('savedAssetDeAllocations', JSON.stringify(deallocs));
            }

            $('#edit-modal').modal('hide');
            loadGridData();
            alertify.log('Asset De-Allocation updated successfully.', 'success', 5000);
        });

        // Delete/Revert Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');
            var assetCode = $(this).data('assetcode');
            
            alertify.confirm('Are you sure you want to revert/delete this de-allocation?', function (confirmed) {
                if (confirmed) {
                    var deallocs = JSON.parse(localStorage.getItem('savedAssetDeAllocations') || '[]');
                    var removedItem = deallocs.find(i => (i.deAllocDocNo || i.returnDocNo) === docNo && (!assetCode || i.assetCode === assetCode));
                    
                    deallocs = deallocs.filter(i => !((i.deAllocDocNo || i.returnDocNo) === docNo && (!assetCode || i.assetCode === assetCode)));
                    localStorage.setItem('savedAssetDeAllocations', JSON.stringify(deallocs));

                    if (removedItem) {
                        var deallocatedKeys = JSON.parse(localStorage.getItem('deallocatedAssetKeys') || '[]');
                        var keyToRemove = (removedItem.allocationNo || '') + '|' + (removedItem.assetCode || '');
                        deallocatedKeys = deallocatedKeys.filter(k => k !== keyToRemove && !k.startsWith(docNo + '|'));
                        localStorage.setItem('deallocatedAssetKeys', JSON.stringify(deallocatedKeys));

                        var data = JSON.parse(localStorage.getItem('savedAssetAllocations') || '[]');
                        data.forEach(function(match) {
                            if ((match.docNo || match.allocationNo) === removedItem.allocationNo && match.assetCode === removedItem.assetCode) {
                                match.status = 'Allocated';
                                delete match.deAllocDocNo;
                                delete match.deAllocDate;
                                delete match.deAllocRemarks;
                            }
                        });
                        localStorage.setItem('savedAssetAllocations', JSON.stringify(data));
                    }

                    loadGridData();
                    alertify.log('Record reverted successfully.', 'success', 5000);
                }
            });
        });
    });
</script>
