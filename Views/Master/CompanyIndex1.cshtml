@model IEnumerable<HCMSys.Models.vmHCM_Company>
@using Microsoft.AspNetCore.Http;
@{
    string detailsUrl = Url.Action("DownloadExcel", "Common", new { id = 99 });
}
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />
<link rel="stylesheet" href="~/dist/css/Site.css" />

@* <script src="~/lib/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />
 *@
<style>
    html { font-size: 14px; }

    /* ── Loading Overlay ── */
    #loading {
        display: none;
        position: fixed;
        left: 0; top: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.08);
        z-index: 9999;
    }
    #loadingcontent {
        display: table;
        position: fixed;
        left: 0; top: 0;
        width: 100%; height: 100%;
    }
    #loadingspinner {
        display: table-cell;
        vertical-align: middle;
        text-align: center;
        font-size: 1.1rem;
    }
    #loadingspinner::after {
        content: '';
        display: inline-block;
        width: 48px; height: 48px;
        border: 5px solid #e3e6f0;
        border-top-color: #4e73df;
        border-radius: 50%;
        animation: spin 0.75s linear infinite;
    }
    keyframes spin { to { transform: rotate(360deg); } }

    /* ── Page Title Bar ── */
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Table Enhancements ── */
    #tblCompany thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #tblCompany tbody tr:hover { background-color: #f0f3ff; }
    #tblCompany td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a {
        margin: 0 3px;
        transition: opacity 0.15s;
    }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit      { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    /* ── Company Logo Preview ── */
    .logo-preview-wrapper {
        width: 80px; height: 80px;
        border: 2px dashed #d1d3e2;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f8f9fc;
        cursor: pointer;
        transition: border-color 0.2s;
    }
    .logo-preview-wrapper:hover { border-color: #4e73df; }
    .logo-preview-wrapper img {
        width: 100%; height: 100%;
        object-fit: contain;
    }
    .logo-placeholder-icon { color: #d1d3e2; font-size: 2rem; }

    /* ── Table Logo Thumbnail ── */
    .logo-thumb {
        width: 36px; height: 36px;
        object-fit: contain;
        border: 1px solid #e3e6f0;
        border-radius: 4px;
        background: #f8f9fc;
    }

    /* ── Modal Header Override ── */
    .modal-header-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        border-bottom: none;
        padding: 14px 20px;
    }
    .modal-header-primary .modal-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .modal-header-primary .close-modal-btn {
        color: rgba(255,255,255,0.8);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        line-height: 1;
        transition: color 0.15s;
    }
    .modal-header-primary .close-modal-btn:hover { color: #fff; }
    .modal-footer-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        padding: 8px 20px;
        border-top: none;
    }

    /* ── Form Label Style ── */
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control {
        font-size: 0.85rem;
        border-color: #d1d3e2;
        color: #6e707e;
        border-radius: 0.35rem;
    }
    .form-control:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2);
    }

    /* ── Stat Cards ── */
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
</style>

<!-- ════════════════════════════════════════════
     PAGE HEADER CARD
════════════════════════════════════════════ -->
<div class="container-fluid">

    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-building fa-sm"></i>
                    Company Master
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>

                    <a href="#"
                       class="btn btn-success btn-sm shadow-sm"
                       onclick="clearFieldsWithModal()"
                       data-toggle="modal"
                       data-target="#Company-modal">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         STAT CARDS ROW
    ════════════════════════════════════════════ -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Companies</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-building fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Records</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Last Modified</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800" id="stat-modified">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Module</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">Company</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-sitemap fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         MAIN DATA TABLE CARD
    ════════════════════════════════════════════ -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Company Records
            </h6>
            <span class="badge badge-primary" id="record-count-badge">
                @(Model != null ? Model.Count().ToString() : "0") Records
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblCompany"
                       class="table table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px; text-align:center;">Action</th>
                            <th style="width:60px;">Id</th>
                            <th style="width:100px;">Code</th>
                            <th>Name</th>
                            <th style="width:150px;">Contact Person</th>
                            <th style="width:130px;">Contact No</th>
                            <th>Address 1</th>
                            <th>Address 2</th>
                            <th style="width:80px; text-align:center;">Logo</th>
                            <!-- Hidden data carrier -->
                            <th style="display:none;">Created By</th>
                            <th style="display:none;">Created Date</th>
                            <th style="display:none;">Modified By</th>
                            <th style="display:none;">Modified Date</th>                            
                            <th style="display:none;">LogoPath</th>
                            <th style="display:none;">sArabicName</th>
                            <th style="display:none;">sLogoName</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="action-btns" style="text-align:center;">
                                    <a href="#"
                                       class="edit-item-btn"
                                       data-toggle="modal"
                                       data-target="#Company-modal"
                                       title="Edit Company">
                                        <i class="fas fa-edit fa-sm fa-fw"></i>
                                    </a>
                                    <a href="#"
                                       class="remove-item-btn"
                                       title="Delete Company">
                                        <i class="fas fa-trash-alt fa-sm fa-fw"></i>
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(m => item.iCompanyId)</td>
                                <td>@Html.DisplayFor(m => item.sCode)</td>
                                <td>@Html.DisplayFor(m => item.sName)</td>
                                <td>@Html.DisplayFor(m => item.sContactPerson)</td>
                                <td>@Html.DisplayFor(m => item.sContactNo)</td>
                                <td>@Html.DisplayFor(m => item.sAddress1)</td>
                                <td>@Html.DisplayFor(m => item.sAddress2)</td>
                                <td style="text-align:center;">
@*                                     @if (!string.IsNullOrEmpty(item.sLogoPath))
                                    {
                                        <img src=item.sLogoPath
                                             class="logo-thumb"
                                             alt="Logo" />
                                    } *@
                                    @if (!string.IsNullOrEmpty(item.sLogoPath))
                                    {    
 
                                        <img src="@Url.Content(item.sLogoPath)"              
                                        class="logo-thumb"              
                                        alt="Logo" />
 
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:0.75rem;">No Logo</span>
                                    }
                                </td>
                                <!-- Hidden data carrier -->
                                <td style="display:none;">@Html.DisplayFor(m => item.CreatedBy)</td>
                                <td style="display:none;">@Html.DisplayFor(m => item.CreatedDate)</td>
                                <td style="display:none;">@Html.DisplayFor(m => item.ModifiedBy)</td>
                                <td style="display:none;">@Html.DisplayFor(m => item.ModifiedDate)</td>
                                <td style="display:none;">@Url.Content(item.sLogoPath)</td> 
                                <td style="display:none;">@item.sArabicName</td>
                                <td style="display:none;">@item.sLogoName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         ADD / UPDATE MODAL
    ════════════════════════════════════════════ -->
    <div class="modal fade"
         id="Company-modal"
         aria-labelledby="Company-modal-label"
         aria-hidden="true"
         role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header modal-header-primary d-flex align-items-center justify-content-between">
                    <h6 class="modal-title" id="Company-modal-label">
                        <i class="fas fa-building mr-2"></i>Add New Company
                    </h6>
                    <a href="#"
                       class="close-modal-btn"
                       id="btn-close-modal"
                       data-dismiss="modal"
                       aria-label="Close"
                       onclick="clearFieldsWithModal()">
                        <i class="fas fa-times"></i>
                    </a>
                </div>

                <div class="modal-body px-4 py-3">
                    <form autocomplete="off" enctype="multipart/form-data">

                        <!-- Row 1: Code + Name -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="code-field">Code</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Auto-generated"
                                           id="code-field"
                                           required
                                           readonly>
                                    <small class="form-text text-muted">Auto-generated by the system.</small>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="name-field">Company Name</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter company name"
                                           id="name-field"
                                           required>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: Contact Person + Contact No -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="contact-person-field">Contact Person</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter contact person name"
                                           id="contact-person-field">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="contact-no-field">Contact No</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter contact number"
                                           id="contact-no-field">
                                </div>
                            </div>
                        </div>

                        <!-- Row 3: Address 1 + Address 2 -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="address1-field">Address 1</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter address line 1"
                                           id="address1-field">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="address2-field">Address 2</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter address line 2"
                                           id="address2-field">
                                </div>
                            </div>
                        </div>

                        <!-- Row 4: Company Logo -->
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group mb-3">
                                    <label class="form-label">Company Logo</label>
                                    <div class="d-flex align-items-center" style="gap:16px;">
                                        <!-- Preview Box -->
                                        <div class="logo-preview-wrapper" id="logo-preview-box"
                                             onclick="$('#logo-field').click();"
                                             title="Click to select logo">
                                            <img id="logo-preview-img"
                                                 src="#"
                                                 alt="Logo Preview"
                                                 style="display:none;" />
                                            <i class="fas fa-image logo-placeholder-icon" id="logo-placeholder-icon"></i>
                                        </div>
                                        <!-- File Input -->
                                        <div class="flex-grow-1">
                                            <div class="custom-file">
                                                <input type="file"
                                                       class="custom-file-input"
                                                       id="logo-field"
                                                       accept=".jpg,.jpeg,.png,.gif,.svg,.webp">
                                                <label class="custom-file-label" for="logo-field">
                                                    Choose logo file...
                                                </label>
                                            </div>
                                            <small class="form-text text-muted">
                                                Accepted: .jpg, .jpeg, .png, .gif, .svg, .webp. Click the preview box or browse to upload.
                                            </small>
                                            <small class="form-text text-info" id="current-logo-info" style="display:none;">
                                                <i class="fas fa-info-circle mr-1"></i>
                                                Current logo will be kept if no new file is selected.
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden fields -->
                        <input type="hidden" id="id-field" value="0">
                        <input type="hidden" id="existing-logo-field" value="">
                        <input type="hidden" id="existing-logo-name-field" value="">
                        <input type="hidden" id="createdby-field">
                        <input type="hidden" id="createddate-field">
                        <input type="hidden" id="modifiedby-field">
                        <input type="hidden" id="modifieddate-field">
                        <input type="hidden" id="userid" name="userid" value="@Context.Session.GetString("userid")" />

                        <hr class="my-3">
                        <div class="d-flex justify-content-end" style="gap:8px;">
                            <button type="button"
                                    class="btn btn-success btn-sm px-4"
                                    id="add-btn">
                                <i class="fas fa-plus mr-1"></i> Add
                            </button>
                            <button type="button"
                                    class="btn btn-danger btn-sm px-4"
                                    data-dismiss="modal"
                                    aria-label="Close"
                                    onclick="clearFieldsWithModal()">
                                <i class="fas fa-times mr-1"></i> Close
                            </button>
                        </div>
                    </form>
                </div>

                <div class="modal-footer modal-footer-primary py-2"></div>
            </div>
        </div>
    </div>

  
</div><!-- /container-fluid -->

<!-- ════════════════════════════════════════════
     LOADING OVERLAY
════════════════════════════════════════════ -->
<section>
    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner"></p>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════════ -->
<script src="https://code.jquery.com/jquery-3.5.1.js"></script>
<script defer src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>

<script>
    var LoginId = "";

    $(document).ready(function () {

        var table = $('#tblCompany').DataTable({
            order: [[1, 'desc']],
            pageLength: 15,
            language: {
                search: "",
                searchPlaceholder: "Search Companies...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ Companies",
                emptyTable: "No Company records found"
            },
            columnDefs: [
                { orderable: false, targets: [0, 8] }
            ]
        });

        // Update stat cards
        var totalRows = table.rows().count();
        $('#stat-total').text(totalRows);
        $('#stat-active').text(totalRows);
        $('#record-count-badge').text(totalRows + ' Records');

        // Last modified date from first row (sorted desc)
        var firstRow = table.row(0).data();
        if (firstRow) {
            var lastMod = $(table.row(0).node()).find('td').eq(12).text().trim();
            $('#stat-modified').text(lastMod || 'N/A');
        }

        // Custom file input label update (import modal)
        $(document).on('change', '#file-field', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').html(fileName || 'Choose file...');
        });

        // Logo file preview
        $(document).on('change', '#logo-field', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').html(fileName || 'Choose logo file...');

            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#logo-preview-img').attr('src', e.target.result).show();
                    $('#logo-placeholder-icon').hide();
                };
                reader.readAsDataURL(file);
            }
        });

        getNo();
        LoginId = $("#userid").val();
    });

    /* ── Clear field helpers ── */
    function clearFields() {
        $('#code-field').val("").prop("disabled", false);
        $('#name-field').val("");
        $('#contact-person-field').val("");
        $('#contact-no-field').val("");
        $('#address1-field').val("");
        $('#address2-field').val("");
        $('#logo-field').val("");
        $('.custom-file-label').html('Choose logo file...');
        $('#logo-preview-img').attr('src', '#').hide();
        $('#logo-placeholder-icon').show();
        $('#existing-logo-field').val("");
        $('#existing-logo-name-field').val("");
        $('#current-logo-info').hide();
        $('#file-field').val("");
        $('#id-field').val(0);
        $('#add-btn').html('<i class="fas fa-plus mr-1"></i> Add');
        $('#Company-modal-label').html('<i class="fas fa-building mr-2"></i>Add New Company');
    }

    function clearFieldsWithModal() {
        getNo();
        clearFields();
    }

    /* ── Fetch next code ── */
    function getNo() {
        $('#loading').fadeIn();
        $.ajax({
            url: "@Url.Action("getCode", "Common")",
            method: 'GET',
            data: { id: 24 },
            dataType: "json",
            success: function (response) {
                $('#code-field').val(response);
            },
            complete: function () {
                $('#loading').fadeOut();
            }
        });
    }

   
  
    /* ── Edit row click ── */
    $(document).on('click', 'a.edit-item-btn', function (event) {
        event.preventDefault();
        var currentRow = $(this).closest("tr");
        clearFields();

        $('#add-btn').html('<i class="fas fa-sync-alt mr-1"></i> Update');
        $('#Company-modal-label').html('<i class="fas fa-edit mr-2"></i>Update Company');

        // Column indices:
        // 0=Action, 1=Id, 2=Code, 3=Name, 4=ContactPerson,
        // 5=ContactNo, 6=Address1, 7=Address2, 8=Logo(img), 9=CreatedBy,
        // 10=CreatedDate, 11=ModifiedBy, 12=ModifiedDate, 13=LogoPath(hidden)

        var id            = currentRow.find("TD").eq(1).text().trim();
        var sCode         = currentRow.find("TD").eq(2).text().replace(/&amp;/g, '&').trim();
        var sName         = currentRow.find("TD").eq(3).text().replace(/&amp;/g, '&').trim();
        var sContactPerson = currentRow.find("TD").eq(4).text().replace(/&amp;/g, '&').trim();
        var sContactNo    = currentRow.find("TD").eq(5).text().replace(/&amp;/g, '&').trim();
        var sAddress1     = currentRow.find("TD").eq(6).text().replace(/&amp;/g, '&').trim();
        var sAddress2     = currentRow.find("TD").eq(7).text().replace(/&amp;/g, '&').trim();
        var logoPath      = currentRow.find("TD").eq(13).text().trim();
        var sArabicName   = currentRow.find("TD").eq(14).text().trim();
        var logoName      = currentRow.find("TD").eq(15).text().trim();

        $('#code-field').prop("disabled", true).val(sCode);
        $('#name-field').val(sName);
        $('#contact-person-field').val(sContactPerson);
        $('#contact-no-field').val(sContactNo);
        $('#address1-field').val(sAddress1);
        $('#address2-field').val(sAddress2);
        $('#id-field').val(id);
        $('#existing-logo-field').val(logoPath);
        $('#existing-logo-name-field').val(logoName);
        // Show existing logo in preview
        if (logoPath && logoPath.length > 0) {
            $('#logo-preview-img').attr('src', logoPath).show();
            $('#logo-placeholder-icon').hide();
            $('#current-logo-info').show();
            $('.custom-file-label[for="logo-field"]').html('Change logo...');
        }

        return false;
    });

    /* ── Add / Update button ── */
    $('#add-btn').click(function () {
        var code          = $("#code-field").val();
        var id            = $('#id-field').val();
        var name          = $("#name-field").val();
        var contactPerson = $("#contact-person-field").val();
        var contactNo     = $("#contact-no-field").val();
        var address1      = $("#address1-field").val();
        var address2      = $("#address2-field").val();
        var existingLogo  = $("#existing-logo-field").val();
        var existingLogoName  = $("#existing-logo-name-field").val();
        var sts           = $(this).text().trim();
        var flg           = 0;

        if (!code) {
            alertify.log("Code cannot be blank", "error", 5000);
            return false;
        }
        if (!name) {
            alertify.log("Company Name cannot be blank", "error", 5000);
            $('#name-field').focus();
            return false;
        }

        $('#loading').fadeIn();

        // Use FormData to support file upload (logo)
        var formData = new FormData();
        formData.append('iCompanyId',     id);
        formData.append('sCode',          code);
        formData.append('sName',          name);
        formData.append('sContactPerson', contactPerson);
        formData.append('sContactNo',     contactNo);
        formData.append('sAddress1',      address1);
        formData.append('sAddress2',      address2);
        formData.append('sLogoPath',  existingLogo);
        formData.append('sLogoName',  existingLogoName);
        formData.append('iCreatedby',     LoginId);
        formData.append('iModifiedBy',    LoginId);

        // Append logo file only if a new one was selected
        var logoFile = $('#logo-field')[0].files[0];
        if (logoFile) {
            formData.append('logoFile', logoFile);
        }

        var actionUrl = (sts === "Update")
            ? "@Url.Action("UpdateCompany", "Master")"
            : "@Url.Action("CreateCompany", "Master")";

        $.ajax({
            method: "POST",
            url: actionUrl,
            data: formData,
            processData: false,
            contentType: false,
            dataType: "json",
            success: function (r) {
                if (r != null && r != "") {
                    if (r == "Invalid Session") {
                        location.href = '@Url.Action("Logout", "Login")';
                    } else {
                        alertify.log(r, "error", 5000);
                    }
                } else {
                    var msg = (sts === "Update")
                        ? code + " - Company Updated Successfully"
                        : code + " - Company Created Successfully";
                    alertify.set({ delay: 5000 });
                    alertify.log(msg, "success", 5000);
                    flg = 1;
                    location.href = '@Url.Action("CompanyIndex", "Master")';
                }
            },
            error: function () {
                alertify.log("An error occurred. Please try again.", "error", 5000);
            },
            complete: function () {
                if (flg == 1) {
                    $('#Company-modal').modal('hide');
                    clearFields();
                }
                $('#loading').fadeOut();
            }
        });

        return false;
    });

    /* ── Delete row click ── */
    $(document).on('click', 'a.remove-item-btn', function (event) {
        event.preventDefault();
        var currentRow = $(this).closest("tr");
        var code = currentRow.find("TD").eq(2).text().replace(/&amp;/g, '&').trim();
        var id   = currentRow.find("TD").eq(1).text().replace(/&amp;/g, '&').trim();

        alertify.confirm('Are you sure you want to delete: ' + code + '?', function(e) {
            if (e) {
                var flg = 0;
                $('#loading').fadeIn();

                $.ajax({
                    method: "POST",
                    url: "@Url.Action("DeleteCompany", "Master")",
                    data: { iCompanyId: id, UserId: LoginId },
                    dataType: "json",
                    success: function (result) {
                        if (result.result != "Company Deleted Successfully") {
                            alertify.log(code + " - Delete Operation Failed", "error", 5000);
                        } else {
                            alertify.log(code + " - " + result.result, "success", 5000);
                            flg = 1;
                            location.href = '@Url.Action("CompanyIndex", "Master")';
                        }
                    },
                    error: function () {
                        alertify.log("Error during delete. Please try again.", "error", 5000);
                    },
                    complete: function () {
                        if (flg == 1) { clearFields(); }
                        $('#loading').fadeOut();
                    }
                });
            }
        });

        return false;
    });
</script>