@model IEnumerable<MployTracker.Web.Models.vtSer_CheckLists_Detail>
 
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/sweetalert-dev.js"></script>
<link href="~/lib/sweetalert.css" rel="stylesheet" />
<script src="~/scripts/FClient.js"></script>
<link href="~/lib/datepicker/datepicker.css" rel="stylesheet" />
@*<script   href="~/lib/select2/js/select2.min.js" ></script>
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />*@
<script defer src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<style>
    .message-div {
        text-align: center;
        color: red;
        margin: 2px !important;
    }

    .tabs {
        --bar-color: red;
        --background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 60%, #e0e0e0);
        display: flex;
        width: 600px;
        /*border: 1px solid #ddd;*/
    }

        .tabs > .tab {
            flex: 1;
            display: flex;
        }

    .tab > .tab-input {
        width: 0;
        height: 0;
        margin: 0;
        display: none;
    }

    .tab > .tab-box {
        padding: .5rem;
        width: 100%;
        text-align: center;
        transition: 0.5s;
        border-bottom: 2px solid rgba(0,0,0,0);
    }

    .tab > .tab-input:checked + .tab-box {
        background: var(--background);
        border-color: var(--bar-color);
    }

    .form-control {
        max-width: none;
    }

    .document-status {
        width: 100%;
        border: none;
        background: red;
        color: white;
        border: 1px solid;
        border-radius: 37px;
        padding: 5px;
        cursor: context-menu;
        display: block;
        text-align: center;
    }

    .p-20 {
        padding: 20px;
    }

    /*.net-amount {
            border: none;
            font-size: 18px;
            font-weight: bolder;
            text-align: right;
            box-shadow: none;
        }*/

    .label-box {
        border: none !important;
        box-shadow: none !important;
        text-align: center !important;
        font-weight: bold !important;
        font-size: 20px !important;
    }

    .net-amount {
        border: none !important;
        box-shadow: none !important;
        font-weight: bolder !important;
        font-size: 22px !important;
    }

    .profile-image {
        height: 125px;
        padding: 10px;
        width: 125px;
        border-radius: 40px;
    }

    .p-t-5 {
        padding-top: 5px;
    }

    .btn-transparent {
        background: transparent;
        box-shadow: none;
        border: none;
    }

    /*.col-xs-6 {
            padding-right: 0px !important;
        }*/

    /*temporary*/
    .navbar-inverse {
        display: none;
    }
</style>

<section class="content-header">
    <h1>
        CheckLists
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Home</a></li>
        <li><a href="@Url.Action("CheckListIndex", "Master") ">CheckLists List</a></li>
        <li class="active">CheckLists</li>
    </ol>
</section>
<!-- Main content -->
<section class="content container-fluid">
    <!-- Horizontal Form -->
    <div class="box box-success">
        <div class="box-header with-border">
            <h3 class="box-title">Create CheckList</h3>
        </div>
        <!-- /.box-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="box-body">
                <div class="col-xs-12">
                    <div class="col-xs-6">
                        <div class="col-xs-12">
                            <div class="col-xs-6">
                                <label>Check List Type</label>
                            </div>
                            <select class="form-control select" id="ddlCheckListType">
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="col-xs-12">
                            <div class="col-xs-6">
                                <label>Check List Name</label>
                            </div>
                            <input type="text" class="form-control" id="CheckListName" name="CheckListName" placeholder="Check List Name" value="">
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="col-xs-12">
                            <div class="col-xs-6">
                                <label>Model</label>
                            </div>
                            <select class="form-control select" id="ddlModel">
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="col-xs-12">
                            <div class="col-xs-6">
                                <label>Brand</label>
                            </div>
                            <select class="form-control select" id="ddlBrand">
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="col-xs-12">
                            <div class="col-xs-6">
                                <label>Vehicle Series</label>
                            </div>
                            <select class="form-control select" id="ddlVehicleSeries">
                            </select>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="iHeaderId" name="iHeaderId" value="0" />
                <input type="hidden" id="iDate" name="iHeaderId" value="0" />
                <input type="hidden" id="sVoucherNo" name="sVoucherNo" value="" />
                <a href="" onclick="AddItem()" class="btn btn-primary btn-sm pull-right btnCreate">Add</a>


                <table id="WebGrid" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Description</th>
                            <th>Remarks</th>
                            <th>Edit</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody id="WgBody">
                        @{int i = 1;}
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.Description</td>

                                <td>@item.Remarks</td>
                                <td>
                                    <p data-placement="top" data-toggle="tooltip" title="Edit">
                                        @*<a href="" onclick="ChangeItem()" data-toggle="tooltip" title="Edit" class="btn btn-info btn-xs fa fa-pencil-square-o btnView"><i class="menu-icon glyphicon-edit"></i></a>*@
                                        <button type="button" id="btnEdit" data-toggle="tooltip" title="Edit" class="icon-edit  btn-info btn-xs fa fa-pencil-square-o btnView"><i class="menu-icon glyphicon-edit"></i></button>
                                    </p>
                                </td>
                                <td>
                                    <p data-placement="top" data-toggle="tooltip" title="Delete">
                                        <button type="button" data-toggle="tooltip" title="Delete" class="deletebtn btn-danger fa fa-trash  btn-xs btnDelete"><i class="menu-icon icon-trash"></i></button>
                                    </p>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
                <button type="button" id="btnUpdate" class="btn btn-info pull-right">Create</button>
            </div>
            <!-- /.box-footer -->
        </form>
    </div>
    <!-- /.box  -->
    @*update checklist*@
    <div class="modal fade" id="modalCheckList" tabindex="-1" role="dialog" aria-labelledby="modalCheckList" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title text-center" id="modalCheckList">Edit CheckList Item</h3>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered table-striped">
                        <tr>
                            <td><label>Line Id: </label></td>
                            <td><input type="text" id="lid" class="form-control col-xs-4" readonly name="Id" placeholder=""></td>
                        </tr>
                        <tr>
                            <td> <label>Description : </label></td>
                            <td> <textarea class="form-control" id="txtDescription"></textarea></td>
                        </tr>
                        <tr>
                            <td><label>Remarks : </label></td>
                            <td><textarea class="form-control" id="txtRemarks"></textarea></td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="btnSave">Save</button>
                </div>
            </div>
        </div>
    </div>
    @*add checklist*@
    <div class="modal fade" id="modalCheckListAdd" tabindex="-1" role="dialog" aria-labelledby="modalCheckListAdd" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title text-center" id="modalCheckListAdd">Add CheckList Item</h3>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered table-striped">
                        <tr>
                            <td><label>Line Id: </label></td>
                            <td><input type="text" id="nlid" class="form-control col-xs-4" readonly name="Id" placeholder=""></td>
                        </tr>
                        <tr>
                            <td> <label>Description : </label></td>
                            <td> <textarea class="form-control" id="ntxtDescription"></textarea></td>
                        </tr>
                        <tr>
                            <td><label>Remarks : </label></td>
                            <td><textarea class="form-control" id="ntxtRemarks"></textarea></td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="btnAdd">Save</button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
        var companyId = 0;
        var sessionId = "";
        var LoginId = 0;
        var currentRow = null;
        $(document).ready(function () {
            debugger;
            getLoginDetails();
            loadBrand();
            loadModel();
            loadCheckListTypes();
            loadVehicleSeries();
            //$("#ddlCheckListType").select2();
            //$("#ddlBrand").select2();
            //$("#ddlModel").select2();
            //$("#ddlVehicleSeries").select2();
            $("#ddlCheckListType").focus();
        });
        function getLoginDetails() {
            Focus8WAPI.getGlobalValue("getLoginDetailsCallback", "", 1);
        }
        function getLoginDetailsCallback(response) {
            try {
                console.log("response", response);
                companyId = response.data.CompanyId;
                sessionId = response.data.SessionId;
                LoginId = response.data.LoginId;
            } catch (e) {
                console.log(e)
            }
        }
        $(document).on("click", "#WebGrid #WgBody TR", function () {
            debugger;
            currentRow = $(this).closest("tr");
        });
        $(document).on('click', 'button.deletebtn', function () {
            $(this).closest('tr').remove();
            sortCheckList();
            return false;
        });
        $(document).on('click', 'button.icon-edit', function () {
            currentRow = $(this).closest("tr");
            event.preventDefault();
            var id = currentRow.find("TD").eq(0).html().replace(/&amp;/g, '&').trim();
            var descr = currentRow.find("TD").eq(1).html().replace(/&amp;/g, '&').trim();
            var remarks = currentRow.find("TD").eq(2).html().replace(/&amp;/g, '&').trim();
            $("#modalCheckList").modal();
            $("#lid").val(id);
            $("#txtDescription").val(descr);
            $("#txtRemarks").val(remarks);
            return false;
        });
        function sortCheckList() {
            let para = $("#WgBody tr").length;//Get the number of tr after tbody deletes a row
            for (let i = 0; i < para; i++) { //Loop through
                //The traversed i is given to the serial number of each line
                $('#WgBody').find('tr').eq(i).find('td:first').html(i+1);
            }
        }
        function AddItem() {
            debugger;
            event.preventDefault();
            var id = $('#WebGrid  tr').length
            $("#modalCheckListAdd").modal();
            $("#nlid").val(id);
            $("#ntxtDescription").val("");
            $("#ntxtRemarks").val("");
            $("#ntxtDescription").focus();
        }
        $('#btnAdd').click(function () {
            debugger;
            $("body").css("cursor", "progress");
            if ($("#ntxtDescription").val() <= 0) {
                alert("Description cannot be empty");
                $("#ntxtDescription").focus();
                $("body").css("cursor", "default");
                return;
            }
            var lid = $("#nlid").val();
            var descr = $("#ntxtDescription").val();
            var remark = $("#ntxtRemarks").val();
            var btnEdit = '<button type="button" id="btnEdit" data-toggle="tooltip" title="Edit" class="icon-edit  btn-info btn-xs fa fa-pencil-square-o btnView"><i class="menu-icon glyphicon-edit"></i></button>'
            var btnDelete = '<button type="button" data-toggle="tooltip" title="Delete" class="deletebtn btn-danger fa fa-trash  btn-xs btnDelete"><i class="menu-icon icon-trash"></i></button>'
            var markup = "<tr><td>" + lid + "</td><td>" + descr + "</td><td>" + remark + "</td> <td>" + btnEdit + "</td><td>" + btnDelete + "</td></tr>";
            $("#WebGrid #WgBody").append(markup);
            $('#modalCheckListAdd').modal('hide');
            $("#nlid").val();
            $("#ntxtDescription").val();
            $("#ntxtRemarks").val();
            $("body").css("cursor", "default");
        });
        $('#btnSave').click(function () {
            debugger;
            $("body").css("cursor", "progress");
            if ($("#txtDescription").val() <= 0) {
                alert("Description cannot be empty");
                $("#txtDescription").focus();
                $("body").css("cursor", "default");
                return;
            }
            var lid = $("#lid").val();
            var descr = $("#txtDescription").val();
            var remark= $("#txtRemarks").val();
            var btnEdit = '<button type="button" id="btnEdit" data-toggle="tooltip" title="Edit" class="icon-edit  btn-info btn-xs fa fa-pencil-square-o btnView"><i class="menu-icon glyphicon-edit"></i></button>'
            var btnDelete = '<button type="button" data-toggle="tooltip" title="Delete" class="deletebtn btn-danger fa fa-trash  btn-xs btnDelete"><i class="menu-icon icon-trash"></i></button>'
            var markup = "<tr><td>" + lid + "</td><td>" + descr + "</td><td>" + remark + "</td> <td>" + btnEdit + "</td><td>" + btnDelete + "</td></tr>";
            if (currentRow) {
                $("#WebGrid #WgBody").find($(currentRow)).replaceWith(markup);
                currentRow = null;            }
            else {
                $("#WebGrid #WgBody").append(markup);
            }
            $('#modalCheckList').modal('hide');
            document.body.style.cursor = 'default';
        });
        $('#btnUpdate').click(function () {
            debugger;
            $("body").css("cursor", "progress");
            if ($("#ddlCheckListType").val() <= 0) {
                alert("Check List Type cannot be empty");
                $("#ddlCheckListType").focus();
                $("body").css("cursor", "default");
                return;
            }
            if ($("#ddlBrand").val() <= 0) {
                alert("Brand cannot be empty");
                $("#ddlBrand").focus();
                $("body").css("cursor", "default");
                return;
            }
            if ($("#ddlModel").val() <= 0) {
                alert("Model cannot be empty");
                $("#ddlModel").focus();
                $("body").css("cursor", "default");
                return;
            }
            if ($("#ddlVehicleSeries").val() <= 0) {
                alert("Vehicle Series cannot be empty");
                $("#ddlVehicleSeries").focus();
                $("body").css("cursor", "default");
                return;
            }
            var checkLists = new Array();
            var i = 1;
            var rowCount = $('#WebGrid  tr').length - 1;
            if (rowCount > 0) {
                $("#WebGrid #WgBody TR").each(function () {
                    var row = $(this);
                    var checkList = {};
                    checkList.iHeaderId = $("#iHeaderId").val();
                    checkList.sVoucherNo = $("#sVoucherNo").val();
                    checkList.ChecklistName = $("#CheckListName").val();
                    checkList.ChecklistType = $("#ddlCheckListType :selected").text();// $("#ddlCheckListType").text();
                    checkList.VehicleSeries = $("#ddlVehicleSeries :selected").text();//$("#ddlVehicleSeries").text();
                    checkList.ModelId = $("#ddlModel").val();
                    checkList.BrandId = $("#ddlBrand").val();

                    checkList.Description = row.find("TD").eq(1).html().replace(/&amp;/g, '&');
                    if (row.find("TD").eq(2).html().length == 0 || row.find("TD").eq(2).html() == undefined) {
                        checkList.Remarks = "";
                    }
                    else {
                        checkList.Remarks = row.find("TD").eq(2).html().replace(/&amp;/g, '&');
                    }
                    checkList.iDate = $("#iDate").val();;
                    checkList.isNew =1;
                    checkList.Userid = LoginId;
                    checkList.SessionId = sessionId;
                    i += 1;
                    checkLists.push(checkList);
                });

                var fdata = { checkLists: checkLists };

                $.ajax({
                    url: "@Url.Action("PostCheckList", "Master")",
                    //url: "/Master/PostCheckList",
                    method: "POST",
                    data: fdata,
                    dataType: "json",
                    success: function (r) {
                        alert(r);
                        $("body").css("cursor", "default");
                        if (r == "Check List Saved") {
                            location.href = '@Url.Action("CheckListIndex", "Master") ';
                        }
                    },
                    error: function () {
                        alert("Error in create check list...");
                        $("body").css("cursor", "default");
                        return;
                    }
                });

            }
            $("body").css("cursor", "default");
        });

        function loadBrand() {
            debugger;
            var Brand;
            $.ajax({
                url: "@Url.Action("GetBrands", "Master")",
                method: 'GET',
                success: function (response) {
                    Brand = response;
                    var ddlHTML = '<option value="0">--Select--</option>';
                    if (Brand != null && Brand.length != 0) {
                        $(Brand).each(function () {
                            ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';
                        });
                    }
                    $('#ddlBrand').html(ddlHTML);
                }
            });
        }
        function loadModel() {
            debugger;
            var Model;
            $.ajax({
                url: "@Url.Action("GetModels", "Master")",
                method: 'GET',
                success: function (response) {

                    Model = response;
                    var ddlHTML = '<option value="0">--Select--</option>';
                    if (Model != null && Model.length != 0) {

                        $(Model).each(function () {

                            ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';

                        });
                    }
                    $('#ddlModel').html(ddlHTML);

                }
            });
        }
        function loadVehicleSeries() {
            debugger;
            var Model;
            $.ajax({
                url: "@Url.Action("GetVehicleSeries", "Master")",
                method: 'GET',
                success: function (response) {

                    Model = response;
                    var ddlHTML = '<option value="0">--Select--</option>';
                    if (Model != null && Model.length != 0) {

                        $(Model).each(function () {

                            ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';

                        });
                    }
                    $('#ddlVehicleSeries').html(ddlHTML);

                }
            });
        }
        function loadCheckListTypes() {
            debugger;
            var Model;
            $.ajax({
                url: "@Url.Action("GetCheckListTypes", "Master")",
                method: 'GET',
                success: function (response) {

                    Model = response;
                    var ddlHTML = '<option value="0">--Select--</option>';
                    if (Model != null && Model.length != 0) {

                        $(Model).each(function () {

                            ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';

                        });
                    }
                    $('#ddlCheckListType').html(ddlHTML);

                }
            });
        }

        $('#btnCancel').click(function () {
            location.href = '@Url.Action("CheckListIndex", "Master") ';
        });

</script>

