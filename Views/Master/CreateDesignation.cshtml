<script>
    var companyId = 0;
    var sessionId = "";
    var LoginId = $("#userid").val();

    $(document).ready(function () {
        debugger;
        //$("#ddlDesignations").select2();
        //loadDesignations();
        //$('select:not(.normal)').each(function () {
        //    $(this).select2({
        //        dropdownParent: $(this).parent()
        //    });
        //});
        $("#sCode").focus();

    });
    function loadDesignations() {
        debugger;
        var designation;
        $.ajax({
            url: "@Url.Action("GetDesignations", "Master")",
            method: 'GET',
            success: function (response) {
                designation = response;
                var ddlHTML = '<option value="0">--Select--</option>';
                if (designation != null && designation.length != 0) {
                    $(designation).each(function () {
                        ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';
                    });
                }
                $('#ddlDesignations').html(ddlHTML);
            }
        });
    }
    $('#btnCancel').click(function () {
        location.href = '@Url.Action("DesignationIndex", "Master")';
    });
    $('#btnCreate').click(function () {
        debugger;
        var Name = $('#sName').val();
        var Designation = $('#ddlDesignations').val();
        var Code = $('#sCode').val();
        if (Code == null || Code == "") {
            swal({
                title: "",
                text: "Code Cannot Be Empty",
                button: "Close", // Text on button
                type: "warning", //built in icons: success, warning, error, info
                timer: 10000, //timeOut for auto-close
                buttons: {
                    confirm: {
                        text: "OK",
                        value: true,
                        visible: true,
                        className: "",
                        closeModal: true
                    }
                }
            });
            $("#sCode").focus();
        }
        else if (Name == null || Name == "") {
            swal({
                title: "",
                text: "Name Cannot Be Empty",
                button: "Close", // Text on button
                type: "warning", //built in icons: success, warning, error, info
                timer: 10000, //timeOut for auto-close
                buttons: {
                    confirm: {
                        text: "OK",
                        value: true,
                        visible: true,
                        className: "",
                        closeModal: true
                    }
                }
            });
            $("#sName").focus();
        }
        else {
            var fdata = { sCode: Code, sName: Name, designation: Designation, UserId: LoginId };

            $.ajax({
                method: "POST",
                url: "@Url.Action("CreateDesignation", "Master")",
                data: fdata,
                dataType: "json",
                success: function (r) {
                    if (r != null && r != "") {

                        swal({
                            title: "",
                            text: r,
                            button: "Close", // Text on button
                            type: "warning", //built in icons: success, warning, error, info
                            timer: 10000, //timeOut for auto-close
                            buttons: {
                                confirm: {
                                    text: "OK",
                                    value: true,
                                    visible: true,
                                    className: "",
                                    closeModal: true
                                }
                            }
                        });
                        $("#sCode").focus();
                        $("#sCode").select();
                        if (r == "Invalid Session")
                            location.href = '@Url.Action("Logout", "Login")';
                    }
                    else
                        location.href = '@Url.Action("DesignationIndex", "Master")';
                },
                error: function () {
                    swal({
                        title: "",
                        text: "Error in create...",
                        button: "Close", // Text on button
                        type: "warning",//built in icons: success, warning, error, info
                        timer: 10000, //timeOut for auto-close
                        buttons: {
                            confirm: {
                                text: "OK",
                                value: true,
                                visible: true,
                                className: "",
                                closeModal: true
                            }
                        }
                    });
                    return;
                }
            });
        }
    });
    //$(".imgAdd").click(function(){
    //    $(this).closest(".row").find('.imgAdd').before('<div class="col-sm-2 imgUp"><div class="imagePreview"></div><label class="btn btn-primary">Upload<input type="file" class="uploadFile img" value="Upload Photo" style="width:0px;height:0px;overflow:hidden;"></label><i class="fa fa-times del"></i></div>');
    //});
    //$(document).on("click", "i.del" , function() {
    // $(this).parent().remove();
    //});
    $(function () {
        $(document).on("change", ".uploadFile", function () {
            var uploadFile = $(this);
            var files = !!this.files ? this.files : [];
            if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

            if (/^image/.test(files[0].type)) { // only image file
                var reader = new FileReader(); // instance of the FileReader
                reader.readAsDataURL(files[0]); // read the local file

                reader.onloadend = function () { // set image data as background of div
                    //alert(uploadFile.closest(".upimage").find('.imagePreview').length);
                    uploadFile.closest(".imgUp").find('.imagePreview').css("background-image", "url(" + this.result + ")");
                }
            }

        });
    });
</script>

