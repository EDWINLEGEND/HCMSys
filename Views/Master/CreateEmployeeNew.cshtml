    function isNumeric(n) {
        return !isNaN(parseFloat(n)) && isFinite(n);
    }
    function checkNumeric() {
        debugger; 
        $("#tblLeave > TBODY > tr").each(function () {
            var t1 = $(this).find('td').eq(2).html().replace(/&amp;/g, '&').trim();
            if (!isNumeric(t1))
                $(this).find('td').eq(2).html("0.00");
            var t2 = $(this).find('td').eq(3).html().replace(/&amp;/g, '&').trim();
            if (!isNumeric(t2))
                $(this).find('td').eq(3).html("0.00");
            // $($columns[col]).append("0.000");
        });
        
    }
    
    function totalTables() {
        debugger;
 
        var totalAllowance = 0; var totalDeduction = 0; var gross = 0;

        $("#tblAllowance > TBODY > tr").each(function () {
            var t1 = $(this).find('td').eq(2).html().replace(/&amp;/g, '&').trim();
            if( isNumeric(t1))
                totalAllowance += (parseFloat(t1));
            else
                $(this).find('td').eq(2).html("0.000");
            // $($columns[col]).append("0.000");
        });
        $("#tblDeduction > TBODY > tr").each(function () {
            var t2 = $(this).find('td').eq(2).html().replace(/&amp;/g, '&').trim();
            if (isNumeric(t2))
                totalDeduction += (parseFloat(t2));
            else
                $(this).find('td').eq(2).html("0.000");
        });
        gross = (parseFloat(totalAllowance) - parseFloat(totalDeduction)).toFixed(3);
        $('#GrossSalary').val(gross)
    }
 
