    function saveData() {
        var flg = 0;
        $('#loading').fadeIn();
        var employee = {};var employeeDoc = new Array(); var employeeImg = {}; var employeeLeave = {};
        var employeePersonal = {};var employeeOffical = {};var employeeElement = new Array(); 
        var sCode = $("#sCode").val();
        if (sCode == null || sCode == "" || sCode == 0) {
            alertify.log("Code cannot be blank", "error", 5000);
            $("#sCode").focus();
            $('#loading').fadeOut();
            return false;
        }
        var sName = $("#sName").val();
        if (sName == null || sName == "" || sName == 0) {
            alertify.log("Name cannot be blank", "error", 5000);
            $("#sName").focus();
            $('#loading').fadeOut();
            return false;
        }
        if ($("#DateofRevision").val() < $("#DateofJoin").val()) {
            alertify.log("Date of revision cannot be less than date of join", "error", 5000);
            $("#DateofRevision").focus();
            $('#loading').fadeOut();
            return false;
        }
        if ($("#DateofApplicable").val() < $("#DateofRevision").val()) {
            alertify.log("Effective date cannot be less than date of revision", "error", 5000);
            $("#DateofApplicable").focus();
            $('#loading').fadeOut();
            return false;
        }

        var iCategory = $("#ddlCategory").val();
        if (iCategory == null || iCategory == "" || iCategory == 0) {
            alertify.log("Category cannot be blank", "error", 5000);
            $("#ddlCategory").focus();
            $('#loading').fadeOut();
            return false;
        }
        var iDesignation = $("#ddlDesignation").val();
        var iEmployeeStatus = $("#ddlEmployeeStatus").val();
 
        var rowCount = $('#tblAllowance  tr').length - 1;

        if (rowCount >= 0) {
            $("#tblAllowance #allowanceBody TR").each(function () {
                var row = $(this);
                var element = {};
                element.iType = 1;
                element.iCategory = iCategory;
                element.iMasterId = row.find("td").eq(0).html();
                element.dAmount = row.find("td").eq(2).html();
                employeeElement.push(element);
                flg++;
            });
        }
        var rowCount = $('#tblDeduction  tr').length - 1;

        if (rowCount >= 0) {
            $("#tblDeduction #deductionBody TR").each(function () {
                var row = $(this);
                var element = {};
                element.iType = 2;
                element.iCategory = iCategory;
                element.iMasterId = row.find("td").eq(0).html();
                element.dAmount = row.find("td").eq(2).html();
                employeeElement.push(element);
                flg++;
            });
        }

        rowCount = $('#tblLeave  tr').length - 1;

        if (rowCount >= 0) {
            $("#tblLeave #leaveBody TR").each(function () {
                var row = $(this);
                var element = {};
                element.iType = 4;
                element.iCategory = iCategory;
                element.iMasterId = row.find("td").eq(0).html();
                element.dAmount = row.find("td").eq(2).html();
                employeeElement.push(element);
                flg++;
            });
        }
 
        rowCount = $('#tblDocuments  tr').length - 1;

        if (rowCount >= 0) {
            $("#tblDocuments #docBody TR").each(function () {
                var row = $(this);
                var doc = {};
                doc.iType = 4;
                doc.iCategory = iCategory;
                doc.iMasterId = row.find("td").eq(0).html();
