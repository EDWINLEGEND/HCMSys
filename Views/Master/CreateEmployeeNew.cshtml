        employee.RevisionDate = $("#DateofRevision").val(); employee.EffectiveDate = $("#DateofApplicable").val(); employee.JoiningDate = $("#DateofJoin").val();
        employee.iCreatedBy = LoginId;

        employeeOffical.iProject=$("#ddlProject").val();employeeOffical.iPaymentType=$("#ddlPaymentType").val();employeeOffical.iLocation=$("#ddlLocation").val();
        employeeOffical.iDesignation=$("#ddlDesignation").val();employeeOffical.iDepartment=$("#ddlDepartment").val();employeeOffical.dDateOfTermination=$("#DOT").val();
