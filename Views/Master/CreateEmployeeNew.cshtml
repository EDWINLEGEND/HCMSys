                                "<td style='border: 1px thin grey; border - collapse: collapse; '>" + sName + "</td>" +
                                "<td style='border: 1px thin grey; border - collapse: collapse; ' contenteditable='true' oninput='totalTables();' onfocusout = 'totalTables()'>0.000</td>" +
                                "</tr>";
                            $("#tblDeduction #deductionBody").append(markup);
                        }
                        else if (this.iType == 4) {
                            var iMasterId = this.iMasterId;
                            var sName = this.sName;
                            var markup = "<tr  style='border: 1px thin grey; border - collapse: collapse; '>" +
                                "<td style='border: 1px thin grey; border - collapse: collapse;display:none '>" + iMasterId + "</td>" +
                                "<td style='border: 1px thin grey; border - collapse: collapse; '>" + sName + "</td>" +
                                "<td style='border: 1px thin grey; border - collapse: collapse; ' contenteditable='true' oninput='checkNumeric();'>0.00</td>" +
                                "</tr>";
                            $("#tblLeave #leaveBody").append(markup);
                        }


                    });
                }

            },
            error: function () {
                alertify.log("Error in getting the data...", "error", 5000);
            },
            complete: function () {
                $('#loading').fadeOut();
                return;
            }

        });
