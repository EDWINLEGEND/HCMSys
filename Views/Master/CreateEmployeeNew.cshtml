        employeePersonal.sSpouseName=$("#SpouseName").val();employeePersonal.iNoofDependant=$("#NoofDependant").val();employeePersonal.iReportingTo=$("#ddlReportingTo").val();

        employeeImg.Photo=$('#imgPhoto').attr('src').split(',')[1];

