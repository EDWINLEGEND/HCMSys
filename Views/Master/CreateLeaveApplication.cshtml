<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .action-btns .fa-edit { color: #4e73df; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-text i { color: #4e73df; }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    
    .summary-panel {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border-radius: 0.35rem;
        padding: 12px 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .summary-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: bold;
        opacity: 0.9;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .summary-val {
        font-size: 1.15rem;
        font-weight: 800;
    }
    
    .number-align {
        text-align: right;
    }
    input[type="text"], select, textarea {
        text-align: left;
    }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }

    .leave-badge {
        display: inline-block;
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text" id="page-header-title">
                    <i class="fas fa-file-signature fa-sm"></i> Create Leave Application
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("LeaveApplicationIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm mr-2">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btn-save-leave" onclick="saveLeaveApplication()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="leaveForm" autocomplete="off">
        <input type="hidden" id="hdr-header-id" value="0" />

        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments / Reason</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter reason or comments for leave application..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted" id="attachment-note">Upload medical certificate or request document.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- LEAVE APPLICATION DETAILS CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom bg-info">
                <i class="fas fa-calendar-check mr-2"></i>Leave Selection & Details
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Leave Type <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-leavetype" required>
                            <option value="">Select Leave Type...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Payment Type <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-paymenttype" required>
                            <option value="0">In Payroll</option>
                            <option value="1">Settlement</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Half Day <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-halfday" required>
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">From Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control calc-trigger datepicker" id="dtl-fromdate" required />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">To Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control calc-trigger datepicker" id="dtl-todate" required />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Total Days</label>
                        <input type="number" class="form-control number-align" id="dtl-duration" readonly />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Weekly Off</label>
                        <input type="number" class="form-control calc-trigger number-align" id="dtl-weeklyoff" value="0" min="0" />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Holiday</label>
                        <input type="number" class="form-control calc-trigger number-align" id="dtl-publicholiday" value="0" min="0" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Days to Apply (Used Now) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control font-weight-bold text-primary number-align" id="dtl-noofleaves" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Contact No</label>
                        <input type="text" class="form-control" id="dtl-contact" placeholder="Phone during leave period" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Substitute Employee</label>
                        <select class="form-control" id="dtl-substitute">
                            <option value="">Select Substitute...</option>
                        </select>
                    </div>

                    <div class="col-md-12 text-right mt-2">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add Leave to Grid
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SUMMARY PANEL -->
        <div class="summary-panel mb-4">
            <div class="row text-center align-items-center">
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Eligible</div>
                    <div class="summary-val" id="sum-eligible">0.0</div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Approved</div>
                    <div class="summary-val" id="sum-approved">0.0</div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Pending</div>
                    <div class="summary-val" id="sum-unapproved">0.0</div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Available</div>
                    <div class="summary-val text-warning font-weight-bold" id="sum-available">0.0</div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Used Now</div>
                    <div class="summary-val" id="sum-usednow">0.0</div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-3 mb-md-0">
                    <div class="summary-label">Lvs Balance</div>
                    <div class="summary-val text-success font-weight-bold" id="sum-balance">0.0</div>
                </div>
            </div>
        </div>
    </form>

    <!-- DETAILED USER GRID -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary">
            <i class="fas fa-list mr-2"></i>Leaves Detailed
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Leave Type</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th class="num-col" style="width:100px;">Duration</th>
                            <th>Contact No</th>
                            <th>Substitute Employee</th>
                            <th class="num-col">Eligible</th>
                            <th class="num-col">Approved</th>
                            <th class="num-col">Pending</th>
                            <th class="num-col">Available</th>
                            <th class="num-col">Used Now</th>
                            <th class="num-col">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="13" class="text-center text-muted py-3">No leaves added yet. Select options above and click "Add Leave to Grid".</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SYSTEM GRID (MONTHLY BREAKDOWN) -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-dark">
            <i class="fas fa-calendar-week mr-2"></i>Monthly Breakdown (System Grid)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="system-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th>Leave Type</th>
                            <th>Month</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th class="num-col" style="width:120px;">Days in Month</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-sys-row"><td colspan="5" class="text-center text-muted py-3">No breakdown available.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    var employeesData = [];
    var currentEmployeeLeaves = [];
    var stagedLeaves = [];
    var stagedSystemLeaves = [];
    var editHeaderId = 0;
    var isEditMode = false;

    $(document).ready(function() {
        var urlParams = new URLSearchParams(window.location.search);
        var paramId = urlParams.get('id') || '@ViewBag.EditId';
        editHeaderId = parseInt(paramId) || 0;
        isEditMode = editHeaderId > 0;

        if (isEditMode) {
            $('#page-header-title').html('<i class="fas fa-edit fa-sm text-primary mr-2"></i> Edit Leave Application <span class="badge badge-primary font-weight-bold ml-2">Edit Mode</span>');
            $('#btn-save-leave').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Leave Application');
            $('#hdr-header-id').val(editHeaderId);
        }

        initHeader();

        // Load Employees master and existing transactions in parallel
        $.when(
            $.getJSON('/Master/GetApiEmployees'),
            $.getJSON('/Master/GetApiLeaveTransactions')
        ).done(function(empRes, txRes) {
            var empArr = empRes[0] || empRes;
            employeesData = Array.isArray(empArr) ? (Array.isArray(empArr[0]) ? empArr[0] : empArr) : [];
            
            var allTxs = txRes[0] || txRes;
            var txList = Array.isArray(allTxs) ? allTxs : (allTxs && allTxs.data ? allTxs.data : []);

            populateEmployeeDropdown();
            $('select.form-control').select2({ width: '100%' });

            if (isEditMode) {
                loadLeaveTransactionForEdit(editHeaderId, txList);
            }
        }).fail(function() {
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load employee masters.', 'error', 5000);
            }
        });

        // Event listeners
        $('#hdr-employee').change(onEmployeeChange);
        $('#dtl-leavetype').change(onLeaveTypeChange);
        $('.calc-trigger').on('change input', calculateLeaves);

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today",
            onChange: function() {
                calculateLeaves();
            }
        });
    });

    function initHeader() {
        if (isEditMode) return;

        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var dd = String(d.getDate()).padStart(2, '0');
        var yyyy = d.getFullYear();
        var todayStr = dd + '-' + mmm + '-' + yyyy;

        $('#hdr-date').val(todayStr);
        $('#hdr-postdate').val(todayStr);
        $('#dtl-fromdate').val(todayStr);
        $('#dtl-todate').val(todayStr);

        $.getJSON('/Master/GetApiLeaveTransactions').done(function(txs) {
            var rawList = Array.isArray(txs) ? txs : (txs && txs.data ? txs.data : []);
            var maxNum = 0;
            rawList.forEach(function(item) {
                var dNo = item.sDocNo || item.docNo || '';
                var match = dNo.match(/\d+/);
                if (match) {
                    var n = parseInt(match[0], 10);
                    if (!isNaN(n) && n > maxNum) maxNum = n;
                }
            });
            var nextNum = Math.max(maxNum, rawList.length) + 1;
            $('#hdr-docno').val('LVS' + String(nextNum).padStart(6, '0'));
        }).fail(function() {
            $('#hdr-docno').val('LVS000001');
        });
    }

    function populateEmployeeDropdown() {
        var empSelect = $('#hdr-employee');
        empSelect.empty().append('<option value="">Select Employee...</option>');

        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.iMasterId || emp.id || '';
                var empCode = emp.sCode || emp.code || '';
                var empName = emp.sName || emp.name || '';
                empSelect.append(`<option value="${empId}" data-code="${empCode}" data-name="${empName}">${empCode} - ${empName}</option>`);
            });
        }
        updateSubstituteDropdown('');
    }

    function updateSubstituteDropdown(selectedEmpVal) {
        var subSelect = $('#dtl-substitute');
        var currentSubVal = subSelect.val();
        subSelect.empty().append('<option value="">Select Substitute...</option>');

        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.iMasterId || emp.id || '';
                var empCode = emp.sCode || emp.code || '';
                var empName = emp.sName || emp.name || '';
                // Rule: Prevent selecting applying employee as their own substitute
                if (selectedEmpVal && String(empId) === String(selectedEmpVal)) {
                    return;
                }
                subSelect.append(`<option value="${empId}" data-code="${empCode}" data-name="${empName}">${empCode} - ${empName}</option>`);
            });
        }
        if (currentSubVal && String(currentSubVal) !== String(selectedEmpVal)) {
            subSelect.val(currentSubVal);
        }
    }

    function onEmployeeChange() {
        var empVal = $(this).val();
        updateSubstituteDropdown(empVal);

        if (!empVal) {
            $('#hdr-designation, #hdr-department, #hdr-manager, #dtl-contact').val('');
            $('#dtl-leavetype').empty().append('<option value="">Select Leave Type...</option>');
            $('#sum-eligible, #sum-approved, #sum-unapproved, #sum-available, #sum-usednow, #sum-balance').text('0.0');
            currentEmployeeLeaves = [];
            return;
        }

        var emp = employeesData.find(e => e.id == empVal || e.iMasterId == empVal || e.code == empVal || e.sCode == empVal);
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || '');
        }

        // Fetch employee's real leave balances from live API
        $.getJSON('/Master/GetApiEmployeeLeaves?id=' + empVal).done(function(leaves) {
            currentEmployeeLeaves = Array.isArray(leaves) ? leaves : [];
            var ltSelect = $('#dtl-leavetype');
            ltSelect.empty().append('<option value="">Select Leave Type...</option>');

            currentEmployeeLeaves.forEach(function(lt) {
                var ltId = lt.iLeaveTypeId;
                var ltName = lt.sLeaveName;
                ltSelect.append(`<option value="${ltId}" data-name="${ltName}">${ltName}</option>`);
            });

            if (ltSelect.find('option').length > 1) {
                ltSelect.val(ltSelect.find('option:eq(1)').val()).trigger('change');
            }
        }).fail(function() {
            alertify.log('Failed to fetch leave balances for employee.', 'error', 4000);
        });
    }

    function onLeaveTypeChange() {
        var ltId = parseInt($(this).val()) || 0;
        if (!ltId || currentEmployeeLeaves.length === 0) {
            $('#sum-eligible, #sum-approved, #sum-unapproved, #sum-available').text('0.0');
            calculateLeaves();
            return;
        }

        var bal = currentEmployeeLeaves.find(l => l.iLeaveTypeId === ltId);
        if (bal) {
            var eligible = parseFloat(bal.openingLeaves || 0);
            var approved = parseFloat(bal.leavesApproved || 0);
            var pending = parseFloat(bal.leavesPending || 0);
            
            // Rule: Available leaves cannot be negative
            var rawAvailable = (bal.leaveBalance !== undefined && bal.leaveBalance !== null) 
                ? parseFloat(bal.leaveBalance) 
                : (eligible - approved - pending);
            var available = Math.max(0, rawAvailable);

            $('#sum-eligible').text(eligible.toFixed(1));
            $('#sum-approved').text(approved.toFixed(1));
            $('#sum-unapproved').text(pending.toFixed(1));
            $('#sum-available').text(available.toFixed(1));
        } else {
            $('#sum-eligible, #sum-approved, #sum-unapproved, #sum-available').text('0.0');
        }

        calculateLeaves();
    }

    function parseDateObj(dStr) {
        if (!dStr) return new Date();
        if (dStr instanceof Date) return dStr;
        dStr = String(dStr).trim();
        if (dStr.includes('T')) dStr = dStr.split('T')[0];

        var months = {
            'jan':0,'feb':1,'mar':2,'apr':3,'may':4,'jun':5,'jul':6,'aug':7,'sep':8,'oct':9,'nov':10,'dec':11,
            '01':0,'02':1,'03':2,'04':3,'05':4,'06':5,'07':6,'08':7,'09':8,'10':9,'11':10,'12':11
        };

        if (dStr.includes('-')) {
            var p = dStr.split('-');
            if (p.length === 3) {
                if (p[0].length === 4) {
                    return new Date(parseInt(p[0]), parseInt(p[1]) - 1, parseInt(p[2]));
                } else if (p[2].length === 4) {
                    var mKey = p[1].toLowerCase();
                    var m = months[mKey] !== undefined ? months[mKey] : (parseInt(p[1]) - 1);
                    return new Date(parseInt(p[2]), m, parseInt(p[0]));
                }
            }
        }
        var parsed = new Date(dStr);
        return isNaN(parsed.getTime()) ? new Date() : parsed;
    }

    function calculateLeaves() {
        var fromStr = $('#dtl-fromdate').val();
        var toStr = $('#dtl-todate').val();
        var duration = 0;

        if (fromStr && toStr) {
            var f = parseDateObj(fromStr);
            var t = parseDateObj(toStr);

            if (t >= f) {
                var diffTime = Math.abs(t - f);
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                duration = diffDays + 1;
            }
        }
        $('#dtl-duration').val(duration);

        var weeklyOff = parseFloat($('#dtl-weeklyoff').val()) || 0;
        var publicHoliday = parseFloat($('#dtl-publicholiday').val()) || 0;
        var noOfLeaves = duration - weeklyOff - publicHoliday;

        if ($('#dtl-halfday').val() === 'Yes') {
            noOfLeaves -= 0.5;
        }
        if (noOfLeaves < 0) noOfLeaves = 0;

        $('#dtl-noofleaves').val(noOfLeaves);

        var available = parseFloat($('#sum-available').text()) || 0;
        var finalBalance = available - noOfLeaves;

        $('#sum-usednow').text(noOfLeaves.toFixed(1));
        
        // Update balance visual styling
        var $balEl = $('#sum-balance');
        $balEl.text(finalBalance.toFixed(1));
        if (finalBalance < 0) {
            $balEl.removeClass('text-success').addClass('text-danger');
        } else {
            $balEl.removeClass('text-danger').addClass('text-success');
        }
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            if (file.size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function addToGrid() {
        var empVal = $('#hdr-employee').val();
        var leaveTypeId = parseInt($('#dtl-leavetype').val()) || 0;
        var fromDate = $('#dtl-fromdate').val();
        var toDate = $('#dtl-todate').val();
        var usedNow = parseFloat($('#dtl-noofleaves').val()) || 0;
        var available = parseFloat($('#sum-available').text()) || 0;

        if (!empVal) {
            alertify.log('Please select an employee.', 'error', 5000);
            return;
        }
        if (!leaveTypeId) {
            alertify.log('Please select a leave type.', 'error', 5000);
            return;
        }
        if (!fromDate || !toDate) {
            alertify.log('Please select valid From Date and To Date.', 'error', 5000);
            return;
        }

        // Rule: Used now / duration must be > 0
        if (usedNow <= 0) {
            alertify.log('Days to apply (Used Now) must be greater than 0. Please check dates and off days.', 'error', 5000);
            return;
        }

        var f = parseDateObj(fromDate);
        var t = parseDateObj(toDate);
        if (f > t) {
            alertify.log('To Date cannot be earlier than From Date.', 'error', 5000);
            return;
        }

        // Rule: Negative leaves available cannot come & cannot exceed available balance
        if (available <= 0) {
            alertify.log('No leaves available for the selected leave type (Available: 0.0). Application cannot be added.', 'error', 5000);
            return;
        }

        if (usedNow > available) {
            alertify.log('Requested leave duration (' + usedNow.toFixed(1) + ' days) exceeds available leave balance (' + available.toFixed(1) + ' days).', 'error', 5000);
            return;
        }

        // Rule: Substitute employee cannot be the applicant
        var subVal = $('#dtl-substitute').val();
        if (subVal && String(subVal) === String(empVal)) {
            alertify.log('An employee cannot be selected as their own substitute.', 'error', 5000);
            return;
        }

        // Prevent overlapping dates in grid
        var hasOverlap = stagedLeaves.some(function(item) {
            var sF = parseDateObj(item.fromDate);
            var sT = parseDateObj(item.toDate);
            return (f <= sT && t >= sF);
        });

        if (hasOverlap) {
            alertify.log('Selected date range overlaps with an already added leave.', 'error', 5000);
            return;
        }

        var ltOpt = $('#dtl-leavetype option:selected');
        var leaveTypeName = ltOpt.data('name') || ltOpt.text();
        var contactNo = $('#dtl-contact').val() || '';
        var subOpt = $('#dtl-substitute option:selected');
        var subName = subOpt.val() ? subOpt.text() : '-';

        var eligible = parseFloat($('#sum-eligible').text()) || 0;
        var approved = parseFloat($('#sum-approved').text()) || 0;
        var pending = parseFloat($('#sum-unapproved').text()) || 0;
        var balance = available - usedNow;

        var newItem = {
            stagedId: 'id_' + new Date().getTime(),
            leaveTypeId: leaveTypeId,
            leaveTypeName: leaveTypeName,
            fromDate: fromDate,
            toDate: toDate,
            duration: usedNow,
            contactNo: contactNo,
            substitute: subName,
            eligible: eligible,
            approved: approved,
            pending: pending,
            available: available,
            usedNow: usedNow,
            balance: balance,
            remarks: $('#hdr-comments').val() || leaveTypeName
        };

        stagedLeaves.push(newItem);

        // Compute Monthly breakdown for System Grid
        var cur = new Date(f);
        var monthsNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

        while (cur <= t) {
            var mIndex = cur.getMonth();
            var yNum = cur.getFullYear();
            var monthLabel = monthsNames[mIndex] + ' ' + yNum;
            var lastDayOfMonth = new Date(yNum, mIndex + 1, 0);
            var endChunk = (t < lastDayOfMonth) ? new Date(t) : lastDayOfMonth;
            var chunkDiff = Math.ceil(Math.abs(endChunk - cur) / (1000 * 60 * 60 * 24)) + 1;

            stagedSystemLeaves.push({
                stagedId: newItem.stagedId,
                leaveTypeName: leaveTypeName,
                monthName: monthLabel,
                fromDate: window.formatDateDisplay(cur),
                toDate: window.formatDateDisplay(endChunk),
                duration: chunkDiff
            });

            cur = new Date(yNum, mIndex + 1, 1);
        }

        renderGrids();
        alertify.log('Leave added to list.', 'success', 3000);
    }

    function deleteStagedLeave(stagedId) {
        stagedLeaves = stagedLeaves.filter(function(l) { return l.stagedId !== stagedId; });
        stagedSystemLeaves = stagedSystemLeaves.filter(function(s) { return s.stagedId !== stagedId; });
        renderGrids();
    }

    function renderGrids() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();

        if (stagedLeaves.length === 0) {
            uTbody.append('<tr id="empty-row"><td colspan="13" class="text-center text-muted py-3">No leaves added yet. Select options above and click "Add Leave to Grid".</td></tr>');
        } else {
            stagedLeaves.forEach(function(l) {
                var tr = `<tr>
                    <td class="action-btns" style="text-align:center;">
                        <a href="javascript:void(0)" class="remove-item-btn" title="Delete" onclick="deleteStagedLeave('${l.stagedId}')"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                    </td>
                    <td><span class="leave-badge"><i class="fas fa-tag mr-1"></i>${l.leaveTypeName}</span></td>
                    <td>${l.fromDate}</td>
                    <td>${l.toDate}</td>
                    <td class="num-col font-weight-bold text-primary">${l.duration.toFixed(1)}</td>
                    <td>${l.contactNo || '-'}</td>
                    <td>${l.substitute || '-'}</td>
                    <td class="num-col">${l.eligible.toFixed(1)}</td>
                    <td class="num-col">${l.approved.toFixed(1)}</td>
                    <td class="num-col">${l.pending.toFixed(1)}</td>
                    <td class="num-col text-warning font-weight-bold">${l.available.toFixed(1)}</td>
                    <td class="num-col font-weight-bold">${l.usedNow.toFixed(1)}</td>
                    <td class="num-col text-success font-weight-bold">${l.balance.toFixed(1)}</td>
                </tr>`;
                uTbody.append(tr);
            });
        }

        var sTbody = $('#system-grid-table tbody');
        sTbody.empty();

        if (stagedSystemLeaves.length === 0) {
            sTbody.append('<tr id="empty-sys-row"><td colspan="5" class="text-center text-muted py-3">No breakdown available.</td></tr>');
        } else {
            stagedSystemLeaves.forEach(function(s) {
                var tr = `<tr>
                    <td><span class="leave-badge">${s.leaveTypeName}</span></td>
                    <td><strong>${s.monthName}</strong></td>
                    <td>${s.fromDate}</td>
                    <td>${s.toDate}</td>
                    <td class="num-col font-weight-bold text-dark">${s.duration}</td>
                </tr>`;
                sTbody.append(tr);
            });
        }
    }

    function loadLeaveTransactionForEdit(headerId, cachedList) {
        function applyData(tx) {
            if (!tx) return;
            $('#hdr-header-id').val(tx.iHeaderId || headerId);
            $('#hdr-docno').val(tx.sDocNo || tx.docNo || '');
            if (tx.dDocDate) $('#hdr-date').val(window.formatDateDisplay(tx.dDocDate));
            if (tx.dPostDate) $('#hdr-postdate').val(window.formatDateDisplay(tx.dPostDate));
            if (tx.sComments) $('#hdr-comments').val(tx.sComments);

            var leavesList = tx.leaves || tx.Leaves || [];
            var firstEmpId = leavesList[0]?.iEmployeeId || leavesList[0]?.employeeId || 0;

            if (firstEmpId > 0) {
                $('#hdr-employee').val(firstEmpId).trigger('change');
            }

            var fileObj = tx.leaveFile || tx.LeaveFile || tx.attachment || tx.Attachment;
            if (fileObj && fileObj.sAttachmentFilePath) {
                $('#attachment-note').html(`Current Attachment: <a href="javascript:void(0)" class="text-primary font-weight-bold" onclick="window.openDocPreview('${fileObj.sAttachmentFileName || 'Attachment'}', '${fileObj.sAttachmentFilePath}')"><i class="fas fa-paperclip mr-1"></i>${fileObj.sAttachmentFileName || 'View Attached File'}</a> (Upload new file to replace)`);
            }

            stagedLeaves = [];
            stagedSystemLeaves = [];

            leavesList.forEach(function(l) {
                var lTypeId = l.iLeaveTypeId || 7;
                var lTypeName = l.sLeaveTypeName || l.leaveTypeName || 'Leave Application';
                var fDur = parseFloat(l.fDuration || 1);
                var fDate = window.formatDateDisplay(tx.dDocDate);
                var tDate = window.formatDateDisplay(tx.dPostDate || tx.dDocDate);

                stagedLeaves.push({
                    stagedId: 'id_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1000),
                    leaveTypeId: lTypeId,
                    leaveTypeName: lTypeName,
                    fromDate: fDate,
                    toDate: tDate,
                    duration: fDur,
                    contactNo: '-',
                    substitute: '-',
                    eligible: 30,
                    approved: fDur,
                    pending: 0,
                    available: Math.max(0, 30 - fDur),
                    usedNow: fDur,
                    balance: Math.max(0, 30 - fDur),
                    remarks: l.sRemarks || tx.sComments || lTypeName
                });
            });

            renderGrids();
        }

        $.getJSON('/Master/GetApiLeaveTransactionById?id=' + headerId).done(function(res) {
            var tx = (res && res.data) ? res.data : res;
            if (tx && (tx.iHeaderId || tx.sDocNo)) {
                applyData(tx);
            } else {
                var match = (cachedList || []).find(t => (t.iHeaderId || t.id) == headerId || (t.sDocNo || t.docNo) == headerId);
                applyData(match);
            }
        }).fail(function() {
            var match = (cachedList || []).find(t => (t.iHeaderId || t.id) == headerId || (t.sDocNo || t.docNo) == headerId);
            if (match) applyData(match);
        });
    }

    function saveLeaveApplication() {
        if (stagedLeaves.length === 0) {
            alertify.log('Please add at least one leave to the grid before saving.', 'error', 5000);
            return;
        }

        var empVal = $('#hdr-employee').val();
        if (!empVal) {
            alertify.log('Please select an employee.', 'error', 5000);
            return;
        }

        var docNo = $('#hdr-docno').val();
        var dateStr = $('#hdr-date').val();
        var postDateStr = $('#hdr-postdate').val() || dateStr;

        function parseToYMD(dStr) {
            if(!dStr) return new Date().toISOString().split('T')[0];
            var parts = dStr.split('-');
            if(parts.length === 3) {
                var months = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'};
                var m = months[parts[1]] || '01';
                var d = String(parts[0]).padStart(2, '0');
                var y = parts[2];
                return y + '-' + m + '-' + d;
            }
            return new Date().toISOString().split('T')[0];
        }

        var ymdDate = parseToYMD(dateStr);
        var ymdPostDate = parseToYMD(postDateStr);

        var leavesPayload = stagedLeaves.map(function(sl) {
            return {
                iEmployeeId: parseInt(empVal),
                iLeaveTypeId: sl.leaveTypeId,
                iAdjType: 1,
                fDuration: sl.duration,
                sRemarks: sl.remarks || sl.leaveTypeName
            };
        });

        var formData = new FormData();
        formData.append('iHeaderId', isEditMode ? editHeaderId.toString() : '0');
        formData.append('sDocNo', docNo);
        formData.append('dDocDate', ymdDate);
        formData.append('dPostDate', ymdPostDate);
        formData.append('iCompanyId', '1');
        formData.append('iPayYearId', '1');
        formData.append('iTransTypeId', '2'); // TransTypeId 2 for Leave Applications
        formData.append('sComments', $('#hdr-comments').val() || 'Leave application');
        formData.append('Leaves', JSON.stringify(leavesPayload));

        var fileInput = document.getElementById('hdr-attachment');
        if (fileInput && fileInput.files && fileInput.files[0]) {
            formData.append('Attachment', fileInput.files[0]);
        }

        $.ajax({
            url: '/Master/SaveApiLeaveTransaction',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                var isSuccess = res && (res.success === true || res.statusCode === 200);
                if (isSuccess) {
                    var savedDoc = (res.data && typeof res.data === 'string') ? res.data : docNo;
                    var successMsg = isEditMode 
                        ? 'Leave Application (' + savedDoc + ') updated successfully!' 
                        : 'Leave Application (' + savedDoc + ') saved successfully!';

                    sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: successMsg, type: 'success' }));
                    var targetUrl = '@Url.Action("LeaveApplicationIndex", "Master")';
                    if (typeof loadPageContent === 'function') {
                        loadPageContent(targetUrl, true);
                    } else {
                        window.location.href = targetUrl;
                    }
                } else {
                    var errMsg = (res && res.message) ? res.message : 'Error saving Leave Application.';
                    alertify.log(errMsg, 'error', 6000);
                }
            },
            error: function(xhr, status, err) {
                alertify.log('Failed to save Leave Application: ' + (xhr.responseText || err || 'Server error'), 'error', 5000);
            }
        });
    }
</script>
