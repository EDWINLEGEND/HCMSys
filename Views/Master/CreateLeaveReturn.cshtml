    // 1. Triggered when Employee is selected
    function onEmployeeChange() {
        var empId = $('#hdr-employee').val();
        var leaveAppSelect = $('#hdr-leaveapp');
        leaveAppSelect.empty();

        if (!empId) {
            $('#hdr-designation, #hdr-department, #hdr-manager, #hdr-leavestartdate, #hdr-leaveenddate').val('');
            $('#hdr-lateearlydays').val('0');
            $('#late-early-badge').attr('class', 'late-early-display late-early-ontime').text('0 Days');
            $('#orig-leave-card').hide();
            $('#smart-notification-container').hide();
            leaveAppSelect.append('<option value="">Select Employee First...</option>');
            stagedLeaves = [];
            renderUserGrid();
            return;
        }

        var emp = employeesData.find(e => e.id == empId || e.iMasterId == empId);
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '-');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '-');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || '-');
        }

        updateSubstituteDropdown(empId);
        fetchEmployeeBalances(empId);

        // Filter leave applications for this employee
        var empApps = leaveApplicationsData.filter(a => String(a.employeeId) === String(empId));

        if (empApps.length === 0) {
            leaveAppSelect.append('<option value="">No Active Leave Applications Found</option>');
            selectedLeaveApp = null;
            $('#orig-leave-card').hide();
            $('#smart-notification-container').hide();
            return;
        }

        leaveAppSelect.append('<option value="">Select Leave Application...</option>');
        empApps.forEach(function(app) {
            var disp = `${app.docNo} - ${app.leaveTypeName} (${formatDateDisplay(app.startDate)} to ${formatDateDisplay(app.endDate)}, ${app.duration}d)`;
            leaveAppSelect.append(`<option value="${app.id}" data-docno="${app.docNo}">${disp}</option>`);
        });

        // Automatically select if there is only 1 application or select the first
        if (empApps.length >= 1) {
            leaveAppSelect.val(empApps[0].id).trigger('change');
        }
    }

    // 2. Triggered when Leave Application is selected
    function onLeaveAppChange() {
        var appId = $('#hdr-leaveapp').val();
        if (!appId) {
            selectedLeaveApp = null;
            $('#hdr-leavestartdate, #hdr-leaveenddate').val('');
            $('#hdr-lateearlydays').val('0');
            $('#late-early-badge').attr('class', 'late-early-display late-early-ontime').text('0 Days');
            $('#orig-leave-card').hide();
            $('#smart-notification-container').hide();
            stagedLeaves = [];
            renderUserGrid();
            return;
        }

        selectedLeaveApp = leaveApplicationsData.find(a => String(a.id) === String(appId));
        if (!selectedLeaveApp) return;

        var startFmt = formatDateDisplay(selectedLeaveApp.startDate);
        var endFmt = formatDateDisplay(selectedLeaveApp.endDate);

        if (leaveStartDatePicker) {
            leaveStartDatePicker.setDate(startFmt, false);
        } else {
            $('#hdr-leavestartdate').val(startFmt);
        }

        if (leaveEndDatePicker) {
            leaveEndDatePicker.setDate(endFmt, false);
        } else {
            $('#hdr-leaveenddate').val(endFmt);
        }

        // Populate Original Leave Application Summary
        $('#orig-leavetype').text(selectedLeaveApp.leaveTypeName || 'Annual Leave');
        $('#orig-duration').text(selectedLeaveApp.duration + ' Days');
        $('#orig-period').text(startFmt + ' to ' + endFmt);
        $('#orig-remarks').text(selectedLeaveApp.comments || 'N/A');
        $('#orig-leave-card').slideDown(200);

        // Calculate default Return / Rejoining Date (next day after leave end date)
        var endObj = parseDateObj(selectedLeaveApp.endDate);
        var defRejoin = new Date(endObj);
        defRejoin.setDate(defRejoin.getDate() + 1);
        var defRejoinFmt = formatDateStr(defRejoin);
        
        if (rejoiningDatePicker) {
            rejoiningDatePicker.setDate(defRejoinFmt, true);
        } else {
            $('#hdr-rejoiningdate').val(defRejoinFmt);
            recalculateLateEarly();
        }
