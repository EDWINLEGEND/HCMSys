    function initHeaderDocNo() {
        if (isEditMode) return;

        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var dd = String(d.getDate()).padStart(2, '0');
        var yyyy = d.getFullYear();
        var todayStr = dd + '-' + mmm + '-' + yyyy;

        $('#hdr-date').val(todayStr);
        $('#hdr-postdate').val(todayStr);
        $('#dtl-fromdate').val(todayStr);
        $('#dtl-todate').val(todayStr);

        var savedReturns = JSON.parse(localStorage.getItem('savedLeaveReturns') || '[]');
        var maxNum = 0;
        savedReturns.forEach(function(item) {
            var dNo = item.sDocNo || '';
            var match = dNo.match(/\d+/);
            if (match) {
                var n = parseInt(match[0], 10);
                if (!isNaN(n) && n > maxNum) maxNum = n;
            }
        });
        var nextNum = Math.max(maxNum, savedReturns.length) + 1;
        $('#hdr-docno').val('LVR' + String(nextNum).padStart(6, '0'));
    }

