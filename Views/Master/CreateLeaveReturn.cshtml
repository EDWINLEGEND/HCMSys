@{
    ViewData["Title"] = "Create Leave Return";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .action-btns .fa-edit { color: #4e73df; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-text i { color: #4e73df; }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    
    /* BLUE BOX (SUMMARY PANEL) */
    .summary-panel {
        background: linear-gradient(135deg, #3a60d0 0%, #1e3c9c 100%);
        color: white;
        border-radius: 0.45rem;
        padding: 14px 18px;
        box-shadow: 0 4px 12px rgba(30, 60, 156, 0.25);
    }
    .summary-card-inner {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 0.35rem;
        padding: 8px 6px;
        transition: all 0.2s ease;
    }
    .summary-card-inner:hover {
        background: rgba(255, 255, 255, 0.18);
    }
    .summary-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 700;
        opacity: 0.92;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .summary-val {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    
    .number-align {
        text-align: right;
    }
    input[type="text"], select, textarea {
        text-align: left;
    }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }

    .leave-badge {
        display: inline-block;
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .late-early-display {
        font-size: 1.15rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-block;
        min-width: 100px;
        text-align: center;
    }
    .late-early-ontime {
        background-color: #e6f9f0;
        color: #0d8a4f;
        border: 2px solid #28a745;
    }
    .late-early-late {
        background-color: #fdf0ed;
        color: #d92510;
        border: 2px solid #dc3545;
    }
    .late-early-early {
        background-color: #fef8e7;
        color: #b78103;
        border: 2px solid #ffc107;
    }

    .row-selected-edit {
        background-color: #fff3cd !important;
        border-left: 4px solid #ffc107;
    }

    .notification-banner {
        border-radius: 0.45rem;
        padding: 12px 18px;
        font-size: 0.88rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text" id="page-header-title">
                    <i class="fas fa-calendar-check fa-sm"></i> Process Return From Leave
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("LeaveReturnIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm mr-2">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btn-save-return" onclick="saveLeaveReturn()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save Return
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="leaveReturnForm" autocomplete="off">
        <input type="hidden" id="hdr-header-id" value="0" />

        <!-- GENERAL INFORMATION & APPLICATION SELECTOR CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information & Employee Reference
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Doc No & Processing Dates -->
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>

                    <!-- 1. EMPLOYEE SELECTION FIRST -->
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Select Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>

                    <!-- Employee Details (Auto-populated from employee selection) -->
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly placeholder="Auto loaded" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly placeholder="Auto loaded" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly placeholder="Auto loaded" />
                    </div>

                    <!-- 2. LEAVE APPLICATIONS DROPDOWN (Filtered for selected employee) -->
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Leave Application No <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-leaveapp" required>
                            <option value="">Select Employee First...</option>
                        </select>
                    </div>

                    <!-- LEAVE RETURN SPECIFIC DATE CALCULATION FIELDS -->
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Leave Start Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-leavestartdate" placeholder="Leave Start Date" />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label text-primary">Leave End Date <span class="badge badge-primary ml-1">Auto Load Max</span></label>
                        <input type="text" class="form-control font-weight-bold text-primary datepicker" id="hdr-leaveenddate" placeholder="Leave End Date" />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label text-success">Return / Rejoining Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-weight-bold text-success datepicker" id="hdr-rejoiningdate" required />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Late / Early (Days)</label>
                        <div class="d-flex align-items-center">
                            <input type="text" class="form-control font-weight-bold number-align mr-2" id="hdr-lateearlydays" readonly value="0" style="font-size: 1.1rem; width: 100px;" />
                            <div id="late-early-badge-container">
                                <span class="late-early-display late-early-ontime" id="late-early-badge">0 Days</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments / Remarks</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter reason or return comments..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted" id="attachment-note">Upload rejoining note, travel tickets, or supporting document.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- DYNAMIC SMART RULE & NOTIFICATION BANNER -->
        <div id="smart-notification-container" class="mb-4" style="display:none;">
            <!-- Populated dynamically based on Late/Early Days value -->
        </div>

        <!-- ORIGINAL LEAVE APPLICATION REFERENCE DETAILS (READONLY) -->
        <div class="card shadow mb-4" id="orig-leave-card" style="display:none;">
            <div class="card-header card-header-custom bg-secondary d-flex justify-content-between align-items-center">
                <span><i class="fas fa-history mr-2"></i>Original Leave Application Details</span>
                <span class="badge badge-light" id="orig-leave-badge">Application Info</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <small class="text-muted text-uppercase font-weight-bold">Leave Type</small>
                        <div class="font-weight-bold text-dark" id="orig-leavetype">-</div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <small class="text-muted text-uppercase font-weight-bold">Leave Duration</small>
                        <div class="font-weight-bold text-primary" id="orig-duration">0 Days</div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <small class="text-muted text-uppercase font-weight-bold">Original Approved Period</small>
                        <div class="font-weight-bold text-dark" id="orig-period">-</div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <small class="text-muted text-uppercase font-weight-bold">Application Remarks</small>
                        <div class="font-weight-bold text-muted" id="orig-remarks">-</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LEAVE EXTENSION SECTION (ENABLED WHEN LATE / FOR ADJUSTMENTS) -->
        <div class="card shadow mb-4" id="leave-extension-card">
            <div class="card-header card-header-custom bg-info d-flex justify-content-between align-items-center">
                <span><i class="fas fa-calendar-plus mr-2"></i>Leave Extension Details (For Excess / Late Days)</span>
                <span class="badge badge-light" id="extension-status-badge">Required for Late Return</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Leave Type <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-leavetype">
                            <option value="">Select Leave Type...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Payment Type <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-paymenttype">
                            <option value="0">In Payroll</option>
                            <option value="1">Settlement</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Half Day <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-halfday">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Extension From Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control calc-trigger datepicker" id="dtl-fromdate" />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Extension To Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control calc-trigger datepicker" id="dtl-todate" />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Total Days</label>
                        <input type="number" class="form-control number-align" id="dtl-duration" readonly />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Weekly Off</label>
                        <input type="number" class="form-control calc-trigger number-align" id="dtl-weeklyoff" value="0" min="0" />
                    </div>
                    <div class="col-4 col-md-2 mb-3">
                        <label class="form-label">Holiday</label>
                        <input type="number" class="form-control calc-trigger number-align" id="dtl-publicholiday" value="0" min="0" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Days to Apply (Used Now) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control font-weight-bold text-primary number-align" id="dtl-noofleaves" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Contact No</label>
                        <input type="text" class="form-control" id="dtl-contact" placeholder="Contact number" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Substitute Employee</label>
                        <select class="form-control" id="dtl-substitute">
                            <option value="">Select Substitute...</option>
                        </select>
                    </div>

                    <div class="col-md-12 text-right mt-2" id="grid-action-container">
                        <button type="button" class="btn btn-secondary btn-sm shadow-sm mr-2" id="btn-cancel-subleave" style="display:none;" onclick="cancelSubLeaveEdit()">
                            <i class="fas fa-times fa-sm text-white-50 mr-1"></i> Cancel Edit
                        </button>
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btn-add-to-grid" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add Extension to Grid
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SUMMARY PANEL (BLUE BOX) -->
        <div class="summary-panel mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.2);">
                <div class="font-weight-bold" style="font-size: 0.82rem; letter-spacing: 0.05em; text-transform: uppercase;">
                    <i class="fas fa-chart-pie mr-2"></i><span id="summary-header-label">Leave Balance & Overview</span>
                </div>
                <span class="badge badge-light px-2 py-1" id="summary-type-badge" style="font-size: 0.75rem; color: #1e3c9c; font-weight: 700;">No Leave Type Selected</span>
            </div>
            <div class="row text-center align-items-center">
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-award mr-1"></i>Eligible</div>
                        <div class="summary-val" id="sum-eligible">0.0</div>
                    </div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-check-circle mr-1"></i>Approved</div>
                        <div class="summary-val" id="sum-approved">0.0</div>
                    </div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-clock mr-1"></i>Pending</div>
                        <div class="summary-val" id="sum-unapproved">0.0</div>
                    </div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-wallet mr-1 text-warning"></i>Available</div>
                        <div class="summary-val text-warning font-weight-bold" id="sum-available">0.0</div>
                    </div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-calendar-minus mr-1"></i>Used Now</div>
                        <div class="summary-val" id="sum-usednow">0.0</div>
                    </div>
                </div>
                <div class="col-6 col-sm-4 col-md-2 mb-2 mb-md-0">
                    <div class="summary-card-inner">
                        <div class="summary-label"><i class="fas fa-balance-scale mr-1 text-success"></i>Balance</div>
                        <div class="summary-val text-success font-weight-bold" id="sum-balance">0.0</div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- DETAILED EXTENSION LEAVE GRID -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Extension Leaves Detailed (Sub-Leaves Grid)</span>
            <small class="text-white-50">Extension lines applied for late return</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 80px; text-align:center;">Action</th>
                            <th>Leave Type</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th class="num-col" style="width:100px;">Duration (Days)</th>
                            <th>Contact No</th>
                            <th>Substitute Employee</th>
                            <th class="num-col">Eligible</th>
                            <th class="num-col">Approved</th>
                            <th class="num-col">Pending</th>
                            <th class="num-col">Available</th>
                            <th class="num-col">Used Now</th>
                            <th class="num-col">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="13" class="text-center text-muted py-3">No extension leaves added. (Required only when Late/Early Days &lt; 0).</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MONTHLY BREAKDOWN SYSTEM GRID -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-dark">
            <i class="fas fa-calendar-week mr-2"></i>Monthly Breakdown (System Grid)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="system-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th>Leave Type</th>
                            <th>Month</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th class="num-col" style="width:120px;">Days in Month</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-sys-row"><td colspan="5" class="text-center text-muted py-3">No breakdown available.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var employeesData = [];
    var leaveApplicationsData = [];
    var currentEmployeeLeaves = [];
    var stagedLeaves = [];
    var stagedSystemLeaves = [];
    var editHeaderId = 0;
    var isEditMode = false;
    var editingSubLeaveId = null;
    var fromDatePicker = null;
    var toDatePicker = null;
    var rejoiningDatePicker = null;
    var leaveEndDatePicker = null;
    var leaveStartDatePicker = null;
    var selectedLeaveApp = null;

    $(document).ready(function() {
        var urlParams = new URLSearchParams(window.location.search);
        var paramId = urlParams.get('id') || '@ViewBag.EditId';
        editHeaderId = parseInt(paramId) || 0;
        isEditMode = editHeaderId > 0;

        if (isEditMode) {
            $('#page-header-title').html('<i class="fas fa-edit fa-sm text-primary mr-2"></i> Edit Return From Leave <span class="badge badge-primary font-weight-bold ml-2">Edit Mode</span>');
            $('#btn-save-return').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Return');
            $('#hdr-header-id').val(editHeaderId);
        }

        initFlatpickrs();
        initHeaderDocNo();

        // Load Employees & Leave Applications in parallel
        $.when(
            $.getJSON('/Master/GetApiEmployees'),
            $.getJSON('/Master/GetApiLeaveTransactions')
        ).done(function(empRes, txRes) {
            var empArr = empRes[0] || empRes;
            employeesData = Array.isArray(empArr) ? (Array.isArray(empArr[0]) ? empArr[0] : empArr) : [];

            var allTxs = txRes[0] || txRes;
            var rawList = Array.isArray(allTxs) ? allTxs : (allTxs && allTxs.data ? allTxs.data : []);
            
            buildLeaveApplicationsList(rawList);
            populateEmployeeDropdown();
            updateSubstituteDropdown('');

            $('select.form-control').select2({ width: '100%' });

            if (isEditMode) {
                loadLeaveReturnForEdit(editHeaderId);
            }
        }).fail(function() {
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load employee masters or leave applications.', 'error', 4000);
            }
        });

        // 1. Employee selection change
        $('#hdr-employee').change(function() {
            onEmployeeChange();
        });

        // 2. Leave application selection change
        $('#hdr-leaveapp').change(function() {
            onLeaveAppChange();
        });

        // 3. Extension leave type change
        $('#dtl-leavetype').change(function() {
            onLeaveTypeChange();
        });

        // 4. Extension calculations
        $('.calc-trigger').on('change input', function() {
            calculateExtensionLeaves();
        });
    });

    function initFlatpickrs() {
