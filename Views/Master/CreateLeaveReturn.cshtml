    function recalculateLateEarly() {
        var leaveStartStr = $('#hdr-leavestartdate').val() || (selectedLeaveApp ? selectedLeaveApp.startDate : '');
        var leaveEndStr = $('#hdr-leaveenddate').val() || (selectedLeaveApp ? selectedLeaveApp.endDate : '');
        var rejoinStr = $('#hdr-rejoiningdate').val();

        if (!leaveStartStr || !leaveEndStr || !rejoinStr) return;

        var leaveStartObj = parseDateObj(leaveStartStr);
        var leaveEndObj = parseDateObj(leaveEndStr);
        var rejoinObj = parseDateObj(rejoinStr);

        leaveStartObj.setHours(0,0,0,0);
        leaveEndObj.setHours(0,0,0,0);
        rejoinObj.setHours(0,0,0,0);

        // RULE 1: Leave End Date CANNOT be before Leave Start Date
        if (leaveEndObj < leaveStartObj) {
            alertify.log(`Leave End Date (${formatDateDisplay(leaveEndStr)}) cannot be earlier than Leave Start Date (${formatDateDisplay(leaveStartStr)}).`, 'error', 4500);
            var resetEndFmt = formatDateStr(leaveStartObj);
            if (leaveEndDatePicker) {
                leaveEndDatePicker.setDate(resetEndFmt, false);
            } else {
                $('#hdr-leaveenddate').val(resetEndFmt);
            }
            leaveEndObj = new Date(leaveStartObj);
            leaveEndStr = resetEndFmt;
        }

        // RULE 2: Return / Rejoining Date CANNOT be before Leave Start Date
        if (rejoinObj < leaveStartObj) {
            alertify.log(`Return / Rejoining Date (${formatDateDisplay(rejoinStr)}) cannot be earlier than Leave Start Date (${formatDateDisplay(leaveStartStr)}).`, 'error', 5000);
            var resetRejoin = new Date(leaveEndObj);
            resetRejoin.setDate(resetRejoin.getDate() + 1);
            var resetRejoinFmt = formatDateStr(resetRejoin);
            if (rejoiningDatePicker) {
                rejoiningDatePicker.setDate(resetRejoinFmt, false);
            } else {
                $('#hdr-rejoiningdate').val(resetRejoinFmt);
            }
            rejoinObj = resetRejoin;
            rejoinStr = resetRejoinFmt;
        }

        // Expected on-time return is the day after leave ends
        var expectedRejoinObj = new Date(leaveEndObj);
        expectedRejoinObj.setDate(expectedRejoinObj.getDate() + 1);
        expectedRejoinObj.setHours(0,0,0,0);

        var msPerDay = 1000 * 60 * 60 * 24;
        var dayDiff = Math.round((expectedRejoinObj - rejoinObj) / msPerDay);

        var lateEarlyDays = 0;
        var badgeClass = 'late-early-ontime';
        var badgeText = '0 Days (On-Time)';
        var notifHtml = '';

        if (dayDiff === 0) {
            // ON-TIME RETURN (0 Days)
            lateEarlyDays = 0;
            badgeClass = 'late-early-ontime';
            badgeText = '0 Days (On-Time)';
            notifHtml = `
                <div class="notification-banner alert-success border border-success">
                    <i class="fas fa-check-circle fa-2x mr-3 text-success"></i>
                    <div>
                        <div class="font-weight-bold text-success" style="font-size: 0.95rem;">On-Time Return (0 Days)</div>
                        <div class="text-dark">Employee rejoined on schedule on <strong>${formatDateDisplay(rejoinStr)}</strong>. No additional leave adjustments required. Ready to save.</div>
                    </div>
                </div>
            `;
            $('#extension-status-badge').text('Not Required (On-Time)').attr('class', 'badge badge-success');
        } else if (dayDiff < 0) {
            // LATE RETURN (Negative value, e.g. -5 days)
            var lateDaysFromEnd = Math.round((rejoinObj - leaveEndObj) / msPerDay);
            lateEarlyDays = -Math.abs(lateDaysFromEnd > 0 ? lateDaysFromEnd : -dayDiff);
            badgeClass = 'late-early-late';
            badgeText = lateEarlyDays + ' Days (Late)';
            var lateCount = Math.abs(lateEarlyDays);

            notifHtml = `
                <div class="notification-banner alert-danger border border-danger">
                    <i class="fas fa-exclamation-triangle fa-2x mr-3 text-danger"></i>
                    <div>
                        <div class="font-weight-bold text-danger" style="font-size: 0.95rem;">Late Return Detected (${lateCount} Days Overstayed)</div>
                        <div class="text-dark">Employee rejoined on <strong>${formatDateDisplay(rejoinStr)}</strong>, which is <strong>${lateCount} day(s) late</strong> after the approved leave end date (${formatDateDisplay(leaveEndStr)}). 
                        <span class="text-danger font-weight-bold">Rule: You must fill the Leave Extension application details in the section below for ${lateCount} day(s) before saving.</span></div>
                    </div>
                </div>
            `;
            $('#extension-status-badge').text(`Mandatory: ${lateCount} Days Extension`).attr('class', 'badge badge-danger');

            // Set default extension dates for late overstay: From (Leave End + 1) to (Rejoining Date - 1 or Rejoining Date)
            var extStart = new Date(leaveEndObj);
            extStart.setDate(extStart.getDate() + 1);
            var extEnd = new Date(rejoinObj);
            extEnd.setDate(extEnd.getDate() - 1);
            if (extEnd < extStart) extEnd = new Date(extStart);

            if (fromDatePicker && toDatePicker && stagedLeaves.length === 0) {
                fromDatePicker.set('minDate', formatDateStr(extStart));
                fromDatePicker.setDate(formatDateStr(extStart), true);
                toDatePicker.set('minDate', formatDateStr(extStart));
                toDatePicker.setDate(formatDateStr(extEnd), true);
            }
        } else {
            // EARLY RETURN (Positive value, e.g. +4 days)
            var earlyDays = Math.round((leaveEndObj - rejoinObj) / msPerDay) + 1;
            lateEarlyDays = Math.max(1, earlyDays);
            badgeClass = 'late-early-early';
            badgeText = '+' + lateEarlyDays + ' Days (Early)';

            notifHtml = `
                <div class="notification-banner alert-warning border border-warning">
                    <i class="fas fa-info-circle fa-2x mr-3 text-warning"></i>
                    <div>
                        <div class="font-weight-bold text-warning" style="font-size: 0.95rem;">Early Return (+${lateEarlyDays} Days)</div>
                        <div class="text-dark">Employee reported back to work early on <strong>${formatDateDisplay(rejoinStr)}</strong> (${lateEarlyDays} day(s) before scheduled leave end date ${formatDateDisplay(leaveEndStr)}). Early return will be recorded upon save.</div>
                    </div>
                </div>
            `;
            $('#extension-status-badge').text(`Early Return (+${lateEarlyDays} Days)`).attr('class', 'badge badge-warning');
        }

        $('#hdr-lateearlydays').val(lateEarlyDays);
        $('#late-early-badge').attr('class', 'late-early-display ' + badgeClass).text(badgeText);
        $('#smart-notification-container').html(notifHtml).slideDown(200);
    }

    function onLeaveTypeChange() {
        var ltId = parseInt($('#dtl-leavetype').val()) || 0;
        var ltOpt = $('#dtl-leavetype option:selected');
        var ltName = ltOpt.data('name') || ltOpt.text();
        var empOpt = $('#hdr-employee option:selected');
        var empName = empOpt.data('name') || empOpt.text() || '';

        if (!ltId || currentEmployeeLeaves.length === 0) {
            $('#summary-type-badge').text(ltName || 'No Leave Type Selected');
            $('#summary-header-label').text('Leave Balance & Overview');
            $('#sum-eligible, #sum-approved, #sum-unapproved, #sum-available, #sum-usednow, #sum-balance').text('0.0');
            calculateExtensionLeaves();
            return;
        }

        $('#summary-type-badge').text(ltName);
        $('#summary-header-label').text('Leave Balance: ' + ltName + (empName ? ' (' + empName + ')' : ''));

        var bal = currentEmployeeLeaves.find(l => l.iLeaveTypeId === ltId);
        if (bal) {
            var eligible = parseFloat(bal.openingLeaves || 0);
            var approved = parseFloat(bal.leavesApproved || 0);
            var pending = parseFloat(bal.leavesPending || 0);
            
            var stagedUsed = 0;
            stagedLeaves.forEach(function(sl) {
                if (sl.leaveTypeId === ltId && (!editingSubLeaveId || sl.stagedId !== editingSubLeaveId)) {
                    stagedUsed += parseFloat(sl.duration || 0);
                }
            });

            var rawAvailable = (bal.leaveBalance !== undefined && bal.leaveBalance !== null) 
                ? parseFloat(bal.leaveBalance) 
                : (eligible - approved - pending);
            var available = Math.max(0, rawAvailable - stagedUsed);

            $('#sum-eligible').text(eligible.toFixed(1));
            $('#sum-approved').text(approved.toFixed(1));
            $('#sum-unapproved').text(pending.toFixed(1));
            $('#sum-available').text(available.toFixed(1));
        } else {
            $('#sum-eligible, #sum-approved, #sum-unapproved, #sum-available').text('0.0');
        }

        calculateExtensionLeaves();
    }

    function calculateExtensionLeaves() {
        var fromStr = $('#dtl-fromdate').val();
        var toStr = $('#dtl-todate').val();
        var isHalf = $('#dtl-halfday').val() === 'Yes';
        var wOff = parseFloat($('#dtl-weeklyoff').val()) || 0;
        var pHol = parseFloat($('#dtl-publicholiday').val()) || 0;

        if (!fromStr || !toStr) {
            $('#dtl-duration').val(0);
            $('#dtl-noofleaves').val(0);
            updateSummaryUsedAndBalance(0);
            return;
        }

        var dFrom = parseDateObj(fromStr);
        var dTo = parseDateObj(toStr);

        dFrom.setHours(0,0,0,0);
        dTo.setHours(0,0,0,0);

        if (dTo < dFrom) {
            alertify.log('Extension To Date cannot be earlier than Extension From Date.', 'error', 3500);
            if (toDatePicker) toDatePicker.setDate(fromStr, false);
            dTo = new Date(dFrom);
        }

        var diffDays = Math.round((dTo - dFrom) / (1000 * 60 * 60 * 24)) + 1;
        $('#dtl-duration').val(diffDays);

        if (wOff + pHol >= diffDays) {
            wOff = 0;
            pHol = 0;
            $('#dtl-weeklyoff').val(0);
            $('#dtl-publicholiday').val(0);
        }

        var netDays = isHalf ? 0.5 : Math.max(0, diffDays - wOff - pHol);
        $('#dtl-noofleaves').val(netDays);
        updateSummaryUsedAndBalance(netDays);
    }

    function updateSummaryUsedAndBalance(usedNow) {
        $('#sum-usednow').text(usedNow.toFixed(1));
        var avail = parseFloat($('#sum-available').text()) || 0;
        var bal = Math.max(0, avail - usedNow);
        $('#sum-balance').text(bal.toFixed(1));
    }

    // Comprehensive Overlap Check: Prevents applying for identical or overlapping dates
    function checkOverlappingExtension(fromStr, toStr, duration, ignoreStagedId) {
        var f = parseDateObj(fromStr);
        var t = parseDateObj(toStr);
        f.setHours(0,0,0,0);
        t.setHours(0,0,0,0);

        var durDays = Math.max(1, Math.ceil(duration || 1));
        var minEndFromDur = new Date(f.getTime() + (durDays - 1) * 86400000);
        minEndFromDur.setHours(0,0,0,0);
        if (t < f || t < minEndFromDur) {
            t = minEndFromDur;
        }

        // 1. Check against the Original Approved Leave Application Period
        if (selectedLeaveApp) {
            var origStart = parseDateObj(selectedLeaveApp.startDate);
            var origEnd = parseDateObj(selectedLeaveApp.endDate);
            origStart.setHours(0,0,0,0);
            origEnd.setHours(0,0,0,0);

            // Overlap check: f <= origEnd && t >= origStart
            if (f.getTime() <= origEnd.getTime() && t.getTime() >= origStart.getTime()) {
                return {
                    hasOverlap: true,
                    message: `Extension dates (${formatDateDisplay(fromStr)} to ${formatDateDisplay(toStr)}) overlap with the original approved leave period (${formatDateDisplay(selectedLeaveApp.startDate)} to ${formatDateDisplay(selectedLeaveApp.endDate)}). Late leave extension must begin after ${formatDateDisplay(selectedLeaveApp.endDate)}.`
                };
            }
        }

        // 2. Check against already staged extension lines in the grid
        for (var i = 0; i < stagedLeaves.length; i++) {
            var sl = stagedLeaves[i];
            if (ignoreStagedId && sl.stagedId === ignoreStagedId) {
                continue; // Skip the sub-leave being edited
            }

            var sF = parseDateObj(sl.fromDate);
            var sT = parseDateObj(sl.toDate);
            sF.setHours(0,0,0,0);
            sT.setHours(0,0,0,0);

            var sDur = Math.max(1, Math.ceil(sl.duration || 1));
            var sMinEnd = new Date(sF.getTime() + (sDur - 1) * 86400000);
            sMinEnd.setHours(0,0,0,0);
            if (sT < sMinEnd) sT = sMinEnd;

            // Overlap condition: f <= sT && t >= sF
            if (f.getTime() <= sT.getTime() && t.getTime() >= sF.getTime()) {
                return {
                    hasOverlap: true,
                    message: `Selected extension dates (${fromStr} to ${toStr}) overlap with an existing line in the grid (${sl.fromDate} to ${sl.toDate} - ${sl.leaveTypeName}). Duplicate or overlapping dates are not allowed.`
                };
            }
        }

        // 3. Check against Return / Rejoining Date
        var rejoinStr = $('#hdr-rejoiningdate').val();
        if (rejoinStr) {
            var rDate = parseDateObj(rejoinStr);
            rDate.setHours(0,0,0,0);
            if (f.getTime() >= rDate.getTime()) {
                return {
                    hasOverlap: true,
                    message: `Extension From Date (${fromStr}) cannot be on or after the Return / Rejoining Date (${formatDateDisplay(rejoinStr)}). Employee has already reported back to work on this date.`
                };
            }
        }

        return { hasOverlap: false };
    }

    function addToGrid() {
        var ltId = parseInt($('#dtl-leavetype').val()) || 0;
        var ltName = $('#dtl-leavetype option:selected').data('name') || $('#dtl-leavetype option:selected').text();
        var payType = $('#dtl-paymenttype').val();
        var isHalf = $('#dtl-halfday').val();
        var fromStr = $('#dtl-fromdate').val();
        var toStr = $('#dtl-todate').val();
        var duration = parseFloat($('#dtl-noofleaves').val()) || 0;
        var contact = $('#dtl-contact').val() || '';
        var subId = $('#dtl-substitute').val() || '';
        var subName = $('#dtl-substitute option:selected').data('name') || '';

        if (!ltId) {
            alertify.log('Please select a Leave Type for extension.', 'error', 3000);
            return;
        }
        if (duration <= 0) {
            alertify.log('Extension duration must be greater than 0 days.', 'error', 3000);
            return;
        }

        // OVERLAP VALIDATION CHECK
        var overlapCheck = checkOverlappingExtension(fromStr, toStr, duration, editingSubLeaveId);
        if (overlapCheck.hasOverlap) {
            alertify.log(overlapCheck.message, 'error', 7000);
            return;
        }

        var item = {
            stagedId: editingSubLeaveId || ('STG_' + Date.now()),
            leaveTypeId: ltId,
            leaveTypeName: ltName,
            paymentType: payType,
            isHalfDay: isHalf,
            fromDate: fromStr,
            toDate: toStr,
            duration: duration,
            contactNo: contact,
            substituteId: subId,
            substituteName: subName,
            eligible: parseFloat($('#sum-eligible').text()) || 0,
            approved: parseFloat($('#sum-approved').text()) || 0,
            pending: parseFloat($('#sum-unapproved').text()) || 0,
            available: parseFloat($('#sum-available').text()) || 0,
            usedNow: duration,
            balance: parseFloat($('#sum-balance').text()) || 0
        };

        if (editingSubLeaveId) {
            var idx = stagedLeaves.findIndex(l => l.stagedId === editingSubLeaveId);
            if (idx > -1) stagedLeaves[idx] = item;
            editingSubLeaveId = null;
            $('#btn-cancel-subleave').hide();
            $('#btn-add-to-grid').html('<i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add Extension to Grid');
        } else {
            stagedLeaves.push(item);
        }

        renderUserGrid();
        recalculateSystemGrid();
        onLeaveTypeChange();
        alertify.log('Extension leave line added successfully.', 'success', 2500);
    }

    function renderUserGrid() {
        var tbody = $('#user-grid-table tbody');
        tbody.empty();

        if (stagedLeaves.length === 0) {
            tbody.append('<tr id="empty-row"><td colspan="13" class="text-center text-muted py-3">No extension leaves added. (Required only when Late/Early Days &lt; 0).</td></tr>');
            return;
        }

        stagedLeaves.forEach(function(sl) {
            var rowHtml = `
                <tr id="row-${sl.stagedId}">
                    <td class="action-btns" style="text-align: center;">
                        <a onclick="editSubLeave('${sl.stagedId}')" title="Edit line"><i class="fas fa-edit"></i></a>
                        <a onclick="deleteSubLeave('${sl.stagedId}')" title="Delete line"><i class="fas fa-trash-alt"></i></a>
                    </td>
                    <td><span class="leave-badge">${sl.leaveTypeName}</span></td>
                    <td>${sl.fromDate}</td>
                    <td>${sl.toDate}</td>
                    <td class="num-col font-weight-bold text-primary">${sl.duration.toFixed(1)}</td>
                    <td>${sl.contactNo || '-'}</td>
                    <td>${sl.substituteName || '-'}</td>
                    <td class="num-col">${sl.eligible.toFixed(1)}</td>
                    <td class="num-col">${sl.approved.toFixed(1)}</td>
                    <td class="num-col">${sl.pending.toFixed(1)}</td>
                    <td class="num-col">${sl.available.toFixed(1)}</td>
                    <td class="num-col font-weight-bold">${sl.usedNow.toFixed(1)}</td>
                    <td class="num-col font-weight-bold text-success">${sl.balance.toFixed(1)}</td>
                </tr>
            `;
            tbody.append(rowHtml);
        });
    }

    function editSubLeave(id) {
        var sl = stagedLeaves.find(l => l.stagedId === id);
        if (!sl) return;

        editingSubLeaveId = id;
        $('#dtl-leavetype').val(sl.leaveTypeId).trigger('change');
        $('#dtl-paymenttype').val(sl.paymentType);
        $('#dtl-halfday').val(sl.isHalfDay);
        if (fromDatePicker) fromDatePicker.setDate(sl.fromDate, true);
        if (toDatePicker) toDatePicker.setDate(sl.toDate, true);
        $('#dtl-contact').val(sl.contactNo);
        $('#dtl-substitute').val(sl.substituteId).trigger('change');

        $('#btn-cancel-subleave').show();
        $('#btn-add-to-grid').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Line');
        $('#user-grid-table tbody tr').removeClass('row-selected-edit');
        $('#row-' + id).addClass('row-selected-edit');
    }

    function cancelSubLeaveEdit() {
        editingSubLeaveId = null;
        $('#btn-cancel-subleave').hide();
        $('#btn-add-to-grid').html('<i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add Extension to Grid');
        $('#user-grid-table tbody tr').removeClass('row-selected-edit');
        onLeaveTypeChange();
    }

    function deleteSubLeave(id) {
        stagedLeaves = stagedLeaves.filter(l => l.stagedId !== id);
        if (editingSubLeaveId === id) cancelSubLeaveEdit();
        renderUserGrid();
        recalculateSystemGrid();
        onLeaveTypeChange();
    }

    function recalculateSystemGrid() {
        var tbody = $('#system-grid-table tbody');
        tbody.empty();

        if (stagedLeaves.length === 0) {
            tbody.append('<tr id="empty-sys-row"><td colspan="5" class="text-center text-muted py-3">No breakdown available.</td></tr>');
            return;
        }

        var monthsMap = {};
        var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

        stagedLeaves.forEach(function(sl) {
            var cur = parseDateObj(sl.fromDate);
            var end = parseDateObj(sl.toDate);

            while (cur <= end) {
                var mKey = monthNames[cur.getMonth()] + '-' + cur.getFullYear();
                if (!monthsMap[mKey]) {
                    monthsMap[mKey] = {
                        leaveType: sl.leaveTypeName,
                        month: mKey,
                        fromDate: formatDateStr(cur),
                        toDate: formatDateStr(cur),
                        days: 0
                    };
                }
                monthsMap[mKey].days += (sl.isHalfDay === 'Yes' ? 0.5 : 1);
                monthsMap[mKey].toDate = formatDateStr(cur);
                cur.setDate(cur.getDate() + 1);
            }
        });

        Object.keys(monthsMap).forEach(function(k) {
            var m = monthsMap[k];
            tbody.append(`
                <tr>
                    <td><span class="leave-badge">${m.leaveType}</span></td>
                    <td><strong>${m.month}</strong></td>
                    <td>${m.fromDate}</td>
                    <td>${m.toDate}</td>
                    <td class="num-col font-weight-bold">${m.days.toFixed(1)}</td>
                </tr>
            `);
        });
    }

    function saveLeaveReturn() {
        // 1. MANDATORY EMPLOYEE VALIDATION
        var empId = $('#hdr-employee').val();
        if (!empId) {
            alertify.log('Please select an Employee before saving.', 'error', 4000);
            $('#hdr-employee').select2('open');
            return;
        }

        // 2. MANDATORY LEAVE APPLICATION VALIDATION
        var appId = $('#hdr-leaveapp').val();
        if (!appId || !selectedLeaveApp) {
            alertify.log('Please select a valid Leave Application for the employee before saving.', 'error', 4000);
            $('#hdr-leaveapp').select2('open');
            return;
        }

        // 3. MANDATORY RETURN / REJOINING DATE VALIDATION
        var rejoiningDate = $('#hdr-rejoiningdate').val();
        if (!rejoiningDate) {
            alertify.log('Please specify the Return / Rejoining Date.', 'error', 4000);
            $('#hdr-rejoiningdate').focus();
            return;
        }

        var leaveStartDate = $('#hdr-leavestartdate').val() || selectedLeaveApp.startDate;
        var leaveEndDate = $('#hdr-leaveenddate').val() || selectedLeaveApp.endDate;

        var startObj = parseDateObj(leaveStartDate);
        var rejoinObj = parseDateObj(rejoiningDate);
        startObj.setHours(0,0,0,0);
        rejoinObj.setHours(0,0,0,0);

        if (rejoinObj < startObj) {
            alertify.log(`Return / Rejoining Date (${formatDateDisplay(rejoiningDate)}) cannot be earlier than Leave Start Date (${formatDateDisplay(leaveStartDate)}).`, 'error', 5000);
            $('#hdr-rejoiningdate').focus();
            return;
        }

        var lateEarlyDays = parseFloat($('#hdr-lateearlydays').val()) || 0;

        // 4. RULE VALIDATIONS:
        // Case: If Late/Early < 0 (Late Return), user MUST fill leave extension grid!
        if (lateEarlyDays < 0) {
            if (stagedLeaves.length === 0) {
                alertify.log(`Employee is returning late by ${Math.abs(lateEarlyDays)} day(s). Please fill the Leave Extension details and add to grid before saving.`, 'error', 6000);
                $('#leave-extension-card')[0].scrollIntoView({ behavior: 'smooth' });
                return;
            }

            // Verify no overlapping extension lines before saving
            for (var i = 0; i < stagedLeaves.length; i++) {
                var slItem = stagedLeaves[i];
                var ovCheck = checkOverlappingExtension(slItem.fromDate, slItem.toDate, slItem.duration, slItem.stagedId);
                if (ovCheck.hasOverlap) {
                    alertify.log(ovCheck.message, 'error', 6500);
                    return;
                }
            }
        }

        var docNo = $('#hdr-docno').val();
        var returnDate = $('#hdr-date').val();
        var postDate = $('#hdr-postdate').val();
        var comments = $('#hdr-comments').val();
        var statusStr = lateEarlyDays === 0 ? "On-Time" : (lateEarlyDays < 0 ? "Late" : "Early");

        var fileInput = document.getElementById('hdr-attachment');
        var attachFileName = (fileInput && fileInput.files.length > 0) ? fileInput.files[0].name : (editHeaderId ? 'LVR_Attachment.pdf' : '');

        var empOpt = $('#hdr-employee option:selected');
        var empCode = empOpt.data('code') || selectedLeaveApp.employeeCode;
        var empName = empOpt.data('name') || selectedLeaveApp.employeeName;

        var record = {
            iHeaderId: editHeaderId || Date.now(),
            sDocNo: docNo,
            dDocDate: returnDate,
            dPostDate: postDate,
            iLeaveApplicationId: selectedLeaveApp.id,
            sLeaveAppDocNo: selectedLeaveApp.docNo,
            iEmpId: empId,
            sEmployeeCode: empCode,
            sEmployeeName: empName,
            sDepartmentName: $('#hdr-department').val(),
            sDesignationName: $('#hdr-designation').val(),
            sReportingToName: $('#hdr-manager').val(),
            dLeaveStartDate: leaveStartDate,
            dLeaveEndDate: leaveEndDate,
            dRejoiningDate: rejoiningDate,
            fLateEarlyDays: lateEarlyDays,
            sLateEarlyStatus: statusStr,
            sComments: comments,
            leaves: stagedLeaves,
            attachment: {
                sAttachmentFileName: attachFileName || `${docNo}_ReturnDoc.pdf`,
                sAttachmentFilePath: ''
            }
        };

        var saved = JSON.parse(localStorage.getItem('savedLeaveReturns') || '[]');
        if (editHeaderId) {
            var idx = saved.findIndex(r => r.iHeaderId == editHeaderId || r.sDocNo === docNo);
            if (idx > -1) saved[idx] = record;
            else saved.push(record);
        } else {
            saved.push(record);
        }
        localStorage.setItem('savedLeaveReturns', JSON.stringify(saved));

        // User alert notifications
        var successMsg = '';
        if (lateEarlyDays === 0) {
            successMsg = `On-time return for ${record.sEmployeeName} processed successfully.`;
        } else if (lateEarlyDays < 0) {
            successMsg = `Late return by ${Math.abs(lateEarlyDays)} day(s) with leave extension processed successfully.`;
        } else {
            successMsg = `Early return (+${lateEarlyDays} days) for ${record.sEmployeeName} recorded successfully.`;
        }

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: successMsg, type: 'success' }));

        var listUrl = '@Url.Action("LeaveReturnIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(listUrl, true);
        } else {
            window.location.href = listUrl;
        }
    }

    function loadLeaveReturnForEdit(id) {
        var saved = JSON.parse(localStorage.getItem('savedLeaveReturns') || '[]');
        var rec = saved.find(r => r.iHeaderId == id);
        if (!rec) return;

        $('#hdr-docno').val(rec.sDocNo);
        $('#hdr-date').val(formatDateDisplay(rec.dDocDate));
        $('#hdr-postdate').val(formatDateDisplay(rec.dPostDate));
        $('#hdr-comments').val(rec.sComments || '');
        if (rec.sComments) $('#comments-counter').text(rec.sComments.length + '/250');

        $('#hdr-employee').val(rec.iEmpId).trigger('change');

        setTimeout(function() {
            if (rec.iLeaveApplicationId) {
                $('#hdr-leaveapp').val(rec.iLeaveApplicationId).trigger('change');
            }
            if (leaveStartDatePicker && rec.dLeaveStartDate) {
                leaveStartDatePicker.setDate(formatDateDisplay(rec.dLeaveStartDate), false);
            }
            if (leaveEndDatePicker && rec.dLeaveEndDate) {
                leaveEndDatePicker.setDate(formatDateDisplay(rec.dLeaveEndDate), false);
            }
            if (rejoiningDatePicker && rec.dRejoiningDate) {
                rejoiningDatePicker.setDate(formatDateDisplay(rec.dRejoiningDate), true);
            }
            if (Array.isArray(rec.leaves) && rec.leaves.length > 0) {
                stagedLeaves = rec.leaves;
                renderUserGrid();
                recalculateSystemGrid();
            }
        }, 300);
    }

    function parseDateObj(dStr) {
        if (!dStr) return new Date();
        if (dStr instanceof Date) return dStr;
        dStr = String(dStr).trim();
        if (dStr.includes('T')) dStr = dStr.split('T')[0];

        var months = {
            'jan':0,'feb':1,'mar':2,'apr':3,'may':4,'jun':5,'jul':6,'aug':7,'sep':8,'oct':9,'nov':10,'dec':11
        };

        if (/^\d{1,2}-[A-Za-z]{3}-\d{4}$/.test(dStr)) {
            var p = dStr.split('-');
            var m = months[p[1].toLowerCase()] || 0;
            return new Date(parseInt(p[2],10), m, parseInt(p[0],10));
        }

        if (/^\d{4}-\d{2}-\d{2}$/.test(dStr)) {
            var p = dStr.split('-');
            return new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10));
        }

        return new Date(dStr);
    }

    function formatDateStr(d) {
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var dd = String(d.getDate()).padStart(2, '0');
        var mmm = months[d.getMonth()];
        var yyyy = d.getFullYear();
        return dd + '-' + mmm + '-' + yyyy;
    }

    function formatDateDisplay(dStr) {
        if (!dStr) return '';
        var d = parseDateObj(dStr);
        if (isNaN(d.getTime())) return dStr;
        return formatDateStr(d);
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('Attachment exceeds maximum allowed size of 25MB.', 'error', 4000);
                input.value = '';
            }
        }
    }
</script>
