    // 100% PURE API: Load Leave Transactions
    function loadApiLeaveTransactions() {
        $.getJSON('/Master/GetApiLeaveTransactions').done(function(txRes) {
            var rawList = Array.isArray(txRes) ? txRes : (txRes && txRes.data ? txRes.data : []);
            
            // Also combine with locally saved applications if any
            var localApps = JSON.parse(localStorage.getItem('savedLeaveApplications') || '[]');
            localApps.forEach(function(loc) {
                if (!rawList.some(r => r.iHeaderId == loc.iHeaderId || (r.sDocNo && r.sDocNo === loc.sDocNo))) {
                    rawList.push(loc);
                }
            });

            buildLeaveApplicationsList(rawList);
        }).fail(function() {
            var localApps = JSON.parse(localStorage.getItem('savedLeaveApplications') || '[]');
            buildLeaveApplicationsList(localApps);
        });
    }

    function buildLeaveApplicationsList(apiTransactions) {
        var list = [];
        
        if (Array.isArray(apiTransactions)) {
            apiTransactions.forEach(function(tx) {
                var lines = tx.leaves || [];
                var txEmpId = tx.iEmpId || tx.employeeId || 0;
                var sDocDate = tx.dDocDate || '2026-08-01';

                if (lines.length > 0) {
                    lines.forEach(function(l) {
                        var eId = l.iEmployeeId || txEmpId;
                        var dur = parseFloat(l.fDuration || l.duration || 1);
                        if (isNaN(dur) || dur <= 0) dur = 1;

                        var sLDate = l.dFromDate || l.fromDate || sDocDate;
                        var eLDate = l.dToDate || l.toDate;

                        // ACCURATELY CALCULATE REAL TO DATE IF MISSING OR EQUAL TO START DATE WITH DURATION > 1
                        if (!eLDate || eLDate === sLDate) {
                            if (dur > 1) {
                                var sObj = parseDateObj(sLDate);
                                var eObj = new Date(sObj);
                                eObj.setDate(eObj.getDate() + Math.round(dur) - 1);
                                eLDate = formatDateStr(eObj);
                            } else {
                                eLDate = sLDate;
                            }
                        }

                        list.push({
                            id: tx.iHeaderId || l.iHeaderId || (list.length + 1),
                            docNo: tx.sDocNo || ('LVS' + String(tx.iHeaderId || list.length + 1).padStart(6, '0')),
                            employeeId: eId,
                            employeeCode: l.sEmployeeCode || tx.sEmployeeCode || '',
                            employeeName: l.sEmployeeName || tx.sEmployeeName || 'Employee',
                            department: l.sDepartmentName || tx.sDepartmentName || '',
                            designation: l.sDesignationName || tx.sDesignationName || '',
                            manager: l.sReportingToName || tx.sReportingToName || '',
                            leaveTypeId: l.iLeaveTypeId || 7,
                            leaveTypeName: l.sLeaveTypeName || 'Annual Leave',
                            startDate: sLDate,
                            endDate: eLDate,
                            duration: dur,
                            comments: tx.sComments || l.sRemarks || 'Approved Leave'
                        });
                    });
                } else if (txEmpId > 0) {
                    var dur = parseFloat(tx.fDuration || 1);
                    if (isNaN(dur) || dur <= 0) dur = 1;
                    var sLDate = tx.dFromDate || sDocDate;
                    var eLDate = tx.dToDate;

                    if (!eLDate || eLDate === sLDate) {
                        if (dur > 1) {
                            var sObj = parseDateObj(sLDate);
                            var eObj = new Date(sObj);
                            eObj.setDate(eObj.getDate() + Math.round(dur) - 1);
                            eLDate = formatDateStr(eObj);
                        } else {
                            eLDate = sLDate;
                        }
                    }

                    list.push({
                        id: tx.iHeaderId || (list.length + 1),
                        docNo: tx.sDocNo || ('LVS' + String(tx.iHeaderId || list.length + 1).padStart(6, '0')),
                        employeeId: txEmpId,
                        employeeCode: tx.sEmployeeCode || '',
                        employeeName: tx.sEmployeeName || 'Employee',
                        department: tx.sDepartmentName || '',
                        designation: tx.sDesignationName || '',
                        manager: tx.sReportingToName || '',
                        leaveTypeId: 7,
                        leaveTypeName: 'Annual Leave',
                        startDate: sLDate,
                        endDate: eLDate,
                        duration: dur,
                        comments: tx.sComments || 'Approved Leave'
                    });
                }
            });
        }

        leaveApplicationsData = list;
    }

    // 1. Triggered when Employee is selected
    function onEmployeeChange() {
        var empId = $('#hdr-employee').val();
        var leaveAppSelect = $('#hdr-leaveapp');
        leaveAppSelect.empty();

        if (!empId) {
            $('#hdr-designation, #hdr-department, #hdr-manager, #hdr-leavestartdate, #hdr-leaveenddate').val('');
            $('#hdr-lateearlydays').val('0');
            $('#late-early-badge').attr('class', 'late-early-display late-early-ontime').text('0 Days');
            $('#orig-leave-card').hide();
            $('#smart-notification-container').hide();
            leaveAppSelect.append('<option value="">Select Employee First...</option>').select2({ width: '100%' });
            stagedLeaves = [];
            renderUserGrid();
            return;
        }

        var emp = employeesData.find(e => String(e.id) === String(empId) || String(e.iMasterId) === String(empId));
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '-');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '-');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || '-');
        }

        updateSubstituteDropdown(empId);
        fetchEmployeeBalances(empId);

        // Filter leave applications for this employee from real API records
        var empApps = leaveApplicationsData.filter(a => 
            String(a.employeeId) === String(empId) || 
            (emp && emp.code && String(a.employeeCode) === String(emp.code)) ||
            (emp && emp.sCode && String(a.employeeCode) === String(emp.sCode))
        );

        if (empApps.length === 0) {
            leaveAppSelect.append('<option value="">No Active Leave Applications Found for this Employee</option>');
