<!-- Content Header (Page header) -->
@using Microsoft.AspNetCore.Http;
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/sweetalert-dev.js"></script>
<link href="~/lib/sweetalert.css" rel="stylesheet" />
<script src="~/scripts/FClient.js"></script>
<link href="~/lib/datepicker/datepicker.css" rel="stylesheet" />
<script defer src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
<script defer src="~/lib/select2/js/select2.min.js"></script>
<section class="content-header">
    <h1>
        Sites
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li><a href="@Url.Action("SiteIndex", "Master")">Sites List</a></li>
        <li class="active">Sites</li>
    </ol>
    <input type="hidden" id="userid" name="userid" value="@Context.Session.GetString("userid")" />
</section>
<!-- Main content -->
<section class="content container-fluid">
    <!-- Horizontal Form -->
    <div class="box box-danger">
        <div class="box-header with-border">
            <h3 class="box-title">Add Site</h3>
        </div>
        <!-- /.box-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="box-body">
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Code</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" name="Code" placeholder="Code" id="sCode">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Name</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" name="Name" placeholder="Name" id="sName">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Project</label>
                    <div class="col-sm-10">

                        <select class="form-control select" id="ddlProjects">
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
                <button type="button" id="btnCreate" class="btn btn-info pull-right">Create</button>
            </div>
            <!-- /.box-footer -->
        </form>
    </div>
    <!-- /.box -->
</section>
<script>
    var companyId = 0;
    var sessionId = "";
    var LoginId = $("#userid").val();
    $(document).ready(function () {
        debugger;

        loadProjects();
        $('#ddlProjects').select2();
        $("#sCode").focus();
    });
    function loadProjects() {
        debugger;
        var Project;
        $.ajax({
                url: "@Url.Action("GetProjects", "Master")",
                method: 'GET',
                success: function (response) {
                    Project = response;
                    var ddlHTML = '<option value="0">--Select--</option>';
                    if (Project != null && Project.length != 0) {
                        $(Project).each(function () {
                            ddlHTML += '<option value=' + this.iMasterId + '>' + this.sName + '</option>';
                        });
                    }
                    $('#ddlProjects').html(ddlHTML);
                }
        });
    }
    $('#btnCancel').click(function () {
        location.href ='@Url.Action("SiteIndex", "Master")';
    });
    $('#btnCreate').click(function () {
        debugger;
        var Name = $('#sName').val();
        var Project = $('#ddlProjects').val();
        var Code = $('#sCode').val();
        if (Code == null || Code == "") {
            swal({
                title: "",
                text: "Code Cannot Be Empty",
                button: "Close", // Text on button
                type: "warning", //built in icons: success, warning, error, info
                timer: 10000, //timeOut for auto-close
                buttons: {
                    confirm: {
                        text: "OK",
                        value: true,
                        visible: true,
                        className: "",
                        closeModal: true
                    }
                }
            });
            $("#sCode").focus();
        }
        else if (Name == null || Name == "") {
            swal({
                title: "",
                text: "Name Cannot Be Empty",
                button: "Close", // Text on button
                type: "warning", //built in icons: success, warning, error, info
                timer: 10000, //timeOut for auto-close
                buttons: {
                    confirm: {
                        text: "OK",
                        value: true,
                        visible: true,
                        className: "",
                        closeModal: true
                    }
                }
            });
            $("#sName").focus();
        }
        else {
            var fdata = { sCode: Code, sName: Name, Project: Project,  UserId: LoginId };

            $.ajax({
                method: "POST",
                url: "@Url.Action("CreateSite", "Master")",
                data:  fdata ,
                dataType: "json",
                success: function (r) {
                    if (r != null && r != "") {

                        swal({
                            title: "",
                            text: r,
                            button: "Close", // Text on button
                            type: "warning", //built in icons: success, warning, error, info
                            timer: 10000, //timeOut for auto-close
                            buttons: {
                                confirm: {
                                    text: "OK",
                                    value: true,
                                    visible: true,
                                    className: "",
                                    closeModal: true
                                }
                            }
                        });
                        $("#sCode").focus();
                        $("#sCode").select();
                        if (r == "Invalid Session")
                            location.href = '@Url.Action("Logout", "Login")';
                    }
                    else
                        location.href = '@Url.Action("SiteIndex", "Master")';
                },
                error: function () {
                    swal({
                        title: "",
                        text: "Error in create...",
                        button: "Close", // Text on button
                        type: "warning",//built in icons: success, warning, error, info
                        timer: 10000, //timeOut for auto-close
                        buttons: {
                            confirm: {
                                text: "OK",
                                value: true,
                                visible: true,
                                className: "",
                                closeModal: true
                            }
                        }
                    });
                     return;
                }
            });
        }
    });
</script>