@{
    ViewData["Title"] = "HR Disbursement";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .number-align {
        text-align: right;
    }
    input[type="text"], textarea, select { text-align: left; }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }

    .reqtype-badge {
        display: inline-block;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .reqtype-returnable {
        background-color: #fef8e7;
        color: #b78103;
        border: 1px solid #ffeeba;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text" id="page-header-title">
                    <i class="fas fa-hand-holding-usd fa-sm text-primary mr-2"></i> HR Disbursement
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("HRDisbursementIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-info btn-sm shadow-sm ml-2" onclick="showReturnable()">
                        <i class="fas fa-search fa-sm text-white-50 mr-1"></i> Show Returnable
                    </button>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" id="btn-save-disbursement" onclick="saveDisbursement()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save Disbursement
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="disbursementForm" autocomplete="off">
        <input type="hidden" id="hdr-edit-id" value="0" />

        <!-- COMMON HEADER CARD WITH SAME VALIDATION -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    
                    <!-- Employee dropdown: API-driven with JSON fallback -->
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Loading Employees...</option>
                        </select>
                    </div>

                    <!-- Auto-populated from Employee Profile -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly placeholder="Auto loaded" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly placeholder="Auto loaded" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly placeholder="Auto loaded" />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Remarks / Comments</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter remarks or comments..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted">Upload disbursement receipt or handover form if any.</small>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- USER GRID: DISBURSEMENT ITEMS DETAILED -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex justify-content-between align-items-center">
            <span><i class="fas fa-hand-holding-usd mr-2"></i>Disbursement Items Detailed</span>
            <small class="text-white-50">Click "Show Returnable" to recall returnable requests for selected employee</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Request Type</th>
                            <th class="num-col" style="width: 80px;">Qty</th>
                            <th>Remarks</th>
                            <th>Req No</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="5" class="text-center text-muted py-3">No returnable items selected. Select an employee and click "Show Returnable".</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var employeesData = [];
    var pendingDisbursements = [];
    var editHeaderId = 0;
    var isEditMode = false;

    $(document).ready(function() {
        var urlParams = new URLSearchParams(window.location.search);
        var paramId = urlParams.get('id') || '@ViewBag.EditId';
        editHeaderId = parseInt(paramId) || 0;
        isEditMode = editHeaderId > 0;

        if (isEditMode) {
            $('#page-header-title').html('<i class="fas fa-edit fa-sm text-primary mr-2"></i> Edit HR Disbursement <span class="badge badge-primary font-weight-bold ml-2">Edit Mode</span>');
            $('#btn-save-disbursement').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Disbursement');
            $('#hdr-edit-id').val(editHeaderId);
        }

        initHeaderDocNo();

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });

        // Load Employees: Direct API
        $.getJSON('/Master/GetApiEmployees').done(function(empRes) {
            var rawEmp = (empRes && empRes[0]) ? empRes[0] : empRes;
            employeesData = Array.isArray(rawEmp) ? rawEmp : (Array.isArray(empRes) ? empRes : []);
            populateDropdowns();

            if (isEditMode) {
                loadDisbursementForEdit(editHeaderId);
            }
        }).fail(function() {
            alertify.log('Failed to fetch employee list from API.', 'error', 4000);
        });

        $('#hdr-employee').change(onEmployeeChange);
    });

    function initHeaderDocNo() {
        if (isEditMode) return;

        var d = new Date();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var mmm = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][d.getMonth()];
        var dd = String(d.getDate()).padStart(2, '0');
        var todayStr = dd + '-' + mmm + '-' + d.getFullYear();

        $('#hdr-date').val(todayStr);
        $('#hdr-postdate').val(todayStr);

        var saved = JSON.parse(localStorage.getItem('savedHRDisbursements') || '[]');
        var maxNum = 0;
        saved.forEach(function(item) {
            var dNo = item.docNo || item.disbursementNo || '';
            var match = dNo.match(/\d+$/);
            if (match) {
                var n = parseInt(match[0], 10);
                if (!isNaN(n) && n > maxNum) maxNum = n;
            }
        });
        var nextSeq = Math.max(maxNum, saved.length) + 1;
        $('#hdr-docno').val('DISB-' + mm + '-' + yy + '-' + String(nextSeq).padStart(5, '0'));
    }

    function populateDropdowns() {
        var empSelect = $('#hdr-employee');
        empSelect.empty().append('<option value="">Select Employee...</option>');
        if (Array.isArray(employeesData) && employeesData.length > 0) {
            employeesData.forEach(function(emp) {
                var empId = emp.iMasterId || emp.id || '';
                var empCode = emp.sCode || emp.code || '';
                var empName = emp.sName || emp.name || '';
                empSelect.append(`<option value="${empId}" data-code="${empCode}" data-name="${empName}">${empCode} - ${empName}</option>`);
            });
        }
        empSelect.select2({ width: '100%' });
    }

    function onEmployeeChange() {
        var empVal = $('#hdr-employee').val();
        pendingDisbursements = [];
        renderGrid();

        if (!empVal) {
            $('#hdr-designation, #hdr-department, #hdr-manager').val('');
            return;
        }

        var emp = employeesData.find(e => String(e.id) === String(empVal) || String(e.iMasterId) === String(empVal) || String(e.code) === String(empVal) || String(e.sCode) === String(empVal));
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '-');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '-');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || '-');
        }

        showReturnable();
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 4000);
                input.value = '';
            }
        }
    }

    // "recall the link based on the qty for that employee where it is returnable"
    function showReturnable() {
        var empId = $('#hdr-employee').val();
        if (!empId) {
            pendingDisbursements = [];
            renderGrid();
            alertify.log('Please select an Employee first.', 'error', 3000);
            return;
        }

        function filterRequests(requests) {
            pendingDisbursements = requests.filter(function(req) {
                var matchEmp = String(req.employeeId) === String(empId) || (req.employeeCode && req.employeeCode === empId);
                return matchEmp && req.requestType === 'Returnable' && req.status === 'Pending';
            });
            renderGrid();
            if (pendingDisbursements.length === 0) {
                alertify.log('No pending returnable requests found for this employee.', 'log', 3000);
            } else {
                alertify.log(`Found ${pendingDisbursements.length} pending returnable item(s).`, 'success', 2500);
            }
        }

        var raw = localStorage.getItem('savedHRRequests');
        if (!raw) {
            $.getJSON('/api-assets/hr_requests.json').done(function(seed) {
                if (Array.isArray(seed)) {
                    localStorage.setItem('savedHRRequests', JSON.stringify(seed));
                    filterRequests(seed);
                } else {
                    filterRequests([]);
                }
            }).fail(function() {
                filterRequests([]);
            });
        } else {
            filterRequests(JSON.parse(raw || '[]'));
        }
    }

    // Grid columns strictly: Request Type | Qty | Remarks | Req No
    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();

        if (pendingDisbursements.length === 0) {
            uTbody.append('<tr id="empty-row"><td colspan="5" class="text-center text-muted py-3">No returnable requests found for this employee.</td></tr>');
            return;
        }

        pendingDisbursements.forEach(function(item, index) {
            var typeName = item.selectionName ? `${item.requestType} (${item.selectionName})` : item.requestType;
            var tr = `<tr id="row-disb-${index}">
                <td class="action-btns" style="text-align:center;">
                    <a href="#" class="remove-item-btn" title="Remove from list" onclick="removeFromGrid(${index}); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </td>
                <td><span class="reqtype-badge reqtype-returnable">${typeName}</span></td>
                <td class="num-col font-weight-bold text-primary">${item.qty || 1}</td>
                <td>${item.remarks || '-'}</td>
                <td><strong class="text-primary">${item.reqNo || '-'}</strong></td>
            </tr>`;
            uTbody.append(tr);
        });
    }

    function removeFromGrid(index) {
        pendingDisbursements.splice(index, 1);
        renderGrid();
    }

    function saveDisbursement() {
        if (pendingDisbursements.length === 0) {
            alertify.log('No items selected for disbursement.', 'error', 4500);
            return;
        }

        var empId = $('#hdr-employee').val();
        if (!empId) {
            alertify.log('Please select an Employee.', 'error', 4000);
            return;
        }

        var empOpt = $('#hdr-employee option:selected');
        var empCode = empOpt.data('code') || '';
        var empName = empOpt.data('name') || empOpt.text();
        var docNo = $('#hdr-docno').val();
        var date = $('#hdr-date').val();
        var postDate = $('#hdr-postdate').val();
        var comments = $('#hdr-comments').val() || '';

        var fileInput = document.getElementById('hdr-attachment');
        var attachFileName = (fileInput && fileInput.files.length > 0) ? fileInput.files[0].name : '';

        // 1. Update matched items in savedHRRequests to status 'Disbursed'
        var allRequests = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
        pendingDisbursements.forEach(function(pItem) {
            var match = allRequests.find(r => (r.reqNo && r.reqNo === pItem.reqNo) || (r.id && r.id === pItem.id));
            if (match) {
                match.status = 'Disbursed';
                match.disbursementNo = docNo;
                match.disbursementDate = date;
            }
        });
        localStorage.setItem('savedHRRequests', JSON.stringify(allRequests));

        // 2. Save new record into savedHRDisbursements
        var savedDisbs = JSON.parse(localStorage.getItem('savedHRDisbursements') || '[]');
        if (isEditMode && editHeaderId) {
            savedDisbs = savedDisbs.filter(d => d.id !== editHeaderId && d.docNo !== docNo);
        }

        var newDisb = {
            id: isEditMode ? editHeaderId : Date.now(),
            docNo: docNo,
            disbursementNo: docNo,
            date: date,
            postDate: postDate,
            employeeId: empId,
            employeeCode: empCode,
            employeeName: empName,
            department: $('#hdr-department').val(),
            designation: $('#hdr-designation').val(),
            manager: $('#hdr-manager').val(),
            remarks: comments,
            status: 'Disbursed',
            attachmentName: attachFileName,
            items: pendingDisbursements.map(function(item) {
                return {
                    reqNo: item.reqNo,
                    requestType: item.requestType,
                    selectionName: item.selectionName,
                    qty: item.qty || 1,
                    remarks: item.remarks || '',
                    status: 'Disbursed'
                };
            })
        };

        savedDisbs.push(newDisb);
        localStorage.setItem('savedHRDisbursements', JSON.stringify(savedDisbs));

        sessionStorage.setItem('pendingAlert', JSON.stringify({
            msg: `HR Disbursement ${docNo} for ${empName} saved successfully!`,
            type: 'success'
        }));

        var targetUrl = '@Url.Action("HRDisbursementIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }

    function loadDisbursementForEdit(id) {
        var saved = JSON.parse(localStorage.getItem('savedHRDisbursements') || '[]');
        var match = saved.find(d => d.id === id || String(d.id) === String(id));
        if (match) {
            applyLoadedDisbursement(match);
        } else {
            $.getJSON('/api-assets/hr_disbursements.json').done(function(seed) {
                if (Array.isArray(seed)) {
                    var m = seed.find(d => d.id === id || String(d.id) === String(id));
                    if (m) applyLoadedDisbursement(m);
                }
            });
        }
    }

    function applyLoadedDisbursement(disb) {
        $('#hdr-docno').val(disb.docNo || disb.disbursementNo || '');
        $('#hdr-date').val(disb.date || '');
        $('#hdr-postdate').val(disb.postDate || disb.date || '');
        $('#hdr-comments').val(disb.remarks || disb.comments || '');
        if (disb.remarks) $('#comments-counter').text(disb.remarks.length + '/250');

        $('#hdr-employee').val(disb.employeeId).trigger('change');
        pendingDisbursements = disb.items || [];
        renderGrid();
    }
</script>
