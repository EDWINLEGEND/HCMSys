@{
    ViewData["Title"] = "HR Disbursement List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 4px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }

    .reqtype-badge {
        display: inline-block;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .reqtype-returnable {
        background-color: #fef8e7;
        color: #b78103;
        border: 1px solid #ffeeba;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-hand-holding-usd fa-sm"></i>
                    HR Disbursement List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("HRDisbursement", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New Disbursement
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Disbursements</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-invoice-dollar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Returnable Disbursed</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-returnable">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Employees Covered</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-employees">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Status</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Disbursements List
            </h6>
            <small class="text-muted">Returnable physical assets disbursed to employees</small>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:75px; text-align:center;">Action</th>
                            <th>Disb No</th>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Items Disbursed</th>
                            <th style="text-align:right;">Total Qty</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var table = null;

    $(document).ready(function () {
        var alertData = sessionStorage.getItem('pendingAlert');
        if (alertData) {
            try {
                var p = JSON.parse(alertData);
                alertify.log(p.msg, p.type || 'success', 4000);
            } catch(e) {}
            sessionStorage.removeItem('pendingAlert');
        }

        table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search disbursements...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No HR disbursements found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        loadGridData();

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            
            alertify.confirm('Are you sure you want to delete this disbursement record?', function (e) {
                if (e) {
                    var data = JSON.parse(localStorage.getItem('savedHRDisbursements') || '[]');
                    data.splice(actualIndex, 1);
                    localStorage.setItem('savedHRDisbursements', JSON.stringify(data));
                    localStorage.setItem('savedHRDisbursements_initialized', 'true');
                    loadGridData();
                    alertify.log('Disbursement record deleted successfully.', 'success', 3500);
                }
            });
        });
    });

    function loadGridData() {
        var rawSaved = localStorage.getItem('savedHRDisbursements');
        if (!rawSaved || JSON.parse(rawSaved || '[]').length === 0) {
            var isInitialized = localStorage.getItem('savedHRDisbursements_initialized');
            if (!isInitialized) {
                $.getJSON('/api-assets/hr_disbursements.json').done(function(seedData) {
                    if (Array.isArray(seedData) && seedData.length > 0) {
                        localStorage.setItem('savedHRDisbursements', JSON.stringify(seedData));
                        localStorage.setItem('savedHRDisbursements_initialized', 'true');
                        renderGridRows(seedData);
                        return;
                    }
                    renderGridRows([]);
                }).fail(function() {
                    renderGridRows([]);
                });
                return;
            }
        }
        
        var savedData = JSON.parse(rawSaved || '[]');
        renderGridRows(savedData);
    }

    function renderGridRows(savedData) {
        table.clear();
        
        var total = savedData.length;
        var totalItems = 0;
        var empSet = new Set();
        var activeCount = 0;

        savedData.forEach(function(item) {
            if (item.employeeId) empSet.add(item.employeeId);
            if (item.status === 'Disbursed') activeCount++;
            var itms = item.items || [];
            itms.forEach(function(i) { totalItems += (i.qty || 1); });
        });

        $('#stat-total').text(total);
        $('#stat-returnable').text(totalItems);
        $('#stat-employees').text(empSet.size);
        $('#stat-active').text(activeCount);

        savedData.slice().reverse().forEach(function(item, index) {
            var actualIndex = savedData.length - 1 - index;
            
            var editUrl = '@Url.Action("HRDisbursement", "Master")?id=' + (item.id || actualIndex);
            var actionHtml = `
                <div class="action-btns" style="text-align:center;">
                    <a href="${editUrl}" title="Full Edit"><i class="fas fa-edit"></i></a>
                    <a href="#" class="remove-item-btn" data-idx="${actualIndex}" title="Delete"><i class="fas fa-trash-alt"></i></a>
                </div>
            `;
            
            var itms = item.items || [];
            var itemsHtml = itms.map(function(i) {
                return `<span class="badge badge-secondary mr-1 mb-1 font-weight-normal">${i.selectionName || i.requestType || 'Item'} (${i.reqNo || 'REQ'})</span>`;
            }).join('') || '<span class="text-muted">-</span>';

            var totalQty = itms.reduce((acc, curr) => acc + (curr.qty || 1), 0);

            table.row.add([
                actionHtml,
                '<span class="font-weight-bold text-primary">' + (item.disbursementNo || item.docNo || '-') + '</span>',
                item.date || '-',
                '<span class="font-weight-bold text-dark">' + (item.employeeName || '-') + '</span>',
                itemsHtml,
                '<span class="font-weight-bold" style="float:right;">' + totalQty + '</span>',
                item.remarks || '-',
                '<span class="badge badge-warning text-dark">' + (item.status || 'Disbursed') + '</span>'
            ]);
        });
        table.draw(false);
    }
</script>
