<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .number-align {
        text-align: right;
    }
    input[type="text"], textarea, select { text-align: left; }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-hand-holding fa-sm text-primary mr-2"></i> HR Request & Disbursement
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" onclick="saveRequest()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="requestForm" autocomplete="off">
        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">General</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- REQUEST DETAILS CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom bg-info">Request Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Selection <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-selection" required>
                            <option value="">Select Request...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Request Type</label>
                        <input type="text" class="form-control" id="dtl-requesttype" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="dtl-remarks" />
                    </div>
                    
                    <!-- Hidden Qty field as requested -->
                    <input type="hidden" id="dtl-qty" value="1" />
                    <input type="hidden" id="dtl-prefix" value="" />
                    
                    <div class="col-md-12 text-right mt-2">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary">Requests Detailed</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Selection</th>
                            <th>Request Type</th>
                            <th class="num-col">Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    var employeesData = [];
    var requestMasterData = [];
    var stagedRequests = [];

    $(document).ready(function() {
        initHeader();

        $.when(
            $.getJSON('/Master/GetApiEmployees').then(function(res) { return res && res.length ? res : $.getJSON('/assets/employee.json'); }),
            $.getJSON('/assets/request_master.json')
        ).done(function(empRes, reqRes) {
            employeesData = Array.isArray(empRes) ? empRes : (empRes[0] || empRes);
            requestMasterData = Array.isArray(reqRes) ? reqRes : (reqRes[0] || reqRes);
            
            populateDropdowns();
            $('select.form-control').select2({ width: '100%' });
        }).fail(function() {
            alertify.log('Failed to load data', 'error', 5000);
        });

        $('#hdr-employee').change(onEmployeeChange);
        $('#dtl-selection').change(onSelectionChange);

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });
    });

    function initHeader() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        
        $('#hdr-date').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-postdate').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-docno').val('HRR-' + mm + '-' + yy + '-00001');
    }

    function populateDropdowns() {
        var empSelect = $('#hdr-employee');
        employeesData.forEach(function(emp) {
            empSelect.append(`<option value="${emp.id}">${emp.code} - ${emp.name}</option>`);
        });

        var reqSelect = $('#dtl-selection');
        requestMasterData.forEach(function(req) {
            reqSelect.append(`<option value="${req.code}">${req.name}</option>`);
        });
    }

    function onEmployeeChange() {
        var empId = parseInt($(this).val());
        if (!empId) {
            $('#hdr-designation, #hdr-department, #hdr-manager').val('');
            return;
        }

        var emp = employeesData.find(e => e.id === empId);
        if (emp) {
            $('#hdr-designation').val(emp.designation);
            $('#hdr-department').val(emp.department);
            $('#hdr-manager').val(emp.reportingManager);
        }
    }
    
    function onSelectionChange() {
        var reqCode = $(this).val();
        $('#dtl-requesttype').val('');
        $('#dtl-prefix').val('');
        
        if (!reqCode) {
            return;
        }

        var req = requestMasterData.find(r => r.code === reqCode);
        if (req) {
            $('#dtl-requesttype').val(req.type);
            $('#dtl-prefix').val(req.prefix);
        }
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();
        
        stagedRequests.forEach(function(item) {
            var tr = `<tr>
                <td class="action-btns" style="text-align:center;">
                    <a href="#" class="remove-item-btn" title="Delete" onclick="deleteStagedRequest('${item.stagedId}'); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </td>
                <td>${item.selectionName || '-'}</td>
                <td>${item.requestType || '-'}</td>
                <td class="num-col">${item.qty}</td>
                <td>${item.remarks || '-'}</td>
            </tr>`;
            uTbody.append(tr);
        });
    }

    function deleteStagedRequest(stagedId) {
        alertify.confirm('Are you sure you want to remove this request?', function (e) {
            if (e) {
                stagedRequests = stagedRequests.filter(function(item) { return item.stagedId !== stagedId; });
                renderGrid();
            }
        });
    }

    function addToGrid() {
        var selectionCode = $('#dtl-selection').val();
        
        if(!selectionCode) {
            alertify.log('Please select a request.', 'error', 5000);
            return;
        }

        var selectionName = $('#dtl-selection option:selected').text();
        var requestType = $('#dtl-requesttype').val();
        var prefix = $('#dtl-prefix').val();
        var remarks = $('#dtl-remarks').val();
        var qty = $('#dtl-qty').val();

        var uniqueStagedId = 'id_' + new Date().getTime();

        var newItem = {
            stagedId: uniqueStagedId,
            selectionCode: selectionCode,
            selectionName: selectionName,
            requestType: requestType,
            prefix: prefix,
            qty: qty,
            remarks: remarks
        };

        stagedRequests.push(newItem);
        renderGrid();
        
        // Reset inputs
        $('#dtl-selection').val('').trigger('change');
        $('#dtl-remarks').val('');
    }

    function saveRequest() {
        if (stagedRequests.length === 0) {
            alertify.log('No requests added to the grid.', 'error', 5000);
            return;
        }

        if(!$('#hdr-employee').val()) {
            alertify.log('Please fill required Header fields (Employee).', 'error', 5000);
            return;
        }

        var d = new Date();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);

        var empText = $('#hdr-employee option:selected').text();
        var empParts = empText.split(' - ');
        var empName = empParts.length > 1 ? empParts.slice(1).join(' - ') : empText;

        var newRequests = stagedRequests.map(function(sr) {
            var randId = Math.floor(Math.random() * 100000);
            return {
                docNo: $('#hdr-docno').val(),
                date: $('#hdr-date').val(),
                employeeId: $('#hdr-employee').val(),
                employeeName: empName,
                reqNo: 'REQ-' + mm + '-' + yy + '-' + randId,
                selectionCode: sr.selectionCode,
                selectionName: sr.selectionName,
                requestType: sr.requestType,
                prefix: sr.prefix,
                qty: sr.qty,
                remarks: sr.remarks,
                status: 'Pending'
            };
        });

        var existingRequests = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
        existingRequests = existingRequests.concat(newRequests);
        localStorage.setItem('savedHRRequests', JSON.stringify(existingRequests));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: 'HR Request saved successfully!', type: 'success' }));
        var targetUrl = '@Url.Action("HRRequestIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }
</script>
