@{
    ViewData["Title"] = "HR Request List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 4px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-eye { color: #36b9cc; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }

    .reqtype-badge {
        display: inline-block;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .reqtype-documents {
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
    }
    .reqtype-returnable {
        background-color: #fef8e7;
        color: #b78103;
        border: 1px solid #ffeeba;
    }
    .reqtype-issueonly {
        background-color: #e6f9f0;
        color: #0d8a4f;
        border: 1px solid #c3e6cb;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-hand-holding fa-sm"></i>
                    HR Request & Disbursement List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("HRRequest", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New Request
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Requests</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Documents</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-documents">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Returnable</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-returnable">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-undo fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Issue-Only</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-issueonly">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-box-open fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Requests List
            </h6>
            <small class="text-muted">Live employee data from API &amp; catalog items from JSON</small>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px; text-align:center;">Action</th>
                            <th>Req No</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Request Type</th>
                            <th>Item Name</th>
                            <th style="text-align:right;">Qty</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- VIEW DETAILS MODAL -->
<div class="modal fade" id="view-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-info text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-info-circle mr-2"></i>HR Request Details</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-3">
                <div class="row mb-2">
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Req No</small><div class="font-weight-bold text-primary" id="view-reqno">-</div></div>
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Doc No</small><div class="font-weight-bold text-dark" id="view-docno">-</div></div>
                </div>
                <div class="row mb-2">
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Date</small><div id="view-date">-</div></div>
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Status</small><div id="view-status">-</div></div>
                </div>
                <hr class="my-2" />
                <div class="row mb-2">
                    <div class="col-12"><small class="text-muted text-uppercase font-weight-bold">Employee</small><div class="font-weight-bold text-dark" id="view-employee">-</div></div>
                </div>
                <div class="row mb-2">
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Designation</small><div id="view-designation">-</div></div>
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Department</small><div id="view-department">-</div></div>
                </div>
                <div class="row mb-2">
                    <div class="col-12"><small class="text-muted text-uppercase font-weight-bold">Reporting Manager</small><div id="view-manager">-</div></div>
                </div>
                <hr class="my-2" />
                <div class="row mb-2">
                    <div class="col-6"><small class="text-muted text-uppercase font-weight-bold">Item Name</small><div class="font-weight-bold text-dark" id="view-selection">-</div></div>
                    <div class="col-3"><small class="text-muted text-uppercase font-weight-bold">Type</small><div id="view-type">-</div></div>
                    <div class="col-3"><small class="text-muted text-uppercase font-weight-bold">Qty</small><div class="font-weight-bold text-primary" id="view-qty">-</div></div>
                </div>
                <div class="row mb-2">
                    <div class="col-12"><small class="text-muted text-uppercase font-weight-bold">Line Remarks</small><div id="view-remarks" class="text-muted">-</div></div>
                </div>
                <div class="row mb-2">
                    <div class="col-12"><small class="text-muted text-uppercase font-weight-bold">Header Comments</small><div id="view-comments" class="text-muted">-</div></div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Edit HR Request Status</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-idx" />
                <div class="form-group mb-2">
                    <label class="form-label">Req No</label>
                    <input type="text" class="form-control" id="edit-reqno" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Date</label>
                    <input type="text" class="form-control" id="edit-date" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Employee Name</label>
                    <input type="text" class="form-control" id="edit-employee" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Item Name</label>
                    <input type="text" class="form-control" id="edit-selection" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" class="form-control" id="edit-remarks" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="edit-status">
                        <option value="Pending">Pending</option>
                        <option value="Returned">Returned</option>
                        <option value="Issued">Issued</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="save-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var table = null;

    $(document).ready(function () {
        var alertData = sessionStorage.getItem('pendingAlert');
        if (alertData) {
            try {
                var p = JSON.parse(alertData);
                alertify.log(p.msg, p.type || 'success', 4000);
            } catch(e) {}
            sessionStorage.removeItem('pendingAlert');
        }

        table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search requests...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No HR requests found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        loadGridData();

        // View Details Handler
        $('#data-grid tbody').on('click', '.view-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            var item = savedData[actualIndex];

            if (item) {
                $('#view-reqno').text(item.reqNo || '-');
                $('#view-docno').text(item.docNo || '-');
                $('#view-date').text(item.date || '-');
                $('#view-employee').text((item.employeeCode ? item.employeeCode + ' - ' : '') + (item.employeeName || '-'));
                $('#view-designation').text(item.designation || '-');
                $('#view-department').text(item.department || '-');
                $('#view-manager').text(item.manager || '-');
                $('#view-selection').text(item.selectionName || '-');
                $('#view-type').html('<span class="reqtype-badge reqtype-' + (item.requestType ? item.requestType.toLowerCase() : 'documents') + '">' + (item.requestType || '-') + '</span>');
                $('#view-qty').text(item.qty || '1');
                $('#view-remarks').text(item.remarks || '-');
                $('#view-comments').text(item.comments || '-');
                
                var statusClass = 'badge-primary';
                if (item.status === 'Returned') statusClass = 'badge-info';
                if (item.status === 'Issued') statusClass = 'badge-success';
                $('#view-status').html('<span class="badge ' + statusClass + '">' + (item.status || 'Pending') + '</span>');

                $('#view-modal').modal('show');
            }
        });

        // Quick Edit Status Handler
        $('#data-grid tbody').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            var item = savedData[actualIndex];

            if (item) {
                $('#edit-idx').val(actualIndex);
                $('#edit-reqno').val(item.reqNo || '');
                $('#edit-date').val(item.date || '');
                $('#edit-employee').val(item.employeeName || '');
                $('#edit-selection').val(item.selectionName || '');
                $('#edit-remarks').val(item.remarks || '');
                $('#edit-status').val(item.status || 'Pending');

                $('#edit-modal').modal('show');
            }
        });

        $('#save-edit-btn').click(function() {
            var actualIndex = parseInt($('#edit-idx').val());
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            
            if (savedData[actualIndex]) {
                savedData[actualIndex].remarks = $('#edit-remarks').val();
                savedData[actualIndex].status = $('#edit-status').val();

                localStorage.setItem('savedHRRequests', JSON.stringify(savedData));
                $('#edit-modal').modal('hide');
                loadGridData();
                alertify.log('HR Request status updated.', 'success', 3500);
            }
        });

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            
            alertify.confirm('Are you sure you want to delete this HR request record?', function (e) {
                if (e) {
                    var data = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
                    data.splice(actualIndex, 1);
                    localStorage.setItem('savedHRRequests', JSON.stringify(data));
                    loadGridData();
                    alertify.log('Record deleted successfully.', 'success', 3500);
                }
            });
        });
    });

    function loadGridData() {
        var rawSaved = localStorage.getItem('savedHRRequests');
        if (!rawSaved || JSON.parse(rawSaved || '[]').length === 0) {
            var isInitialized = localStorage.getItem('savedHRRequests_initialized');
            if (!isInitialized) {
                $.getJSON('/api-assets2/hr_requests.json').done(function(seedData) {
                    if (Array.isArray(seedData) && seedData.length > 0) {
                        localStorage.setItem('savedHRRequests', JSON.stringify(seedData));
                        localStorage.setItem('savedHRRequests_initialized', 'true');
                        renderGridRows(seedData);
                        return;
                    }
                    renderGridRows([]);
                }).fail(function() {
                    renderGridRows([]);
                });
                return;
            }
        }
        
        var savedData = JSON.parse(rawSaved || '[]');
        renderGridRows(savedData);
    }

    function renderGridRows(savedData) {
        table.clear();
        
        var total = savedData.length;
        var docs = 0, ret = 0, iss = 0;

        savedData.forEach(function(item) {
            if (item.requestType === 'Documents') docs++;
            else if (item.requestType === 'Returnable') ret++;
            else if (item.requestType === 'Issueonly') iss++;
        });

        $('#stat-total').text(total);
        $('#stat-documents').text(docs);
        $('#stat-returnable').text(ret);
        $('#stat-issueonly').text(iss);

        savedData.slice().reverse().forEach(function(item, index) {
            var actualIndex = savedData.length - 1 - index;
            
            var editUrl = '@Url.Action("HRRequest", "Master")?docNo=' + encodeURIComponent(item.docNo || '') + '&id=' + (item.id || actualIndex);
            var actionHtml = `
                <div class="action-btns" style="text-align:center;">
                    <a href="#" class="view-item-btn" data-idx="${actualIndex}" title="View Details"><i class="fas fa-eye"></i></a>
                    <a href="${editUrl}" title="Full Document Edit"><i class="fas fa-edit"></i></a>
                    <a href="#" class="edit-item-btn" data-idx="${actualIndex}" title="Quick Status Edit"><i class="fas fa-sliders-h text-secondary"></i></a>
                    <a href="#" class="remove-item-btn" data-idx="${actualIndex}" title="Delete"><i class="fas fa-trash-alt"></i></a>
                </div>
            `;
            
            var typeBadgeClass = 'reqtype-documents';
            if (item.requestType === 'Returnable') typeBadgeClass = 'reqtype-returnable';
            if (item.requestType === 'Issueonly') typeBadgeClass = 'reqtype-issueonly';

            var statusBadgeClass = 'badge-primary';
            if (item.status === 'Returned') statusBadgeClass = 'badge-info';
            if (item.status === 'Issued') statusBadgeClass = 'badge-success';

            table.row.add([
                actionHtml,
                '<span class="font-weight-bold text-primary">' + (item.reqNo || '-') + '</span>',
                item.docNo || '-',
                item.date || '-',
                '<span class="font-weight-bold text-dark">' + (item.employeeName || '-') + '</span>',
                '<span class="reqtype-badge ' + typeBadgeClass + '">' + (item.requestType || '-') + '</span>',
                item.selectionName || '-',
                '<span class="font-weight-bold" style="float:right;">' + (item.qty || '1') + '</span>',
                item.remarks || '-',
                '<span class="badge ' + statusBadgeClass + '">' + (item.status || 'Pending') + '</span>'
            ]);
        });
        table.draw(false);
    }
</script>
