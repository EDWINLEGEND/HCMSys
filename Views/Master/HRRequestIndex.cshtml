@{
    ViewData["Title"] = "HR Request List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
</style>

<div class="container-fluid py-3">

    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-hand-holding fa-sm"></i>
                    HR Request List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("HRRequest", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Requests</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Requests
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:70px; text-align:center;">Action</th>
                            <th>Req No</th>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Request Type</th>
                            <th>Item Name</th>
                            <th>Qty</th>
                            <th>Remarks</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Edit HR Request</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-idx" />
                <div class="form-group mb-2">
                    <label class="form-label">Req No</label>
                    <input type="text" class="form-control" id="edit-reqno" readonly />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Date</label>
                    <input type="text" class="form-control" id="edit-date" placeholder="e.g. 18-Jul-2026" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Employee Name</label>
                    <input type="text" class="form-control" id="edit-employee" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Request Type</label>
                    <input type="text" class="form-control" id="edit-reqtype" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Item Name</label>
                    <input type="text" class="form-control" id="edit-selection" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Qty</label>
                    <input type="number" class="form-control" id="edit-qty" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" class="form-control" id="edit-remarks" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="edit-status">
                        <option value="Pending">Pending</option>
                        <option value="Returned">Returned</option>
                        <option value="Issued">Issued</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="save-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No requests found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        function loadGridData() {
            table.clear();
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            $('#stat-total').text(savedData.length);

            savedData.reverse().forEach(function(item, index) {
                var actualIndex = savedData.length - 1 - index;
                
                var actionHtml = `
                    <div class="action-btns" style="text-align:center;">
                        <a href="#" class="edit-item-btn" data-idx="${actualIndex}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                        <a href="#" class="remove-item-btn" data-idx="${actualIndex}" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                    </div>
                `;
                
                var badgeClass = 'badge-primary';
                if(item.status === 'Returned') badgeClass = 'badge-info';
                if(item.status === 'Issued') badgeClass = 'badge-success';

                table.row.add([
                    actionHtml,
                    item.reqNo || '-',
                    item.date || '-',
                    item.employeeName || '-',
                    item.requestType || '-',
                    item.selectionName || '-',
                    item.qty || '1',
                    item.remarks || '-',
                    '<span class="badge ' + badgeClass + '">' + (item.status || 'Pending') + '</span>'
                ]);
            });
            table.draw(false);
        }

        loadGridData();

        // Edit Handler
        $('#data-grid tbody').on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            var item = savedData[actualIndex];

            if (item) {
                $('#edit-idx').val(actualIndex);
                $('#edit-reqno').val(item.reqNo || '');
                $('#edit-date').val(item.date || '');
                $('#edit-employee').val(item.employeeName || '');
                $('#edit-reqtype').val(item.requestType || '');
                $('#edit-selection').val(item.selectionName || '');
                $('#edit-qty').val(item.qty || '1');
                $('#edit-remarks').val(item.remarks || '');
                $('#edit-status').val(item.status || 'Pending');

                $('#edit-modal').modal('show');
            }
        });

        $('#save-edit-btn').click(function() {
            var actualIndex = parseInt($('#edit-idx').val());
            var savedData = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
            
            if (savedData[actualIndex]) {
                savedData[actualIndex].date = $('#edit-date').val();
                savedData[actualIndex].employeeName = $('#edit-employee').val();
                savedData[actualIndex].requestType = $('#edit-reqtype').val();
                savedData[actualIndex].selectionName = $('#edit-selection').val();
                savedData[actualIndex].qty = $('#edit-qty').val();
                savedData[actualIndex].remarks = $('#edit-remarks').val();
                savedData[actualIndex].status = $('#edit-status').val();

                localStorage.setItem('savedHRRequests', JSON.stringify(savedData));
                $('#edit-modal').modal('hide');
                loadGridData();
                alertify.log('HR Request updated successfully.', 'success', 5000);
            }
        });

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            
            alertify.confirm('Are you sure you want to delete this record?', function (e) {
                if (e) {
                    var data = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
                    data.splice(actualIndex, 1);
                    localStorage.setItem('savedHRRequests', JSON.stringify(data));
                    loadGridData();
                    alertify.log('Record deleted successfully.', 'success', 5000);
                }
            });
        });
    });
</script>
