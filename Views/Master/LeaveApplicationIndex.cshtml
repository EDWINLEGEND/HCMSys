<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Leave Applications</title>

    <!-- Bootstrap 4 & DataTables -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
    <link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

    <style>
        html { font-size: 14px; }

        /* ── Page Title Bar ── */
        .page-title-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }
        .page-title-bar .page-title-text {
            font-size: 0.85rem;
            font-weight: 800;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .page-title-bar .page-title-text i { color: #4e73df; }
        .page-title-bar .btn-group-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* ── Table Enhancements ── */
        #tblLeave thead th {
            background-color: #4e73df;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-color: #3d5cbe;
            vertical-align: middle;
        }
        #tblLeave tbody tr:hover { background-color: #f0f3ff; }
        #tblLeave td {
            font-size: 0.82rem;
            color: #5a5c69;
            vertical-align: middle;
        }
        .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
        .action-btns a:hover { opacity: 0.7; }
        .action-btns .fa-edit      { color: #4e73df; }
        .action-btns .fa-trash-alt { color: #e74a3b; }

        /* ── Stat Cards ── */
        .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
        .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
        .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
        .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }

        .badge-primary { background-color: #4e73df; }
        .badge-success { background-color: #1cc88a; color: white; }
        .badge-warning { background-color: #f6c23e; color: white; }
        .badge-danger { background-color: #e74a3b; color: white; }
        .text-gray-800 { color: #5a5c69 !important; }
        .text-gray-300 { color: #dddfeb !important; }
    </style>
</head>
<body style="background:#f8f9fc;">
<div class="container-fluid py-3">

    <!-- ════════════════════════════
         PAGE HEADER CARD
    ════════════════════════════ -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-calendar-alt fa-sm"></i>
                    Leave Application
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("CreateLeaveApplication", "Master")"
                       class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> New Application
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════
         STAT CARDS
    ════════════════════════════ -->
    <div class="row mb-3">
        <!-- Total -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Leaves</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Approved -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Approved</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-modified">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Module -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Module</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Leave</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════
         DATA TABLE CARD
    ════════════════════════════ -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Leave Applications
            </h6>
            <span class="badge badge-primary" id="record-count-badge">0 Records</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblLeave"
                       class="table table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width: 80px; text-align:center;">Action</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Post Date</th>
                            <th>Employee Name</th>
                            <th>Leave Type</th>
                            <th class="text-right">Duration (Days)</th>
                            <th>Document</th>
                            <th>Comments</th>
                            <th style="text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div><!-- /container-fluid -->

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script defer src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<script>
    var leaveDataTable = null;
    var rawLeaveTransactions = [];

    $(document).ready(function () {
        initDataTable();
        loadLeaveTransactions();
    });

    function initDataTable() {
        if ($.fn.DataTable.isDataTable('#tblLeave')) {
            $('#tblLeave').DataTable().destroy();
        }

        leaveDataTable = $('#tblLeave').DataTable({
            order: [[0, 'desc']],
            pageLength: 15,
            language: {
                search: "",
                searchPlaceholder: "Search leaves...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ applications",
                emptyTable: "No leave records found"
            },
            columnDefs: [
                { className: "action-btns text-center", targets: 0 },
                { className: "text-right", targets: 6 },
                { className: "text-center", targets: 9 }
            ]
        });
    }

    function loadLeaveTransactions() {
        $.getJSON('/Master/GetApiLeaveTransactions').done(function(res) {
            rawLeaveTransactions = Array.isArray(res) ? res : ((res && res.data) ? res.data : []);
            renderTableData();
        }).fail(function() {
            if (typeof alertify !== 'undefined') {
                alertify.log('Failed to load leave transactions from server.', 'error', 5000);
            }
        });
    }

    function renderTableData() {
        if (!leaveDataTable) return;
        leaveDataTable.clear();

        var approvedCount = 0;
        var pendingCount = 0;

        rawLeaveTransactions.forEach(function(tx) {
            var headerId = tx.iHeaderId || tx.id || 0;
            var docNo = tx.sDocNo || tx.docNo || ('LVS' + String(headerId).padStart(6, '0'));
            var docDate = window.formatDateDisplay(tx.dDocDate || tx.docDate);
            var postDate = window.formatDateDisplay(tx.dPostDate || tx.postDate);
            var comments = tx.sComments || tx.comments || '-';
            
            var leavesList = tx.leaves || tx.Leaves || [];
            var empNames = [];
            var leaveTypes = [];
            var totalDuration = 0;

            leavesList.forEach(function(l) {
                var emp = l.sEmployeeName || l.employeeName;
                if (emp && !empNames.includes(emp)) empNames.push(emp);
                var lt = l.sLeaveTypeName || l.leaveTypeName || l.sRemarks || 'Leave';
                if (lt && !leaveTypes.includes(lt)) leaveTypes.push(lt);
                var dur = parseFloat(l.fDuration || l.duration || 0);
                totalDuration += dur;
            });

            var displayEmpName = empNames.length > 0 ? empNames.join(', ') : 'Employee #' + (leavesList[0]?.iEmployeeId || '-');
            var displayLeaveType = leaveTypes.length > 0 ? leaveTypes.join(', ') : 'Leave Application';

            // Document Attachment
            var fileObj = tx.leaveFile || tx.LeaveFile || tx.attachment || tx.Attachment;
            var docBtn = '<span class="badge badge-secondary shadow-sm"><i class="fas fa-file mr-1"></i> No File</span>';
            if (fileObj && fileObj.sAttachmentFilePath) {
                var safeUrl = (fileObj.sAttachmentFilePath || '').replace(/'/g, "\\'");
                var safeName = (fileObj.sAttachmentFileName || 'LeaveAttachment.pdf').replace(/'/g, "\\'");
                docBtn = '<a href="javascript:void(0)" onclick="window.openDocPreview(\'' + safeName + '\', \'' + safeUrl + '\')" class="badge badge-info shadow-sm"><i class="fas fa-paperclip mr-1"></i> ' + (fileObj.sAttachmentFileName || 'View File') + '</a>';
            }

            var isApproved = (tx.iAuthStatus === 1 || tx.authStatus === 1 || tx.iStatus === 1);
            var statusBadge = isApproved 
                ? '<span class="badge badge-success">Approved</span>' 
                : '<span class="badge badge-warning">Pending</span>';

            if (isApproved) approvedCount++;
            else pendingCount++;

            var actionBtns = `
                <a href="javascript:void(0)" class="edit-item-btn" title="Edit Application" onclick="editLeaveApplication(${headerId})"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                <a href="javascript:void(0)" class="remove-item-btn" title="Delete Application" onclick="deleteLeaveApplication(${headerId}, '${docNo}')"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
            `;

            leaveDataTable.row.add([
                actionBtns,
                `<strong>${docNo}</strong>`,
                docDate,
                postDate,
                displayEmpName,
                displayLeaveType,
                totalDuration.toFixed(1),
                docBtn,
                comments,
                statusBadge
            ]);
        });

        leaveDataTable.draw(false);

        // Update Stat Cards
        var totalRows = rawLeaveTransactions.length;
        $('#stat-total').text(totalRows);
        $('#stat-active').text(approvedCount);
        $('#stat-modified').text(pendingCount);
        $('#record-count-badge').text(totalRows + ' Records');
    }

    function editLeaveApplication(headerId) {
        var createUrl = '@Url.Action("CreateLeaveApplication", "Master")' + '?id=' + headerId;
        if (typeof loadPageContent === 'function') {
            loadPageContent(createUrl, true);
        } else {
            window.location.href = createUrl;
        }
    }

    function deleteLeaveApplication(headerId, docNo) {
        if (!headerId || headerId <= 0) return;

        alertify.confirm('Are you sure you want to delete Leave Application: ' + docNo + '?', function (e) {
            if (e) {
                $.post('/Master/DeleteApiLeaveTransaction', { id: headerId }, function(res) {
                    if (res && res.success) {
                        alertify.log('Leave Application ' + docNo + ' deleted successfully.', 'success', 3000);
                        loadLeaveTransactions();
                    } else {
                        var msg = (res && res.message) ? res.message : 'Failed to delete leave application.';
                        alertify.log(msg, 'error', 5000);
                    }
                }).fail(function(xhr) {
                    alertify.log('Error communicating with server: ' + (xhr.responseText || 'Server error'), 'error', 5000);
                });
            }
        });
    }
</script>
</body>
</html>
