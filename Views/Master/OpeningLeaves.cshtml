@{
    ViewData["Title"] = "Opening Leaves";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-calendar-plus fa-sm text-primary mr-2"></i> Opening Leaves
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("OpeningLeavesIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" onclick="saveRecord()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="entryForm" autocomplete="off">
        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">General Information</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- INLINE EDITABLE GRID CARD -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex align-items-center justify-content-between">
            <span><i class="fas fa-list mr-2"></i>Opening Leaves Detailed</span>
            <button type="button" class="btn btn-light btn-sm font-weight-bold text-primary shadow-sm" onclick="addRow()">
                <i class="fas fa-plus fa-sm mr-1"></i> Add Row
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50px; text-align:center;">Action</th>
                            <th style="min-width: 200px;">Employee <span class="text-danger">*</span></th>
                            <th style="min-width: 180px;">Leave Type <span class="text-danger">*</span></th>
                            <th style="width: 130px;" class="text-right">Duration <span class="text-danger">*</span></th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var employeesData = [];
    var leaveTypesData = [];

    $(document).ready(function() {
        initHeader();

        $.when(
            $.getJSON('/assets/employee.json'),
            $.getJSON('/assets/leavetype.json')
        ).done(function(empRes, leaveRes) {
            employeesData = empRes[0] || [];
            leaveTypesData = leaveRes[0].leaveTypes || [];
            
            // Automatically add initial clean row
            addRow();
        }).fail(function() {
            alertify.log('Failed to load JSON data from /assets/', 'error', 5000);
        });

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });
    });

    function initHeader() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        var randId = Math.floor(Math.random() * 90000) + 10000;
        
        $('#hdr-date').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-postdate').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-docno').val('OL-' + mm + '-' + yy + '-' + randId);
    }

    function addRow() {
        var tbody = $('#user-grid-table tbody');
        
        var empOptions = '<option value="">Select Employee...</option>';
        employeesData.forEach(function(emp) {
            empOptions += `<option value="${emp.id}">${emp.code} - ${emp.name}</option>`;
        });

        var leaveOptions = '<option value="">Select Leave Type...</option>';
        leaveTypesData.forEach(function(lt) {
            leaveOptions += `<option value="${lt.id}">${lt.code} - ${lt.name}</option>`;
        });

        var rowId = 'row_' + new Date().getTime() + '_' + Math.floor(Math.random()*1000);

        var trHtml = `<tr id="${rowId}">
            <td class="action-btns" style="text-align:center;">
                <a href="#" class="remove-item-btn" title="Delete Row" onclick="deleteRow('${rowId}'); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
            </td>
            <td>
                <select class="form-control form-control-sm grid-employee">${empOptions}</select>
            </td>
            <td>
                <select class="form-control form-control-sm grid-leavetype">${leaveOptions}</select>
            </td>
            <td>
                <input type="number" step="0.5" class="form-control form-control-sm text-right grid-duration" placeholder="0.0" />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm grid-remarks" placeholder="Enter remarks..." />
            </td>
        </tr>`;

        tbody.append(trHtml);
        $('#' + rowId + ' select').select2({ width: '100%' });
    }

    function deleteRow(rowId) {
        if ($('#user-grid-table tbody tr').length <= 1) {
            alertify.log('At least one row must remain in the grid.', 'error', 5000);
            return;
        }
        $('#' + rowId).remove();
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function saveRecord() {
        var rows = $('#user-grid-table tbody tr');
        if (rows.length === 0) {
            alertify.log('No items added to the grid.', 'error', 5000);
            return;
        }

        var docNo = $('#hdr-docno').val();
        var date = $('#hdr-date').val();
        var comments = $('#hdr-comments').val();

        var newRecords = [];
        var isValid = true;

        rows.each(function() {
            var empId = $(this).find('.grid-employee').val();
            var leaveTypeId = $(this).find('.grid-leavetype').val();
            var duration = $(this).find('.grid-duration').val();
            var remarks = $(this).find('.grid-remarks').val();

            if (!empId || !leaveTypeId || !duration || parseFloat(duration) <= 0) {
                isValid = false;
                return false;
            }

            var empObj = employeesData.find(e => e.id == empId);
            var leaveObj = leaveTypesData.find(l => l.id == leaveTypeId);

            var empName = empObj ? (empObj.code + ' - ' + empObj.name) : 'Employee';
            var leaveTypeName = leaveObj ? (leaveObj.code + ' - ' + leaveObj.name) : 'Leave';

            newRecords.push({
                docNo: docNo,
                date: date,
                comments: comments,
                employeeId: empId,
                employeeName: empName,
                leaveTypeId: leaveTypeId,
                leaveTypeName: leaveTypeName,
                duration: duration,
                remarks: remarks,
                status: 'Active'
            });
        });

        if (!isValid) {
            alertify.log('Please select Employee, Leave Type and enter a valid Duration in all grid rows.', 'error', 5000);
            return;
        }

        var existingData = JSON.parse(localStorage.getItem('savedOpeningLeaves') || '[]');
        existingData = existingData.concat(newRecords);
        localStorage.setItem('savedOpeningLeaves', JSON.stringify(existingData));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: 'Opening Leaves saved successfully!', type: 'success' }));
        var targetUrl = '@Url.Action("OpeningLeavesIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }
</script>
