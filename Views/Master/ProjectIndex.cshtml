@model IEnumerable<HCMSys.Models.vmHCM_Project>
@using Microsoft.AspNetCore.Http;
@{
    string detailsUrl = Url.Action("DownloadExcel", "Common", new { id = 7 });
}

<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }
    /* ── Loading Overlay ── */
/*     #loading {
        display: none;
        position: fixed;
        left: 0; top: 0;
        width: 100%; height: 100%;
        background: rgba(255,255,255,0.85);
        z-index: 9999;
    } */
    #loading {    display: none;    position: fixed;    left: 0;    top: 0;    width: 100%;    height: 100%;    background: rgba(0, 0, 0, 0.08);  /* very subtle dark tint */    z-index: 9999;}
    #loadingcontent {
        display: table;
        position: fixed;
        left: 0; top: 0;
        width: 100%; height: 100%;
    }
    #loadingspinner {
        display: table-cell;
        vertical-align: middle;
        text-align: center;
        font-size: 1.1rem;
    }
    #loadingspinner::after {    content: '';    display: inline-block;    width: 48px;    height: 48px;    border: 5px solid #e3e6f0;    border-top-color: #4e73df;   /* SB Admin 2 primary blue */    border-radius: 50%;    animation: spin 0.75s linear infinite;}
    keyframes spin {    to { transform: rotate(360deg); }}

    /* ── Page Title Bar ── */
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i {
        color: #4e73df;
    }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Table Enhancements ── */
    #tblProject thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #tblProject tbody tr:hover {
        background-color: #f0f3ff;
    }
    #tblProject td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a {
        margin: 0 3px;
        transition: opacity 0.15s;
    }
    .action-btns a:hover {
        opacity: 0.7;
    }
    .action-btns .fa-edit    { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    /* ── Modal Header Override ── */
    .modal-header-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        border-bottom: none;
        padding: 14px 20px;
    }
    .modal-header-primary .modal-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .modal-header-primary .close-modal-btn {
        color: rgba(255,255,255,0.8);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        line-height: 1;
        transition: color 0.15s;
    }
    .modal-header-primary .close-modal-btn:hover {
        color: #fff;
    }
    .modal-footer-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        padding: 8px 20px;
        border-top: none;
    }

    /* ── Form Label Style ── */
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control {
        font-size: 0.85rem;
        border-color: #d1d3e2;
        color: #6e707e;
        border-radius: 0.35rem;
    }
    .form-control:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2);
    }

    /* ── Stat Cards (SB Admin 2 style) ── */
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
</style>

<!-- ════════════════════════════════════════════
     PAGE HEADER CARD
════════════════════════════════════════════ -->
<div class="container-fluid">

    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-id-badge fa-sm"></i>
                    Project Master
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
 
                    <a href="#"
                       class="btn btn-success btn-sm shadow-sm"
                       onclick="clearFieldsWithModal()"
                       data-toggle="modal"
                       data-target="#Project-modal">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         STAT CARDS ROW
    ════════════════════════════════════════════ -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Projects
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Records
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Last Modified
                            </div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800" id="stat-modified">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Module
                            </div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">Project</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-sitemap fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         MAIN DATA TABLE CARD
    ════════════════════════════════════════════ -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Project Records
            </h6>
            <span class="badge badge-primary" id="record-count-badge">
                @(Model != null ? Model.Count().ToString() : "0") Records
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblProject"
                       class="table table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px; text-align:center;">Action</th>
                            <th style="width:60px;">Id</th>
                            <th style="width:100px;">Code</th>
                            <th>Name</th>
                            <th style="width:130px;">Created By</th>
                            <th style="width:140px;">Created Date</th>
                            <th style="width:130px;">Modified By</th>
                            <th style="width:140px;">Modified Date</th>
                            <th style="display:none">ArabicName</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="action-btns" style="text-align:center;">
                                    <a href="#"
                                       class="edit-item-btn"
                                       data-toggle="modal"
                                       data-target="#Project-modal"
                                       title="Edit Project">
                                        <i class="fas fa-edit fa-sm fa-fw"></i>
                                    </a>
                                    <a href="#"
                                       class="remove-item-btn"
                                       title="Delete Project">
                                        <i class="fas fa-trash-alt fa-sm fa-fw"></i>
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.iMasterId)</td>
                                <td>@Html.DisplayFor(modelItem => item.sCode)</td>
                                <td>@Html.DisplayFor(modelItem => item.sName)</td>
                                <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.ModifiedBy)</td>
                                <td>@Html.DisplayFor(modelItem => item.ModifiedDate)</td>
                                <td style="display:none">@Html.DisplayFor(modelItem => item.sArabicName)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════
         ADD / UPDATE MODAL
    ════════════════════════════════════════════ -->
    <div class="modal fade"
         id="Project-modal"
         aria-labelledby="Project-modal-label"
         aria-hidden="true"
         role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header modal-header-primary d-flex align-items-center justify-content-between">
                    <h6 class="modal-title" id="Project-modal-label">
                        <i class="fas fa-id-badge mr-2"></i>Add New Project
                    </h6>
                    <a href="#"
                       class="close-modal-btn"
                       id="btn-close-modal"
                       data-dismiss="modal"
                       aria-label="Close"
                       onclick="clearFieldsWithModal()">
                        <i class="fas fa-times"></i>
                    </a>
                </div>

                <div class="modal-body px-4 py-3">
                    <form autocomplete="off">
                        <div class="form-group mb-3">
                            <label class="form-label" for="code-field">Code</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Auto-generated code"
                                   id="code-field"
                                   required
                                   readonly>
                            <small class="form-text text-muted">Code is auto-generated by the system.</small>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" for="name-field">Name</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter project name"
                                   id="name-field"
                                   required>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" for="arabic-field">Name (Native Lng)</label>
                            <input type="text" dir="rtl"
                                   class="form-control"
                                   placeholder="Enter project name"
                                   id="arabic-field" style="text-align:right;"
                                   >
                        </div>
                        <!-- Hidden fields -->
                        <input type="hidden" id="id-field" value="0">
                        <input type="hidden" id="createdby-field">
                        <input type="hidden" id="createddate-field">
                        <input type="hidden" id="modifiedby-field">
                        <input type="hidden" id="modifieddate-field">
                        <input type="hidden" id="userid" name="userid" value="@Context.Session.GetString("userid")" />

                        <hr class="my-3">
                        <div class="d-flex justify-content-end" style="gap:8px;">
                            <button type="button"
                                    class="btn btn-success btn-sm px-4"
                                    id="add-btn">
                                <i class="fas fa-plus mr-1"></i> Add
                            </button>
                            <button type="button"
                                    class="btn btn-danger btn-sm px-4"
                                    data-dismiss="modal"
                                    aria-label="Close"
                                    onclick="clearFieldsWithModal()">
                                <i class="fas fa-times mr-1"></i> Close
                            </button>
                        </div>
                    </form>
                </div>

                <div class="modal-footer modal-footer-primary py-2"></div>
            </div>
        </div>
    </div>

   

<!-- ════════════════════════════════════════════
     LOADING OVERLAY
════════════════════════════════════════════ -->
 
<section>
    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner"></p>
        </div>
    </div>
</section>
<!-- ════════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════════ -->
<script src="https://code.jquery.com/jquery-3.5.1.js"></script>
<script defer src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script defer src="https://cdn.datatables.net/rowgroup/1.2.0/js/dataTables.rowGroup.min.js"></script>

<script>
    var LoginId = "";

    $(document).ready(function () {
        var table = $('#tblProject').DataTable({
            order: [[1, 'desc']],
            pageLength: 15,
            language: {
                search: "",
                searchPlaceholder: "Search projects...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ projects",
                emptyTable: "No project records found"
            },
            columnDefs: [
                { orderable: false, targets: 0 }
            ]
        });

        // Update stat cards
        var totalRows = table.rows().count();
        $('#stat-total').text(totalRows);
        $('#stat-active').text(totalRows);
        $('#record-count-badge').text(totalRows + ' Records');

        // Last modified date from first row (sorted desc)
        var firstRow = table.row(0).data();
        if (firstRow) {
            var lastMod = $(table.row(0).node()).find('td').eq(7).text().trim();
            $('#stat-modified').text(lastMod || 'N/A');
        }

        // Custom file input label update
        $(document).on('change', '#file-field', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').html(fileName || 'Choose file...');
        });

        getNo();
        LoginId = $("#userid").val();
    });

    /* ── Clear field helpers ── */
    function clearFields() {
        $('#code-field').val("");
        $('#name-field').val("");
        $('#arabic-field').val("");
        $('#file-field').val("");
        $('.custom-file-label').html('Choose file...');
        $('#id-field').val(0);
        $('#add-btn').html('<i class="fas fa-plus mr-1"></i> Add');
        $('#Project-modal-label').html('<i class="fas fa-id-badge mr-2"></i>Add New Project');
        $('#code-field').prop("disabled", false);
    }

    function clearFieldsWithModal() {
        getNo();
        $('#code-field').val("");
        $('#name-field').val("");
        $('#arabic-field').val("");
        $('#id-field').val(0);
        $('#add-btn').html('<i class="fas fa-plus mr-1"></i> Add');
        $('#Project-modal-label').html('<i class="fas fa-id-badge mr-2"></i>Add New Project');
        $('#code-field').prop("disabled", false);
    }

    /* ── Fetch next code ── */
    function getNo() {
        $('#loading').fadeIn();
        var fdata = { id: 7 };
        $.ajax({
            url: "@Url.Action("getCode", "Common")",
            method: 'GET',
            data: fdata,
            dataType: "json",
            success: function (response) {
                $('#code-field').val(response);
            },
            complete: function () {
                $('#loading').fadeOut();
            }
        });
    }
 

    /* ── Edit row click ── */
    $(document).on('click', 'a.edit-item-btn', function (event) {
        event.preventDefault();
        var currentRow = $(this).closest("tr");
        clearFields();

        $('#add-btn').html('<i class="fas fa-sync-alt mr-1"></i> Update');
        $('#Project-modal-label').html('<i class="fas fa-edit mr-2"></i>Update Project');

        var sCode = currentRow.find("TD").eq(2).text().replace(/&amp;/g, '&').trim();
        var sName = currentRow.find("TD").eq(3).text().replace(/&amp;/g, '&').trim();
        var id    = currentRow.find("TD").eq(1).text().replace(/&amp;/g, '&').trim();
        var arabic = currentRow.find("TD").eq(8).text().replace(/&amp;/g, '&').trim();

        $('#code-field').prop("disabled", true);
        $('#code-field').val(sCode);
        $('#name-field').val(sName);
        $('#arabic-field').val(arabic);
        $('#id-field').val(id);

        return false;
    });

    /* ── Add / Update button ── */
    $('#add-btn').click(function () {
        var code = $("#code-field").val();
        var id   = $('#id-field').val();
        var name = $("#name-field").val();
        var arabic = $('#arabic-field').val();
        var sts  = $(this).text().trim();

        var flg  = 0;

        if (!code) {
            alertify.log("Code cannot be blank", "error", 600);
            return false;
        }
        if (!name) {
            alertify.log("Name cannot be blank", "error", 600);
            return false;
        }

        $('#loading').fadeIn();

        var arrList = {
            iMasterId   : id,
            sCode       : code,
            sName       : name,
            sArabicName : arabic,
            iCreatedby  : LoginId,
            iModifiedBy : LoginId
        };

        var actionUrl = (sts == "Update")
            ? "@Url.Action("UpdateProject", "Master")"
            : "@Url.Action("CreateProject", "Master")";

        $.ajax({
            method: "POST",
            url: actionUrl,
            data: arrList,
            dataType: "json",
            success: function (r) {
                if (r != null && r != "") {
                    if (r == "Invalid Session") {
                        location.href = '@Url.Action("Logout", "Login")';
                    } else {
                        alertify.log(r, "error", 600);
                    }
                } else {
                    var msg = (sts == "Update")
                        ? code + " - Project Updated Successfully"
                        : code + " - Project Created Successfully";
                    alertify.set({ delay: 600 });
                    alertify.log(msg, "success", 600);
                    flg = 1;
                    location.href = '@Url.Action("ProjectIndex", "Master")';
                }
            },
            error: function () {
                alertify.log("An error occurred. Please try again.", "error", 600);
            },
            complete: function () {
                if (flg == 1) {
                    $('#Project-modal').modal('hide');
                    clearFields();
                }
                $('#loading').fadeOut();
            }
        });

        return false;
    });

    /* ── Delete row click ── */
    $(document).on('click', 'a.remove-item-btn', function (event) {
        event.preventDefault();
        var currentRow = $(this).closest("tr");
        var code = currentRow.find("TD").eq(2).text().replace(/&amp;/g, '&').trim();
        var id   = currentRow.find("TD").eq(1).text().replace(/&amp;/g, '&').trim();

        if (!confirm('Are you sure you want to delete: ' + code + '?')) {
            return false;
        }

        var flg = 0;
        $('#loading').fadeIn();

        $.ajax({
            method: "POST",
            url: "@Url.Action("DeleteProject", "Master")",
            data: { iMasterId: id, UserId: LoginId },
            dataType: "json",
            success: function (result) {
                if (result.result != "Project Deleted Successfully") {
                    alertify.log(code + " - Delete Operation Failed", "error", 600);
                } else {
                    alertify.log(code + " - " + result.result, "success", 600);
                    flg = 1;
                    location.href = '@Url.Action("ProjectIndex", "Master")';
                }
            },
            error: function () {
                alertify.log("Error during delete. Please try again.", "error", 600);
            },
            complete: function () {
                if (flg == 1) { clearFields(); }
                $('#loading').fadeOut();
            }
        });

        return false;
    });
</script>