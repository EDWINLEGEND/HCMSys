@model MployTracker.Web.Models.vmSer_Complaints
<script src="~/lib/jquery.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<script defer src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<script src="~/lib/sweetalert-dev.js"></script>
<link href="~/lib/sweetalert.css" rel="stylesheet" />
<script src="~/scripts/FClient.js"></script>

<section class="content-header">
    <h1>
        Complaints
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Home</a></li>
        <li><a href="@Url.Action("ComplaintIndex", "Master")">Complaints List</a></li>
        <li class="active">Complaints</li>
    </ol>
</section>
<!-- Main content -->
<section class="content container-fluid">
    <!-- Horizontal Form -->
    <div class="box box-success">
        <div class="box-header with-border">
            <h3 class="box-title">Update Complaint</h3>
        </div>
        <!-- /.box-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="box-body">
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Code</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="sCode" name="Code" value="@Model.sCode" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Name</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="sName" name="Name" placeholder="Name" value="@Model.sName">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Instructions</label>
                    <div class="col-sm-10">
                        <textarea class="form-control" name="Instructions" placeholder="Instructions" id="Instrs">@Model.Instructions</textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label">Std Hours</label>
                    <div class="col-sm-10">
                        <input type="number" class="form-control" id="StdHrs" name="StdHrs" placeholder="0" value="@Model.StdHours">
                    </div>
                </div>
                <input type="hidden" id="iMasterId" name="Id" value="@Model.iMasterId" />
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
                <button type="button" id="btnUpdate" class="btn btn-info pull-right">Update</button>
            </div>
            <!-- /.box-footer -->
        </form>
    </div>
    <!-- /.box -->
</section>

<script>
        var companyId = 0;
        var sessionId = "";
        var LoginId = 0;
        $(document).ready(function () {
            debugger;
            getLoginDetails();
            $("#sName").focus();
        });
        function getLoginDetails() {
            Focus8WAPI.getGlobalValue("getLoginDetailsCallback", "", 1);
        }
        function getLoginDetailsCallback(response) {
            try {
                console.log("response", response);
                companyId = response.data.CompanyId;
                sessionId = response.data.SessionId;
                LoginId = response.data.LoginId;

            } catch (e) {
                console.log(e)
            }
        }
        $('#btnCancel').click(function () {
            location.href ='@Url.Action("ComplaintIndex", "Master")';
        });
        $('#btnUpdate').click(function () {
            debugger;
            var iMId = $('#iMasterId').val();
            var Name = $('#sName').val();
            var stdhrs = $('#StdHrs').val();
            var instr = $('#Instrs').val();

            var fdata = { iMasterId: iMId, sName: Name, Instrs:instr, StdHrs: stdhrs, SessionId: sessionId, UserId: LoginId };
            console.log(iMId);

            $.ajax({
                method: "POST",
                url: "@Url.Action("UpdateComplaint", "Master")",
                data:  fdata ,
                dataType: "json",
                success: function (r) {
                     //alert(r);
                },
                complete: function () {
                    location.href = '@Url.Action("ComplaintIndex", "Master")';
                },
                error: function () {
                     alert("Error in update...");
                     return;
                }
            });

        });
</script>

