    <script>
        function updateActiveSidebar(targetUrl) {
            var currentPath = new URL(targetUrl || window.location.href, window.location.origin).pathname.toLowerCase();

            $('#accordionSidebar .nav-item').removeClass('active');
            $('#accordionSidebar .collapse-item').removeClass('active');

            var foundMatch = false;

            $('#accordionSidebar a.nav-link, #accordionSidebar a.collapse-item').each(function () {
                var href = $(this).attr('href');
                if (href && href !== '#' && href !== 'javascript:void(0);' && !$(this).attr('data-toggle')) {
                    try {
                        var linkPath = new URL(href, window.location.origin).pathname.toLowerCase();

                        var cleanCurrent = currentPath.replace(/\/+$/, '').replace(/index$/, '');
                        var cleanLink = linkPath.replace(/\/+$/, '').replace(/index$/, '');

                        var isMatch = (currentPath === linkPath) || 
                                      (cleanCurrent.length > 1 && cleanLink.length > 1 && cleanCurrent === cleanLink);

                        if (isMatch && !foundMatch) {
                            foundMatch = true;
                            if ($(this).hasClass('collapse-item')) {
                                $(this).addClass('active');
                                var parentCollapse = $(this).closest('.collapse');
                                parentCollapse.addClass('show');
                                parentCollapse.prev('a.nav-link').removeClass('collapsed').attr('aria-expanded', 'true');
                                parentCollapse.closest('.nav-item').addClass('active');
                            } else {
                                $(this).closest('.nav-item').addClass('active');
                            }
                        }
                    } catch (e) { }
                }
            });

            if (!foundMatch && (currentPath === '/' || currentPath.endsWith('/home') || currentPath.endsWith('/home/index'))) {
                $('#mnuDashboard').closest('.nav-item').addClass('active');
            }
        }

        function checkPendingAlert() {
            var pendingAlert = sessionStorage.getItem('pendingAlert');
            if (pendingAlert) {
                try {
                    var alertObj = JSON.parse(pendingAlert);
                    if (typeof alertify !== 'undefined') {
                        alertify.set({ delay: 5000 });
                        alertify.log(alertObj.msg, alertObj.type || 'success', 5000);
                    }
                } catch(e) {}
                sessionStorage.removeItem('pendingAlert');
            }
        }

        function loadPageContent(url, pushState) {
            if (pushState === undefined) pushState = true;
            
            $('#main-page-container').css('opacity', '0.4');

            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'html',
                success: function (data) {
                    var $parsed = $('<div>').append($.parseHTML(data, document, true));
                    var $newContainer = $parsed.find('#main-page-container');

                    if ($newContainer.length > 0) {
                        $('#main-page-container').html($newContainer.html());
                    } else {
                        $('#main-page-container').html(data);
                    }

                    $('#main-page-container').css('opacity', '1');

                    if (pushState) {
                        history.pushState({ url: url }, '', url);
                    }

                    updateActiveSidebar(url);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    checkPendingAlert();
                },
                error: function () {
                    $('#main-page-container').css('opacity', '1');
                    window.location.href = url;
                }
            });
        }

        $(document).ready(function () {
            // 1. Restore Sidebar Toggle state
            if (localStorage.getItem('sidebar_toggled') === 'true') {
                $('body').addClass('sidebar-toggled');
                $('#accordionSidebar').addClass('toggled');
            }

            $('#sidebarToggle, #sidebarToggleTop').on('click', function () {
                var isToggled = $('#accordionSidebar').hasClass('toggled');
                localStorage.setItem('sidebar_toggled', isToggled);
            });

            // 2. Initial Active Sidebar Item & Pending Notification Check
            updateActiveSidebar(window.location.href);
            checkPendingAlert();

            // 3. Restore and Persist Sidebar Scroll Position
            var savedScroll = sessionStorage.getItem('sidebar_scroll');
            if (savedScroll !== null) {
                $('#accordionSidebar').scrollTop(parseInt(savedScroll));
            }

            $('#accordionSidebar').on('scroll', function () {
                sessionStorage.setItem('sidebar_scroll', $(this).scrollTop());
            });

            $('#accordionSidebar a').on('click', function () {
                sessionStorage.setItem('sidebar_scroll', $('#accordionSidebar').scrollTop());
            });
        });

        // 4. Intercept Clicks for Dynamic Navigation (Permanent Sidebar)
        $(document).on('click', '#accordionSidebar a.nav-link:not([data-toggle]), #accordionSidebar a.collapse-item, .btn-group-actions a, a.spa-link', function (e) {
            var href = $(this).attr('href');
            if (href && href !== '#' && href !== 'javascript:void(0);' && !href.startsWith('http') && !$(this).attr('target')) {
                e.preventDefault();
                loadPageContent(href, true);
            }
        });

        // 5. Handle Browser Back & Forward Buttons
        window.addEventListener('popstate', function (e) {
            loadPageContent(window.location.href, false);
        });
    </script>
