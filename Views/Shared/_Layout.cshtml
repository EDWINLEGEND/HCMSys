    <script>
        if (typeof alertify !== 'undefined') {
            alertify.set({ delay: 5000 });
        }
        window.alert = function (msg) {
            if (typeof alertify !== 'undefined') {
                alertify.set({ delay: 5000 });
                alertify.log(String(msg), 'error', 5000);
            } else {
                console.warn('Alert intercepted:', msg);
            }
        };
