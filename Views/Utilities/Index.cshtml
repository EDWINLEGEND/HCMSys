@using Microsoft.AspNetCore.Http;
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/sweetalert-dev.js"></script>
<link href="~/lib/sweetalert.css" rel="stylesheet" />
<script src="~/scripts/FClient.js"></script>
<link href="~/lib/datepicker/datepicker.css" rel="stylesheet" />
<script defer src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
<link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
<link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
<style>
    .message-div {
        text-align: center;
        color: red;
        margin: 2px !important;
    }

    .tabs {
        --bar-color: red;
        --background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 60%, #e0e0e0);
        display: flex;
        width: 600px;
        /*border: 1px solid #ddd;*/
    }

        .tabs > .tab {
            flex: 1;
            display: flex;
        }

    .tab > .tab-input {
        width: 0;
        height: 0;
        margin: 0;
        display: none;
    }

    .tab > .tab-box {
        padding: .5rem;
        width: 100%;
        text-align: center;
        transition: 0.5s;
        border-bottom: 2px solid rgba(0,0,0,0);
    }

    .tab > .tab-input:checked + .tab-box {
        background: var(--background);
        border-color: var(--bar-color);
    }

    .form-control {
        max-width: none;
    }

    .document-status {
        width: 100%;
        border: none;
        background: red;
        color: white;
        border: 1px solid;
        border-radius: 37px;
        padding: 5px;
        cursor: context-menu;
        display: block;
        text-align: center;
    }

    .p-20 {
        padding: 20px;
    }



    .label-box {
        border: none !important;
        box-shadow: none !important;
        text-align: center !important;
        font-weight: bold !important;
        font-size: 20px !important;
    }

    .net-amount {
        border: none !important;
        box-shadow: none !important;
        font-weight: bolder !important;
        font-size: 22px !important;
    }

    .profile-image {
        height: 125px;
        padding: 10px;
        width: 125px;
        border-radius: 40px;
    }

    .p-t-5 {
        padding-top: 5px;
    }

    .btn-transparent {
        background: transparent;
        box-shadow: none;
        border: none;
    }

    /*.col-xs-6 {
            padding-right: 0px !important;
        }*/

    /*temporary*/
    .navbar-inverse {
        display: none;
    }

    #loading {
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.8);
        z-index: 1000;
    }

    #loadingcontent {
        display: table;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
    }

    #loadingspinner {
        display: table-cell;
        vertical-align: middle;
        width: 100%;
        text-align: center;
        font-size: larger;
        padding-top: 80px;
    }
</style>
<section class="content-header">
    <h1>
        Erase Data
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">Erase Data</li>
    </ol>
    <input type="hidden" id="userid" name="userid" value="@Context.Session.GetString("userid")" />
</section>
<!-- Main content -->
<section class="content container-fluid">
    <!-- Horizontal Form -->
    <div class="box box-danger">
        <div class="box-header with-border">
            <h3 class="box-title">Erase Data</h3>
        </div>
        <!-- /.box-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="box-body">
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label"> </label>
                    <div class="col-sm-10">
                        <input type="checkbox" class="form-check-input" name="master" placeholder="" id="master" value="master">Masters
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label"> </label>
                    <div class="col-sm-10">
                        <input type="checkbox" class="form-check-input" name="trans" placeholder="" id="trans" value="trans">Transactions
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputEmail3" class="col-sm-2 control-label"> </label>
                    <div class="col-sm-10">
                        <input type="checkbox" class="form-check-input" name="user" placeholder="" id="user" value="user">Users
                    </div>
                </div>
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
                <button type="button" id="btnCreate" class="btn btn-info pull-right">Erase</button>
            </div>
            <!-- /.box-footer -->
        </form>
    </div>
    <!-- /.box -->
</section>
<section>
    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner">
                <img alt="" src="~/dist/ajax-loader.gif" />
            </p>
        </div>
    </div>
</section>
<script>

    $('#btnCreate').click(function () {
        debugger;
        event.preventDefault()
        $("#loading").fadeIn();
        var master = ($("#master").is(':checked')) ? 1 : 0;
        var trans = ($("#trans").is(':checked')) ? 1 : 0;
        var user = ($("#user").is(':checked')) ? 1 : 0;
        var fdata = { iMaster: master, iTrans: trans,iUser:user  };

        $.ajax({
            data: fdata,
            dataType: 'json',
            type: "POST",
            url: '@Url.Action("EraseData", "Utilities")',
            async: false,

                success: function (result) {
                    console.log(result);
                    if (result.result) {
                        swal({
                            title: "Erase Data!",
                            text: "Data Removed.",
                            button: "Close", // Text on button
                            //icon: "success", //built in icons: success, warning, error, info
                            timer: 3000, //timeOut for auto-close
                            buttons: {
                                confirm: {
                                    text: "OK",
                                    value: true,
                                    visible: true,
                                    className: "",
                                    closeModal: true
                                },
                                cancel: {
                                    text: "Cancel",
                                    value: false,
                                    visible: true,
                                    className: "",
                                    closeModal: true,
                                }
                            }
                        });

                    }
                    else {
                        swal({
                            title: "Erase Data!",
                            text: "Error In Data Erase.",
                            button: "Close", // Text on button
                            icon: "warning", //built in icons: success, warning, error, info
                            timer: 3000, //timeOut for auto-close
                            buttons: {
                                confirm: {
                                    text: "OK",
                                    value: true,
                                    visible: true,
                                    className: "",
                                    closeModal: true
                                },
                                cancel: {
                                    text: "Cancel",
                                    value: false,
                                    visible: true,
                                    className: "",
                                    closeModal: true,
                                }
                            }
                        });
                    }

                },
                complete: function () {
                    $("#loading").fadeOut();
                    location.href ='@Url.Action("Index", "Home")';
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    swal("Cancelled", "Something went wrong.", "Error");
                }

            });
    });
    $('#btnCancel').click(function () {
        location.href ='@Url.Action("Index", "Home")';
    });
</script>